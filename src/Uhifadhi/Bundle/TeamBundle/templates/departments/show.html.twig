{# A DEPARTMENT'S RECORD — the design's departments/ecology/index.html: the
   head (the mark, the name, its scope, the area being read, Configure), three
   panels — Overview (the facts strip, the figures, the goals, where the
   figures come from), People & access (the index beside who is in it, its
   members and its history) and Settings (the modules it runs) — and what
   needs a decision as the banner above them. The record reads; Configure
   writes. #}
{% extends '@Shell/page.html.twig' %}
{% import '@Team/_partial/_table.html.twig' as tb %}
{% import '@Team/departments/_bits.html.twig' as di %}

{% set area = department.area %}
{% set ctl = 'uhifadhi--team-bundle--department' %}
{% set configureUrl = path('team_department_configure', {uuid: department.uuidString}) %}

{% block title %}{{ department.name }} — department{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('@Team/_stylesheets.html.twig') }}
{% endblock %}

{% block shell_page_tabs %}{% endblock %}

{% block shell_breadcrumbs %}
    <a href="{{ path('team_index') }}">uhifadhi</a> /
    <a href="{{ path('team_departments') }}">departments</a> / {{ department.name }}
{% endblock %}

{% block shell_page_head %}
    <div class="dpthead">
        <span class="mark">{{ mark }}</span>
        <div>
            <h1 class="pg">{{ department.name }}</h1>
            <p class="pgsub"><span>{% if area %}area department &middot; {{ area.name }}{% else %}org-wide department{% endif %}</span></p>
        </div>
    </div>
    <div class="pgact w-pgact">
        {% if area is null %}
            {% set here = path('team_department_show', {uuid: department.uuidString}) %}
            {% set urls = {'': here} %}
            {% set options = [] %}
            {% for each in areas %}
                {% set urls = urls|merge({(each.uuidString): here ~ '?area=' ~ each.uuidString}) %}
                {% set options = options|merge([{value: each.uuidString, label: each.name, count: null}]) %}
            {% endfor %}
            {{ include('@Team/_partial/_link_dropdown.html.twig', {
                sm: true,
                name: 'reading',
                label: 'All areas',
                icon: 'shell:map',
                end: true,
                groups: [
                    {label: 'reading', options: [{value: '', label: 'All areas', count: null}]},
                    {label: 'Areas', options: options},
                ],
                value: reading ? reading.uuidString : '',
                default: '',
                urls: urls,
            }) }}
        {% endif %}
        {% if door('departments.configure') and mayManage %}
            <a class="tgl w-act" href="{{ configureUrl }}">{{ ux_icon('shell:settings', {width: 15, height: 15}) }} Configure</a>
        {% endif %}
    </div>
{% endblock %}

{% block shell_page %}
    {{ include('@Team/team/_scope_banner.html.twig') }}
    <div class="dp-rec" data-dept="{{ department.uuidString }}" data-controller="{{ ctl }}">
        <div class="atabs">
            {% for key, label in {overview: 'Overview', people: 'People & access', settings: 'Settings'} %}
                <button type="button"{% if loop.first %} class="on"{% endif %} data-tab="{{ key }}"
                        data-{{ ctl }}-target="tab" data-action="{{ ctl }}#tab">{{ label }}</button>
            {% endfor %}
        </div>

        {{ di.attention('Needs a decision', attention) }}

        {# ── OVERVIEW ── #}
        <section data-tab-panel="overview" data-{{ ctl }}-target="tabpanel">
            <div class="factband dp-panel-band">
                <span class="f"><span class="k">Belong</span><span class="v">{{ facts.belong }}</span></span>
                <span class="f"><span class="k">Support</span><span class="v">{{ facts.support }}</span></span>
                <span class="f"><span class="k">Modules</span><span class="v">{{ facts.modules }}<em>of {{ facts.installed }}</em></span></span>
            </div>

            <div class="dp-kgrid" data-dept-kpis>
                {% for kpi in figures %}
                    <div class="c">
                        <span class="tab">{{ kpi.label }}{% if kpi.caption %}<span class="src">&middot; {{ kpi.caption }}</span>{% endif %}</span>
                        <div class="kpi">
                            <b>{{ kpi.display }}{% if kpi.isKnown and (kpi.isShare or kpi.unit) %}<em>{{ kpi.isShare ? '%' : kpi.unit }}</em>{% endif %}</b>
                            {% if kpi.deltaLabel %}<span class="sub"><span class="delta {{ kpi.direction }}">{{ kpi.deltaLabel }}</span></span>{% endif %}
                        </div>
                        {% if sparks[loop.index0] %}{{ atlas_sparkline(sparks[loop.index0]) }}{% endif %}
                        <span class="mtd">{{ kpi.moduleName }} module &middot; {{ kpi.areaName ?? (area ? area.name : 'every area') }}</span>
                    </div>
                {% else %}
                    <div class="c dp-kfull">
                        <div class="dp-empty">
                            <b>No module figures this period</b>
                            <span>They arrive with the first module this department runs that reports one &mdash; a department computes no figure of its own.</span>
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div class="grid">
                <div class="c" id="dp-goals">
                    {% set met = goals|filter(g => g.tone == 'ontrack')|length %}
                    <span class="tab">Goals<span class="src">&middot; {{ goals|length }} declared &middot; {{ met }} met</span></span>
                    {% if goals is empty %}
                        <div class="dp-empty">
                            <b>No goal declared</b>
                            <span>which is not a miss &mdash; a goal is declared on Configure, and the modules&rsquo; own figures judge it.</span>
                        </div>
                    {% else %}
                        <p class="use">Each goal is owned by a <b>position</b> and read from one module figure. The tick on every bar is the target.</p>
                        <div class="goalgrid">
                            {% for goal in goals %}
                                <div class="goal {{ goal.tone }}">
                                    <div class="gt">{{ goal.statement }}</div>
                                    <div class="gbar {{ goal.tone }}"><i style="width:{{ goal.fill }}%"></i>{% if goal.tick is not null %}<u style="left:{{ goal.tick }}%"></u>{% endif %}</div>
                                    <span class="gtarget">{{ goal.target }}</span>
                                    <div class="gfoot">
                                        <span class="owner">{{ ux_icon('shell:user-round', {width: 11, height: 11, 'aria-hidden': 'true'}) }}{{ goal.owner ?? 'nobody yet' }}</span>
                                        <span class="chip {{ goal.chip }}">{{ goal.state.label }}</span>
                                    </div>
                                    <span class="mtd">{{ goal.reads }}</span>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="grid">
                <div class="c" id="dp-sources" {{ tb.wrap('modules', 'module') }}>
                    <span class="tab">What produced these numbers<span class="src">&middot; where each figure comes from</span></span>
                    <div class="lfilt">{{ tb.search('Find a module') }}</div>
                    <table class="tbl">
                        <thead><tr><th>Module</th><th class="num">Figures it feeds</th><th class="num">Areas</th></tr></thead>
                        <tbody>
                        {% for row in sources %}
                            <tr {{ tb.row({}, row.name) }}><td><b>{{ row.name }}</b></td><td class="num">{{ row.figures }}</td><td class="num">{{ row.areas ?: '—' }}</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    {{ tb.none(sources is empty ? 'This department runs no module, so nothing on this page has a source yet.' : 'No module matches this search.') }}
                    {{ tb.foot(sources|length, 'modules', 'module') }}
                    <p class="use"><b>Every number on this page has one owner.</b> Switch a module on for this department and this page grows its figures; switch it off and they go &mdash; nothing invented to fill a gap.</p>
                </div>
            </div>
        </section>

        {# ── PEOPLE & ACCESS ── #}
        <section data-tab-panel="people" data-{{ ctl }}-target="tabpanel">
            <p class="pgsub dp-lead">Who is in {{ department.name }} and what has happened to it. Read-only: each person&rsquo;s department is set on their record.</p>
            {% embed '@Shell/_onpage.html.twig' with {rows: [
                {id: 'dp-who', label: 'Who is in it', count: positions|length},
                {id: 'dp-members', label: 'Members', count: people|length},
                {id: 'dp-history', label: 'History', count: history|length},
            ], department: department, positions: positions, people: people, history: history} only %}
                {% import '@Team/_partial/_table.html.twig' as tb %}
                {% block shell_onpage_main %}
                    <div class="c" id="dp-who">
                        <span class="tab">Who is in it<span class="src">&middot; the positions its people hold</span></span>
                        {% if positions is empty %}
                            <div class="dp-empty"><b>Nobody is placed in {{ department.name }} yet</b>
                                <span>A person comes into a department through the placement on their record.</span></div>
                        {% else %}
                            <div class="dp-chart">
                                <div class="ch-grid">
                                    {% for position in positions %}
                                        <div class="ch-n{{ position.supports ? ' sup' }}">
                                            <div class="ch-t"><b>{{ position.name }}</b><span class="ch-c">{{ position.count }}</span></div>
                                            {% if position.supports %}<span class="p">supports</span>{% else %}<span class="ch-faces">{% for face in position.faces|slice(0, 4) %}<i>{{ face }}</i>{% endfor %}</span>{% endif %}
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}
                        {% set supporting = people|filter(p => p.supports)|length %}
                        <div class="rc-foot"><span>{{ people|length - supporting }} belong &middot; {{ supporting }} support</span></div>
                    </div>

                    <div class="c" id="dp-members" {{ tb.wrap('people', 'person') }}>
                        <span class="tab">Members<span class="src">&middot; {{ people|length - supporting }} belong &middot; {{ supporting }} support</span></span>
                        <div class="lfilt">
                            {{ tb.chip('kind', [
                                {value: '', label: 'All', count: people|length},
                                {value: 'belongs', label: 'Belong', count: people|length - supporting},
                                {value: 'supports', label: 'Support', count: supporting},
                            ]) }}
                            {{ tb.search('Find a person') }}
                        </div>
                        <table class="tbl">
                            <thead><tr><th>Person</th><th>Position</th><th class="door"></th></tr></thead>
                            <tbody>
                            {% for person in people %}
                                {% set user = person.user %}
                                <tr {{ tb.row({kind: person.supports ? 'supports' : 'belongs'}, user.fullName ~ ' ' ~ user.position.name|default('')) }}>
                                    <td><b>{{ user.fullName }}</b><span class="sub">{{ person.supports ? 'supports' : 'belongs' }}</span></td>
                                    <td>{{ user.position.name|default('—') }}</td>
                                    <td class="door"><a class="ov-open" href="{{ path('team_member', {uuid: user.uuidString}) }}">Record &rarr;</a></td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                        {{ tb.none(people is empty ? 'Nobody belongs to or supports ' ~ department.name ~ ' yet.' : 'No person matches these filters.') }}
                        {{ tb.foot(people|length, 'people', 'person') }}
                    </div>

                    <div class="c" id="dp-history" {{ tb.wrap('changes', 'change') }}>
                        <span class="tab">History<span class="src">&middot; {{ history|length }} {{ history|length == 1 ? 'change' : 'changes' }}</span></span>
                        <div class="lfilt">{{ tb.search('Find a change') }}</div>
                        <table class="tbl">
                            <thead><tr><th>When</th><th>What</th><th>By</th></tr></thead>
                            <tbody>
                            {% for line in history %}
                                <tr {{ tb.row({}, line.text ~ ' ' ~ (line.by ?? '')) }}>
                                    <td class="mono"><time datetime="{{ line.at|date('c') }}">{{ line.at|date('j M Y · H:i') }}</time></td>
                                    <td>{{ line.text }}</td>
                                    <td>{{ line.by ?? '—' }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                        {{ tb.none('No change matches this search.') }}
                        {{ tb.foot(history|length, 'changes', 'change') }}
                    </div>
                {% endblock %}
            {% endembed %}
        </section>

        {# ── SETTINGS ── #}
        <section data-tab-panel="settings" data-{{ ctl }}-target="tabpanel">
            <p class="pgsub dp-lead">The modules {{ department.name }} runs, read-only. They are switched, and its name, scope and goals changed, on Configure.</p>
            {% set on = modules|filter(m => m.on)|length %}
            <div class="grid">
                <div class="c" {{ tb.wrap('modules', 'module') }}>
                    <span class="tab">Modules<span class="src">&middot; read-only &middot; switched on Configure</span></span>
                    <div class="lfilt">
                        {{ tb.chip('state', [
                            {value: '', label: 'All', count: modules|length},
                            {value: 'on', label: 'On', count: on},
                            {value: 'off', label: 'Off', count: modules|length - on},
                        ]) }}
                        {{ tb.search('Find a module') }}
                    </div>
                    <table class="tbl">
                        <thead><tr><th>Module</th><th>Organization</th><th>Department</th></tr></thead>
                        <tbody>
                        {% for module in modules %}
                            <tr {{ tb.row({state: module.on ? 'on' : 'off'}, module.name) }}>
                                <td><div class="cmname"><b>{{ module.name }}</b>{% if module.description %}<span class="cmwhat">{{ module.description }}</span>{% endif %}</div></td>
                                <td><span class="chip ok">running</span></td>
                                <td><span class="chip{{ module.on ? ' ok' }}">{{ module.on ? 'on' : 'off' }}</span></td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                    {{ tb.none(modules is empty ? 'No module is installed.' : 'No module matches these filters.') }}
                    {{ tb.foot(modules|length, 'modules', 'module') }}
                    <p class="use">{{ on }} on &middot; {{ modules|length - on }} off.{% if door('departments.configure') and mayManage %} To change what {{ department.name }} runs, <a href="{{ configureUrl }}">Configure</a>.{% endif %}</p>
                </div>
            </div>
        </section>
    </div>
{% endblock %}
