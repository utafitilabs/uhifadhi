{# ONE TOPIC'S MATRIX — the DP·01 grammar, and the only one in the product.

   THIS TEMPLATE DECIDES NOTHING. Every shade, every word for an absence,
   every tone and the whole of the arithmetic arrived on the view; what is
   left here is where each of them goes. A template that worked something
   out would work it out differently on the next page, and a module that
   worked it out would disagree with the host.

   ONE RULE FOR BOTH KINDS OF CELL. A figure and a run of states are the
   same `.hcell` with different contents, so the two can never drift into
   two grids.

   Written here and NOT restated: `.tbl`, `.mono`, `.open-btn` and the
   frame's own type come from the shell. #}
{% import _self as dp %}
<section class="pfc"{% if id %} id="{{ id }}"{% endif %}>
    <div class="pfc-hd">
        {% if title %}<span class="t">{{ title }}</span>{% endif %}
        {% if caption %}<span class="s">&middot; {{ caption }}</span>{% endif %}
        <span class="sp"></span>
        {% if not view.isEmpty %}
            <span class="n">{{ view.rowCount }} rows &middot; {{ view.columns|length }} columns</span>
        {% endif %}
        {% if publisher %}
            <span class="pfq{{ byModule ? ' mod' }}" title="Who publishes this matrix">{{ publisher }}</span>
        {% endif %}
    </div>

    {% if view.isEmpty %}
        {# A HEAD, A RULE AND NO ROWS reads as a measurement of nought. #}
        <div class="pfc-bd">
            <p class="perf-empty">No department reads this topic yet, which is not the same as every department scoring nothing.</p>
        </div>
    {% else %}
        <div class="pfc-bd flush">
            <div class="hscroll pa-board" data-controller="uhifadhi--team-bundle--matrix">
                <table class="tbl heat">
                    <thead>
                        <tr>
                            <th class="sortable" data-sort="name" aria-sort="none" tabindex="0" role="columnheader"
                                title="Sort by department name">Department<i class="sortmark"></i></th>
                            {% for column in view.columns %}
                                <th class="num sortable" data-sort="{{ column.key }}" aria-sort="none" tabindex="0" role="columnheader"
                                    title="Sort by {{ column.label|lower }}{{ column.caption ? ' — ' ~ column.caption }}">{{ column.label }}<i class="sortmark"></i>
                                    {%- if column.total %}
                                        <span class="thtot">{{ column.total }}
                                            {%- if column.unit %}<em>{{ column.unit }}</em>{% endif %}
                                            {%- if column.totalDelta %}<span class="d{{ column.totalTone ? ' ' ~ column.totalTone }}">{{ column.totalDelta }}</span>{% endif %}
                                        </span>
                                    {%- endif %}
                                </th>
                            {% endfor %}
                            <th class="perf-openhead"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for band in view.bands %}
                            {# THE BOUNDARY A PLACING WAS MADE INSIDE, drawn, so a
                               reader can see what a shade was measured against. #}
                            <tr class="pfscope">
                                <td colspan="{{ view.columns|length + 2 }}">
                                    <span class="sg">{{ band.name }}<span class="n">{{ band.count }}</span>{% if band.note %}<em>{{ band.note }}</em>{% endif %}</span>
                                </td>
                            </tr>
                            {% for row in band.rows %}
                                <tr class="perf-row">
                                    <td data-v="{{ row.name|lower }}">
                                        <div class="dept">
                                            <span class="mk">{{ row.mark }}</span>
                                            <div><b>{{ row.name }}</b>{% if row.note %}<span>{{ row.note }}</span>{% endif %}</div>
                                        </div>
                                    </td>
                                    {% for cell in row.cells %}
                                        <td class="hc"{% if cell.sort is not null %} data-v="{{ cell.sort }}"{% endif %}>{{ dp.cell(cell) }}</td>
                                    {% endfor %}
                                    <td class="num perf-open">
                                        {% if row.url %}
                                            <a class="open-btn" href="{{ row.url }}">{{ openLabel }} {{ ux_icon('shell:chevron-right') }}</a>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        {# THE LEGEND IS PART OF THE MATRIX: a shade nobody explained is a
           verdict the reader invents. It says what a tint is AND what it
           is not, because the second is the half that gets misread. #}
        <div class="pfc-ft">
            <div class="legend">
                <span><i class="sw h5"></i>leads the column</span>
                <span><i class="sw h3"></i>mid</span>
                <span><i class="sw h1"></i>trails the column</span>
                <span><i class="sw h0"></i>no figure yet &mdash; not a zero</span>
                <span class="d">A placing inside one column and one band &mdash; never a verdict on a department, and not drawn where fewer than {{ fewest }} in the band have a figure.</span>
            </div>
        </div>
    {% endif %}
</section>

{% macro cell(cell) %}
    {%- if cell.isBlank -%}
        <div class="hcell h0 blank"{% if cell.title %} title="{{ cell.title }}"{% endif %}><span class="mono d">{{ cell.word }}</span></div>
    {%- elseif cell.isMarks -%}
        <div class="hcell"{% if cell.title %} title="{{ cell.title }}"{% endif %}>
            <div class="r2 marks">
                {%- for mark in cell.marks -%}
                    <span class="cmark{{ mark.tone ? ' ' ~ mark.tone }}"{% if mark.title %} title="{{ mark.title }}"{% endif %}>{{ mark.label }}</span>
                {%- endfor -%}
            </div>
        </div>
    {%- else -%}
        <div class="hcell{{ cell.tint ? ' ' ~ cell.tint }}"{% if cell.title %} title="{{ cell.title }}"{% endif %}>
            <b>{{ cell.figure }}{% if cell.unit %}<em>{{ cell.unit }}</em>{% endif %}</b>
            {%- if cell.delta or cell.spark %}
                <div class="r2">
                    {%- if cell.delta %}<span class="delta{{ cell.deltaTone ? ' ' ~ cell.deltaTone }}">{{ cell.delta }}</span>{% endif %}
                    {%- if cell.spark %}{{ atlas_sparkline(cell.spark) }}{% endif %}
                </div>
            {%- endif %}
        </div>
    {%- endif -%}
{% endmacro %}
