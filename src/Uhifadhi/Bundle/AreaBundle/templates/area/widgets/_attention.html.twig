{# PREVIEW: ATTENTION BOARD — the register as a worklist. Areas sort themselves
   into what the operator has to DO today: the ones raising a flag first, the ones
   running steady next, the ones not yet live last. A quiet day pushes everything
   down into "running steady"; a bad morning fills the top.

   THE ITEMS ARE THE ATTENTION CONTRIBUTION'S, gathered per area exactly as the overview
   gathers them — the area page lays out what a module raised and dismisses none by
   hand. #}
{# THE PAGE HEAD IS THE PREVIEW'S. On the landing the page frame has already
   drawn it — with this layout's own subtitle, from the same partial — so the
   layout would be stating the title twice. #}
{% if not landing|default(false) %}
    <div class="pghead">
        <div>
            <h1 class="pg">Areas</h1>
            <p class="pgsub">{{ include('@Area/area/widgets/_subtitle.html.twig', {view: 'attention'}) }}</p>
        </div>
        {% if door('areas.configure', whole_organization()) %}
            <div class="pgact"><a class="cta" href="{{ path('area_new') }}">{{ ux_icon('shell:plus') }} New area</a></div>
        {% endif %}
    </div>
{% endif %}

<h2 class="zone">Needs attention &middot; {{ needsAttention|length }}</h2>
{% for preset in needsAttention %}
    {% set row = preset.row %}
    <div class="c ax-tri need">
        <a class="ax-trihead" href="{{ path('area_show', {uuid: row.area.uuidString}) }}">
            <span class="ax-trimk{{ row.thumbnail.hasBoundary ? '' : ' none' }}"{% if row.thumbnail.hasBoundary %} style="background-image:url('{{ row.thumbnail.imageUrl }}')"{% endif %}></span>
            <span class="ax-tribd">
                <span class="ax-trinm">{{ row.area.name }}</span>
                <span class="ax-trimeta mono">
                    {%- if row.area.iucnCategory %}IUCN {{ row.area.iucnCategory }} &middot; {% endif -%}
                    {%- if row.area.establishedYear %}est. {{ row.area.establishedYear }} &middot; {% endif -%}
                    {{ row.areaKm2|number_format }} km&sup2; &middot; {{ row.liveModules }} modules live
                </span>
            </span>
            <span class="ax-triside">
                <span class="chip warn">{{ row.alertCount }} open alert{{ row.alertCount == 1 ? '' : 's' }}</span>
                {% if row.lastActivity %}<span class="mono ax-triwhen">last contact <span title="{{ row.lastActivity|date('c') }}">{{ row.lastActivityLabel }}</span></span>{% endif %}
                <span class="ax-open">Open {{ ux_icon('shell:arrow-right') }}</span>
            </span>
        </a>
        {# BOUNDED: the latest few, and a line saying how many more wait on the
           area — a board that grew with its list deformed every card beside it. #}
        {% set shown = constant('Uhifadhi\\Bundle\\AreaBundle\\Controller\\AreaController::ATTENTION_SHOWN') %}
        <div class="ax-triatts">
            {% for item in preset.attention|slice(0, shown) %}
                <a class="ao-att {{ item.severity.cssClass }}" href="{{ item.url }}">
                    <span class="sev"></span>
                    <span class="bd">
                        <span class="t"><b>{{ item.headline }}</b>{% if item.detail %} {{ item.detail }}{% endif %}</span>
                        <span class="m"><i></i>{{ item.moduleLabel }} &middot; {{ item.kind }}
                            {%- for fact in item.meta %}<span>{{ fact }}</span>{% endfor -%}
                        </span>
                    </span>
                    <span class="age">{{ item.ageLabel }}</span>
                </a>
            {% endfor %}
            {% if preset.attention|length > shown %}
                <a class="ax-attmore mono" href="{{ path('area_show', {uuid: row.area.uuidString}) }}">{{ shown }} of {{ preset.attention|length }} &middot; all on the area &rarr;</a>
            {% endif %}
        </div>
        {% if row.isLive %}
            <div class="ax-tristats mono">{{ row.liveModules }} modules live{% for stat in row.stats %} &middot; {{ stat.value }} {{ stat.label }}{% endfor %}{% if row.liveNow %} &middot; {{ row.liveNow.value }} {{ row.liveNow.label }}{% endif %}</div>
        {% endif %}
    </div>
{% endfor %}

<h2 class="zone">Running steady &middot; {{ runningSteady|length }}</h2>
{% if runningSteady is empty %}
    <div class="ax-steadyempty">{{ ux_icon('shell:circle-check') }}<span>No area is both live and quiet right now. An active area with nothing overdue would sit here &mdash; its pulse visible, but nothing asking for you.</span></div>
{% else %}
    {% for preset in runningSteady %}
        {% set row = preset.row %}
        <div class="c ax-tri">
            <a class="ax-trihead" href="{{ path('area_show', {uuid: row.area.uuidString}) }}">
                <span class="ax-trimk{{ row.thumbnail.hasBoundary ? '' : ' none' }}"{% if row.thumbnail.hasBoundary %} style="background-image:url('{{ row.thumbnail.imageUrl }}')"{% endif %}></span>
                <span class="ax-tribd">
                    <span class="ax-trinm">{{ row.area.name }}</span>
                    <span class="ax-trimeta mono">
                        {%- if row.area.iucnCategory %}IUCN {{ row.area.iucnCategory }} &middot; {% endif -%}
                        {{ row.areaKm2|number_format }} km&sup2; &middot; {{ row.liveModules }} modules live
                    </span>
                </span>
                <span class="ax-triside">
                    <span class="chip ok">steady</span>
                    {% if row.lastActivity %}<span class="mono ax-triwhen">last contact <span title="{{ row.lastActivity|date('c') }}">{{ row.lastActivityLabel }}</span></span>{% endif %}
                    <span class="ax-open">Open {{ ux_icon('shell:arrow-right') }}</span>
                </span>
            </a>
            <div class="ax-tristats mono">{{ row.liveModules }} modules live{% for stat in row.stats %} &middot; {{ stat.value }} {{ stat.label }}{% endfor %}</div>
        </div>
    {% endfor %}
{% endif %}

<h2 class="zone">Awaiting setup &middot; {{ awaitingSetup|length }}</h2>
<div class="ax-tgrid">
    {% for preset in awaitingSetup %}
        {% set row = preset.row %}
        <a class="ax-tcard" href="{{ path('area_show', {uuid: row.area.uuidString}) }}">
            <span class="ax-tmk{{ row.thumbnail.hasBoundary ? '' : ' none' }}"{% if row.thumbnail.hasBoundary %} style="background-image:url('{{ row.thumbnail.imageUrl }}')"{% endif %}></span>
            <span class="ax-tbd">
                <span class="ax-tnm">{{ row.area.name }}</span>
                <span class="ax-tmeta mono">
                    {%- if row.area.iucnCategory %}IUCN {{ row.area.iucnCategory }} &middot; {% endif -%}
                    {{ row.areaKm2|number_format }} km&sup2;
                </span>
            </span>
            <span class="chip idle">not active yet</span>
        </a>
    {% endfor %}
    {% if door('areas.configure', whole_organization()) %}
        <a class="ax-tcard add" href="{{ path('area_new') }}">{{ ux_icon('shell:plus') }} New area</a>
    {% endif %}
</div>
