{# MY DUTY LOG (#19; design variants-my-dashboard/duty-log.html, approved 28
   Sep 2026): every check-in the signed-in person made in a month — the web
   copy of the Duty log on their phone. #}
{% extends '@Shell/page.html.twig' %}

{% block title %}My duty log{% endblock %}
{% block stylesheets %}{{ parent() }}{{ include('@Area/_stylesheets.html.twig') }}{% endblock %}
{% block shell_page_tabs %}{% endblock %}
{% block shell_breadcrumbs %}<a href="{{ path('organization_dashboard') }}">{{ shell_brand().name|lower }}</a> / my duty log{% endblock %}
{% block shell_page_title %}My duty log <span class="chip acc">{{ monthLabel }}</span>{% endblock %}
{% block shell_page_subtitle %}Every check-in I made and the hours on watch — the web copy of the Duty log on my phone.{% endblock %}

{% block shell_page %}
    <div class="grid kstrip ao-kstrip md-figures">
        <div class="c kpi"><span class="tab">On watch</span><b class="disp">{{ hours }} h</b><span class="sub">{{ monthName|lower }} &middot; {{ watches }} watch{{ watches == 1 ? '' : 'es' }}</span></div>
        <div class="c kpi"><span class="tab">Days checked in</span><b class="disp">{{ days }}</b><span class="sub">in {{ monthName|lower }}</span></div>
        <div class="c kpi"><span class="tab">Pings</span><b class="disp">{{ pings }}</b><span class="sub">sent on watch</span></div>
    </div>
    {% set _d = 'Uhifadhi\\Bundle\\AreaBundle\\Service\\DutyLogService' %}
    <div class="c" data-me="log"><span class="tab">Every check-in<span class="src">&middot; {{ monthName|lower }} &middot; newest first &middot; a correction is added, never overwritten</span></span>
        {# THE HOUSE BAR: the month, the status and the post as chips, every
           option a link; the search reads the post's name. #}
        <div class="lfilt">
            {{ include('@Area/_partial/_filter.html.twig', {
                key: constant(_d ~ '::MONTH'), all: null, chosen: monthParam, options: months,
            }, with_context: false) }}
            {{ include('@Area/_partial/_filter.html.twig', {
                key: constant(_d ~ '::STATUS'), all: 'Every status', allCount: scope, chosen: log.status, options: log.statuses,
            }, with_context: false) }}
            {{ include('@Area/_partial/_filter.html.twig', {
                key: constant(_d ~ '::POST'), all: 'Every post', allCount: scope, chosen: log.post, options: log.posts,
            }, with_context: false) }}
            <form class="lsearch" method="get" action="{{ path('me_duty_log') }}">
                {{ ux_icon('shell:search') }}
                <input class="fld" type="search" name="{{ constant(_d ~ '::SEARCH') }}" value="{{ log.search }}" placeholder="Find a post&hellip;" aria-label="Find a post">
                {% for k, v in app.request.query.all|filter((v, k) => k not in [constant(_d ~ '::SEARCH'), 'page'] and v is not iterable) %}<input type="hidden" name="{{ k }}" value="{{ v }}">{% endfor %}
            </form>
        </div>
        {% if claims is empty %}
            <div class="zempty">
                {% if scope == 0 %}
                    <b class="zeh">No check-ins in {{ monthName }}</b>
                    <p class="zeb">Every check-in made on the phone in a month is listed here.</p>
                {% else %}
                    <b class="zeh">No check-in matches</b>
                    <p class="zeb">Nothing in {{ monthName }} answers these filters. Clear one, or search another post.</p>
                    <span class="zea"><a class="btn sm" href="{{ path('me_duty_log', {(constant(_d ~ '::MONTH')): monthParam}) }}">Clear the filters</a></span>
                {% endif %}
            </div>
        {% else %}
            <table class="tbl"><thead><tr><th>Day</th><th>Status</th><th>Post</th><th>In</th><th>Out</th><th>On watch</th></tr></thead><tbody>
            {% for claim in claims %}
                <tr><td><b><time datetime="{{ claim.occurredAt|date('c') }}" data-localtime-format="day">{{ claim.occurredAt|date('D j') }}</time></b></td><td>{{ claim.status ? claim.status.label : '' }}</td><td>{{ claim.station ? claim.station.name : '—' }}</td>
                <td class="mono"><time datetime="{{ claim.occurredAt|date('c') }}" data-localtime-format="clock">{{ claim.occurredAt|date('H:i') }}</time></td><td class="mono">{% if claim.endedAt %}<time datetime="{{ claim.endedAt|date('c') }}" data-localtime-format="clock">{{ claim.endedAt|date('H:i') }}</time>{% else %}on watch{% endif %}</td>
                <td class="mono">{{ area_my_span(claim.occurredAt, claim.endedAt ?? now) }}</td></tr>
            {% endfor %}
            </tbody></table>
            {{ include('@Shell/_foot.html.twig', {
                count: table.total, noun: 'check-ins', one: 'check-in',
                perPage: table.size, page: table.page, pages: table.pages, links: links,
            }, with_context: false) }}
        {% endif %}
    </div>
{% endblock %}
