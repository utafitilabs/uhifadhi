{# MODULES IN THIS AREA — what each one contributes to this page, and since
   when.

   Design: areas/<area>/overview.widgets.js (the `modules` widget).

   THE REGISTRY'S OWN CELL, and the only one on this page that is about the
   composition rather than about the ground. It states what the area runs
   against what the installation HAS, because "three modules" means nothing
   without "of nine": an area is deliberately narrower than the catalogue.

   A NAME AND A LINK SAID NOTHING. The question a reader has is whether a
   module is earning its place here, so the row counts what it actually puts
   on this page — its cells, its tiles, its attention items, its layers —
   from the seams it registered with. A module that contributes nothing says
   so; one that is not installed here says that instead.

   SINCE IS THE MONTH THE AREA TOOK IT ON. A row written before the date was
   recorded has none, and says so — a date nobody wrote down cannot be
   recovered.

   THE CELL IS THE MODULES TAB READ AS ONE CARD, so it asks what that tab
   asks, of this area, and draws nothing for somebody who may not read which
   modules run here. #}
{% if door('modules.read', area) %}
<div class="c" data-w="modules">
    <span class="tab">Modules in this area<span class="src">&middot; {{ moduleCards|length }} installed &middot; {{ catalogueCount }} in the catalogue</span></span>
    <span class="ao-by next"><i></i>the registry</span>

    {% if moduleTable is empty %}
        <div class="use" style="margin:0 2px 8px"><b>Nothing in the catalogue.</b> This installation carries no module yet.</div>
    {% else %}
        <table class="tbl">
            <thead>
                <tr><th>module</th><th>contributes here</th><th class="num">since</th></tr>
            </thead>
            <tbody>
                {% for row in moduleTable %}
                    <tr>
                        <td{{ row.installed ? '' : ' class="d"' }}>
                            <i class="mdot{{ row.installed ? '' : ' off' }}"{% if row.swatch %} style="background:{{ row.swatch }}"{% endif %}></i>
                            {%- if row.installed and row.url -%}
                                <a href="{{ row.url }}">{{ row.name }}</a>
                            {%- else -%}
                                {{ row.name }}
                            {%- endif -%}
                        </td>
                        <td class="{{ row.installed ? 'fog' : 'd' }}">
                            {%- if not row.installed -%}
                                nothing &mdash; not installed in this area
                            {%- elseif row.parts is empty -%}
                                installed &mdash; nothing on this page yet
                            {%- else -%}
                                {{ row.parts|join(' &middot; ')|raw }}
                            {%- endif -%}
                        </td>
                        <td class="num mono{{ row.since ? '' : ' d' }}">
                            {%- if row.since -%}
                                <time datetime="{{ row.since|date('c') }}" data-localtime-format="day">{{ row.since|date('M Y')|lower }}</time>
                            {%- else -%}
                                &mdash;
                            {%- endif -%}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <div class="use">A module is installed <b>per area</b>. Everything it contributes appears the moment it is, and leaves
        the moment it is not &mdash; including its tiles inside this page&rsquo;s own strip and its items inside its
        attention list.</div>

    <a class="open-btn" href="{{ path('area_modules', {uuid: area.uuidString}) }}" style="margin-top:8px">Add a module to this area &rarr;</a>
</div>
{% endif %}
