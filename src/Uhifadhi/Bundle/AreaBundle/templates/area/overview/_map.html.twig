{# THE OPERATIONAL MAP PLATE — the area's own base content: the boundary,
   always drawn, and the area's zones drawn beside it.

   Design: areas/<area>/index.html and overview.widgets.js (the `map` widget).

   THE PLATE IS INFRASTRUCTURE. The AOI boundary is drawn whenever the area has
   one, whichever modules are installed — so this card is here on a brand-new
   area with nothing switched on. Operational layers (patrol tracks, open
   incidents, stations) are a module's, and arrive later through the map-layer
   contribution, each adding its own legend group beneath "The area".

   ONE MAP, EVERYWHERE, AND NO MAP JAVASCRIPT HERE. The map is stated in PHP
   (Service/AreaMapService) and drawn by the atlas: the imagery, the boundary
   treatment, the chrome, the legend and its switches, fullscreen. This template
   frames the card and calls render_map() — the same call a module writes.

   hasBoundary DRIVES THE PLATE. With a boundary the card is a live map; with
   none it says there is nothing to draw yet, rather than a grey empty box. #}
{% if area.hasBoundary %}
    <div class="c" data-w="map">
        {# THE CAPTION SAYS THE PLATE IS LIVE AND WHEN IT LAST READ — a map
           with no time on it is a map somebody trusts an hour after it went
           stale. The instant is the viewer's, through the shell's own
           element. #}
        <span class="tab">Where<span class="src">&middot; <span class="ao-live"><i></i>live</span> &middot; <time datetime="{{ now|date('c') }}" data-localtime-format="stamp">{{ now|date('j M') }} &middot; {{ now|date('H:i') }}</time></span></span>
        <span class="ao-by"><i></i>the area plate &middot; module layers</span>

        {# THE HEIGHT IS THE PAGE'S, as it is on every plate in the product —
           here the design's own expression rather than a fixed number: this
           card is the page's subject, so it takes a share of the screen,
           capped so a tall monitor gets a map and not a wall. #}
        {{ render_map(map, {
            '--map-plate-height': 'min(58vh, 560px)',
            'role': 'img',
            'aria-label': area.name ~ ' — boundary' ~ (zoneCount > 0 ? ' and zones' : ''),
        }) }}
    </div>
{% else %}
    {# NO BOUNDARY IS A STATE, NOT A BROKEN MAP. #}
    <div class="c" data-w="map">
        {# THE CAPTION SAYS THE PLATE IS LIVE AND WHEN IT LAST READ — a map
           with no time on it is a map somebody trusts an hour after it went
           stale. The instant is the viewer's, through the shell's own
           element. #}
        <span class="tab">Where<span class="src">&middot; <span class="ao-live"><i></i>live</span> &middot; <time datetime="{{ now|date('c') }}" data-localtime-format="stamp">{{ now|date('j M') }} &middot; {{ now|date('H:i') }}</time></span></span>
        <span class="ao-by"><i></i>the area plate &middot; module layers</span>
        <div class="ao-slot" style="margin-top:8px">
            <div class="ao-slotrow">
                <span class="nm">The map</span>
                <span class="wd">This area has <b>no boundary on file</b> yet, so there is nothing to draw. Import one and this plate opens on it, with the zones and every module&rsquo;s layers over it.</span>
                {% if door('areas.configure', area) %}
                    <span class="st"><a href="{{ path('area_edit', {uuid: area.uuidString}) }}">Add a boundary &rarr;</a></span>
                {% endif %}
            </div>
        </div>
    </div>
{% endif %}
