{
    "name": "uhifadhi/uhifadhi",
    "type": "library",
    "description": "The uhifadhi core: the registry, the shell and the atlas, shipped as one package and one version.",
    "keywords": [
        "conservation",
        "core",
        "platform",
        "registry",
        "shell",
        "symfony",
        "symfony-ux",
        "uhifadhi"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Ezekiel Mjema",
            "homepage": "https://github.com/eemjema"
        }
    ],
    "require": {
        "php": ">=8.4",
        "ext-mbstring": "*",
        "composer-runtime-api": "^2.0",
        "api-platform/core": "^4.3",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.5",
        "dragonmantank/cron-expression": "^3.4",
        "psr/clock": "^1.0",
        "psr/container": "^1.1 || ^2.0",
        "symfony/asset": "^7.3 || ^8.0",
        "symfony/asset-mapper": "^7.3 || ^8.0",
        "symfony/clock": "^7.3 || ^8.0",
        "symfony/config": "^7.3 || ^8.0",
        "symfony/console": "^7.3 || ^8.0",
        "symfony/dependency-injection": "^7.3 || ^8.0",
        "symfony/doctrine-messenger": "^7.3 || ^8.0",
        "symfony/framework-bundle": "^7.3 || ^8.0",
        "symfony/http-foundation": "^7.3 || ^8.0",
        "symfony/http-kernel": "^7.3 || ^8.0",
        "symfony/mailer": "^7.3 || ^8.0",
        "symfony/messenger": "^7.3 || ^8.0",
        "symfony/mime": "^7.3 || ^8.0",
        "symfony/password-hasher": "^7.3 || ^8.0",
        "symfony/rate-limiter": "^7.3 || ^8.0",
        "symfony/routing": "^7.3 || ^8.0",
        "symfony/scheduler": "^7.3 || ^8.0",
        "symfony/security-bundle": "^7.3 || ^8.0",
        "symfony/security-core": "^7.3 || ^8.0",
        "symfony/security-csrf": "^7.3 || ^8.0",
        "symfony/security-http": "^7.3 || ^8.0",
        "symfony/service-contracts": "^3.5",
        "symfony/stimulus-bundle": "^2.20 || ^3.0",
        "symfony/twig-bundle": "^7.3 || ^8.0",
        "symfony/uid": "^7.3 || ^8.0",
        "symfony/ux-chartjs": "^2.20 || ^3.0",
        "symfony/ux-icons": "^2.20 || ^3.0",
        "symfony/ux-leaflet-map": "^2.20 || ^3.0",
        "symfony/ux-map": "^2.20 || ^3.0",
        "twig/twig": "^3.14",
        "utafitilabs/postgis-bundle": "^0.1"
    },
    "replace": {
        "uhifadhi/area-bundle": "self.version",
        "uhifadhi/atlas-bundle": "self.version",
        "uhifadhi/contracts": "self.version",
        "uhifadhi/registry-bundle": "self.version",
        "uhifadhi/shell-bundle": "self.version",
        "uhifadhi/team-bundle": "self.version"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "maglnet/composer-require-checker": "^4.16",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^13.2",
        "symfony/browser-kit": "^7.3 || ^8.0",
        "symfony/css-selector": "^7.3 || ^8.0",
        "symfony/dom-crawler": "^7.3 || ^8.0",
        "symfony/mercure": "^0.8",
        "symfony/mercure-bundle": "^0.5"
    },
    "autoload": {
        "psr-4": {
            "Uhifadhi\\Bundle\\": "src/Uhifadhi/Bundle/",
            "Uhifadhi\\Bundle\\AreaBundle\\Migrations\\": "src/Uhifadhi/Bundle/AreaBundle/migrations/",
            "Uhifadhi\\Bundle\\RegistryBundle\\Migrations\\": "src/Uhifadhi/Bundle/RegistryBundle/migrations/",
            "Uhifadhi\\Bundle\\ShellBundle\\Migrations\\": "src/Uhifadhi/Bundle/ShellBundle/migrations/",
            "Uhifadhi\\Bundle\\TeamBundle\\Migrations\\": "src/Uhifadhi/Bundle/TeamBundle/migrations/",
            "Uhifadhi\\Contracts\\": "src/Uhifadhi/Contracts/"
        },
        "exclude-from-classmap": [
            "**/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Uhifadhi\\Bundle\\AreaBundle\\Tests\\": "src/Uhifadhi/Bundle/AreaBundle/tests/",
            "Uhifadhi\\Bundle\\AtlasBundle\\Tests\\": "src/Uhifadhi/Bundle/AtlasBundle/tests/",
            "Uhifadhi\\Bundle\\RegistryBundle\\Tests\\": "src/Uhifadhi/Bundle/RegistryBundle/tests/",
            "Uhifadhi\\Bundle\\ShellBundle\\Tests\\": "src/Uhifadhi/Bundle/ShellBundle/tests/",
            "Uhifadhi\\Bundle\\TeamBundle\\Tests\\": "src/Uhifadhi/Bundle/TeamBundle/tests/",
            "Uhifadhi\\Contracts\\Tests\\": "src/Uhifadhi/Contracts/tests/",
            "Uhifadhi\\Core\\Tests\\": "tests/",
            "Uhifadhi\\Core\\Tests\\Core\\Fixtures\\Migrations\\": "tests/Core/Fixtures/migrations/",
            "Uhifadhi\\Entity\\": "src/Uhifadhi/Bundle/RegistryBundle/tests/Integration/Fixtures/Uhifadhi/Entity/"
        }
    },
    "scripts": {
        "cs:fix": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
        "test": "phpunit",
        "require-check": "@php require-check",
        "check": [
            "@cs:check",
            "@phpstan",
            "@require-check",
            "@test"
        ]
    },
    "config": {
        "process-timeout": 1800,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
