{# A MODULE PAGE WITH DROPDOWNS: each drawn by the shell from the data it is
   handed. The page writes nothing of their markup. #}
{% extends '@Shell/page.html.twig' %}

{% block title %}a page with dropdowns{% endblock %}
{% block shell_page_title %}a page with dropdowns{% endblock %}

{% block shell_page %}
    <div class="c">
        {% for dropdown in dropdowns %}
            {% include '@Shell/_dropdown.html.twig' with dropdown only %}
        {% endfor %}
    </div>
{% endblock %}
