{# TEAM · CONFIGURE · PEOPLE — the rules every invitation is sent under.

   ONE CARD, AS A FORM. Who may add somebody is a permission carried by a
   position, not a setting; the ranger code is a rule of one position and lives
   on the position. What is left is the rule every invitation shares. #}
{% extends '@Team/team/configure/_layout.html.twig' %}
{% import '@Team/team/configure/_bits.html.twig' as bits %}

{% set section = 'people' %}

{% block shell_page_subtitle %}Configure &middot; People: the rules every invitation is sent under.{% endblock %}

{% block shell_page %}
    <form class="c" method="post" action="{{ path('team_configure_people_save') }}">
        <input type="hidden" name="_token" value="{{ csrfToken }}">
        <span class="tab">Invitation rules<span class="src">&middot; every invitation</span></span>
        <div class="frow">
            <label for="tc-valid">Valid for</label>
            <span class="fcell">
                <span class="fnum">
                    <input class="fld" type="number" id="tc-valid" name="validAmount" value="{{ rules.invitationValidAmount }}" min="1" required aria-label="amount">
                    <span class="fsel n"><select class="fld" name="validUnit" aria-label="unit">
                        {%- for unit in units %}<option value="{{ unit.value }}"{{ unit == rules.invitationValidUnit ? ' selected' : '' }}>{{ unit.label }}</option>{% endfor -%}
                    </select></span>
                </span>
                <span class="fwhen req">required</span>
            </span>
        </div>
        <div class="frow">
            <label for="tc-uses">Uses per token</label>
            <span class="fcell">
                <span class="fnum">
                    <input class="fld" type="number" id="tc-uses" name="uses" value="{{ rules.invitationUses }}" min="1" required aria-label="use">
                    <span class="u">use</span>
                </span>
            </span>
        </div>
        <div class="frow">
            <label>With a password</label>
            <span class="fcell">
                {{ bits.yesno('withPassword', rules.invitationWithPassword ? 'allowed' : 'invitation', {'allowed': 'Allowed', 'invitation': 'Invitation only'}, 'With a password') }}
            </span>
        </div>
        <div class="save-row">
            <span class="d" style="font-size:11.5px;margin-right:auto">Applies to every invitation sent after saving</span>
            <button type="reset" class="btn">Cancel</button>
            <button type="submit" class="cta">Save invitation rules</button>
        </div>
    </form>
{% endblock %}
