{
    "name": "@uhifadhi/shell-bundle",
    "description": "Front-end behaviour of the shell \u2014 the furniture's Stimulus controllers, mapped into hosts via AssetMapper.",
    "license": "AGPL-3.0-or-later",
    "symfony": {
        "controllers": {
            "theme": {
                "main": "controllers/theme_controller.js",
                "fetch": "eager",
                "enabled": true
            },
            "confirm-modal": {
                "main": "controllers/confirm_modal_controller.js",
                "fetch": "eager",
                "enabled": true
            },
            "sidebar": {
                "main": "controllers/sidebar_controller.js",
                "fetch": "eager",
                "enabled": true
            },
            "sidebar-tree": {
                "main": "controllers/sidebar_tree_controller.js",
                "fetch": "eager",
                "enabled": true
            },
            "localtime": {
                "main": "controllers/localtime_controller.js",
                "fetch": "eager",
                "enabled": true
            },
            "scope": {
                "main": "controllers/scope_controller.js",
                "name": "uhifadhi--shell-bundle--scope",
                "fetch": "eager",
                "enabled": true
            },
            "register-fold": {
                "main": "controllers/register_fold_controller.js",
                "fetch": "eager",
                "enabled": true,
                "name": "uhifadhi--shell-bundle--register-fold"
            },
            "reorder": {
                "main": "controllers/reorder_controller.js",
                "name": "uhifadhi--shell-bundle--reorder",
                "fetch": "eager",
                "enabled": true
            }
        },
        "importmap": {
            "uhifadhi/widgets": "path:%PACKAGE%/widgets.js"
        }
    }
}
