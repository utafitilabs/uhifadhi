{# PREVIEW: WALL OF WORKSPACES — the shipped default, the card gallery the areas
   landing renders. The same shared partial the register landing draws, so the
   preview is the real page, not a copy of it. #}
{# THE PAGE HEAD IS THE PREVIEW'S. On the landing the page frame has already
   drawn it — with this layout's own subtitle, from the same partial — so the
   layout would be stating the title twice. #}
{% if not landing|default(false) %}
    <div class="pghead">
        <div>
            <h1 class="pg">Areas</h1>
            <p class="pgsub">{{ include('@Area/area/widgets/_subtitle.html.twig', {view: 'wall'}) }}</p>
        </div>
        {% if door('areas.configure', whole_organization()) %}
            <div class="pgact"><a class="cta" href="{{ path('area_new') }}">{{ ux_icon('shell:plus') }} New area</a></div>
        {% endif %}
    </div>
{% endif %}

{% if rows is empty %}
    <div class="c"><p class="zeb">No areas yet &mdash; the wall fills as areas are added.</p></div>
{% else %}
    {{ include('@Area/area/_register_cards.html.twig') }}
{% endif %}
