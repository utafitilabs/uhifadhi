{# TEAM › PERMISSIONS — the small pieces more than one Permissions page draws. #}

{# RECOMPUTE NOW — a run asked of the worker. While one is waiting or under
   way the button says so and asks nothing more. With `line`, the clock and
   "As of … · next run …" stand before it. #}
{% macro recompute(freshness, token, back, line = false) %}
    {%- set busy = freshness.pending or freshness.running -%}
    <span class="pp-fresh{{ busy ? ' pp-busy' }}">
        {%- if line %}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><span>As of <b class="pp-time">{% if freshness.asOf %}{{ _self.stamp(freshness.asOf) }}{% else %}{{ shell_as_of(null) }}{% endif %}</b> &middot; next run <b class="pp-time">{{ _self.stamp(freshness.nextRun) }}</b></span>{% endif %}
        <form method="post" action="{{ path('team_permissions_recompute') }}">
            <input type="hidden" name="_token" value="{{ token }}">
            <input type="hidden" name="back" value="{{ back }}">
            <button type="submit" class="tgl"{{ busy ? ' disabled' }}><svg class="pp-spin" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg><span>{{ busy ? 'Queued for the worker' : 'Recompute now' }}</span></button>
        </form>
    </span>
{%- endmacro %}

{# A STORED INSTANT, as the cell stamp the house prints. #}
{% macro stamp(instant) %}<time datetime="{{ instant|date('c') }}" data-localtime-format="stamp">{{ instant|date('j M')|lower }} &middot; {{ instant|date('H:i') }}</time>{% endmacro %}

{# THE DRIFT BANNER — answers that changed since the run before with no
   history line touching them; absent while there is none. The shell's
   attention banner (@Shell/_banner.html.twig), its words and doors set here;
   reviewed, it keeps the record in the ok tone. `open` is where the drift
   card is. #}
{% macro drift(lines, unreviewed, token, back, open) %}
    {%- set changed = lines|reduce((n, line) => n + line.places|length, 0) -%}
    {%- if changed > 0 %}
        {%- set done = unreviewed == 0 %}
        {%- set actions = open ? {'Open': open} : {} %}
        {%- if not done %}{% set actions = actions|merge({'Mark reviewed': {action: path('team_permissions_drift_reviewed'), fields: {_token: token, back: back}}}) %}{% endif %}
        {% include '@Shell/_banner.html.twig' with {
            title: done ? changed ~ ' unrecorded changes · marked reviewed' : changed ~ (changed == 1 ? ' answer changed' : ' answers changed') ~ ' with no recorded change',
            text: 'nothing in the history explains it',
            actions: actions,
            tone: done ? 'ok' : 'warn',
            id: open != '#drift' ? 'drift' : null,
        } only %}
    {%- endif %}
{%- endmacro %}
