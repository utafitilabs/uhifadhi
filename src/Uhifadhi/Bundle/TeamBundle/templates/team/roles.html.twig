{# TEAM · ROLES — what authority exists on this installation, and who holds it.

   TWO THINGS DECIDE IT AND THERE IS NO THIRD: the tier, and the permission a
   position carries. There is no Role entity and this page assumes none.

   IT WRITES NOTHING. The matrix is edited on Positions. #}
{% extends '@Shell/page.html.twig' %}

{% block title %}Team · Roles{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('@Team/_stylesheets.html.twig') }}
{% endblock %}

{% block shell_breadcrumbs %}
    <a href="{{ path('team_index') }}">uhifadhi</a> / <a href="{{ path('team_index') }}">team</a> / roles
{% endblock %}

{% block shell_page_title %}Team{% endblock %}
{% block shell_page_subtitle %}What authority exists on this installation, and who holds it.{% endblock %}

{% block shell_page_actions %}
    <a class="tgl w-act" href="{{ path('team_positions') }}">Positions &amp; permissions</a>
{% endblock %}

{% block shell_page %}
    <div class="factband">
        {% for fact in facts %}
            <span class="f"><span class="k">{{ fact.label }}</span><span class="v">{{ fact.value }}{% if fact.qualifier %}<em>{{ fact.qualifier }}</em>{% endif %}</span></span>
        {% endfor %}
        <span class="sp"></span>
    </div>

    <div class="c" style="margin-bottom:20px">
        <span class="tab">The three tiers<span class="src">&middot; not a grant</span></span>
        <div class="sxlead">
            <span class="t">
                {{ ux_icon('shell:triangle-alert') }}
                <span><b>A tier is not a role and grants no capability by itself &mdash; except for the two that grant all of them.</b>
                Administering the team is an ordinary grant, <span class="mono">directory.manage</span>, so &ldquo;who runs this place&rdquo;
                is not answerable from the tier column alone.</span>
            </span>
        </div>
        <table class="tbl">
            <thead><tr><th>Tier</th><th class="num">People</th><th>Who</th><th>What it means</th></tr></thead>
            <tbody>
            {% for row in tiers %}
                <tr>
                    <td><b>{{ row.tier.label() }}</b></td>
                    <td class="num">{{ row.people }}</td>
                    <td><span class="mono d">{{ row.who }}</span></td>
                    <td><span class="fog">{{ row.meaning }}</span></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        <div class="sxfoot">
            <span>There is <b>one Super Admin</b>. If that account is lost there is no second owner and no break-glass.</span>
            <span class="sp"></span>
            <a class="tgl" href="{{ path('team_index') }}">The people</a>
        </div>
    </div>

    <div class="c">
        <span class="tab">Every grant there is<span class="src">&middot; {{ permissions }} &middot; {{ core }} the platform&rsquo;s, {{ fromModules }} from modules</span></span>
        {# A GRANT IS SHOWN BY BOTH NAMES, ALWAYS: the concern's label with its
           verb, and the pair the voter checks, and every band wears the package
           that declared the concern. A module's pair leaves the matrix when the
           module is removed and stays in the JSON of every position that held
           it; the table states that in its own columns. #}
        <table class="tbl">
            <thead><tr><th>Grant</th><th class="num">Positions</th><th class="num">People</th><th>What it lets somebody do</th></tr></thead>
            <tbody>
            {% for group in groups %}
                <tr class="sxgrp">
                    <td colspan="4"><b>{{ group.heading }}</b> <span class="mono d">&middot; {{ group.source }} &middot; {{ group.note() }}</span></td>
                </tr>
                {% for row in group.rows %}
                    <tr>
                        <td><b>{{ row.label }}</b> <span class="mono d">{{ row.value }}</span></td>
                        <td class="num">{{ row.positions }}</td>
                        <td class="num">{{ row.people }}</td>
                        <td><span class="fog">{{ row.description }}</span></td>
                    </tr>
                {% else %}
                    {# DRAWN SO ITS ABSENCE CANNOT BE MISREAD as "not installed". #}
                    <tr><td colspan="4"><span class="mono d">Installed and declares nothing &mdash; drawn so its absence cannot be misread as &ldquo;not installed&rdquo;</span></td></tr>
                {% endfor %}
            {% endfor %}
            </tbody>
        </table>
        <div class="sxmore">
            <span>{{ permissions }} of {{ permissions }} &middot; nothing hidden</span>
            <span class="sp"></span>
            <a href="{{ path('team_positions') }}">Edit the matrix &rarr;</a>
        </div>
    </div>
{% endblock %}
