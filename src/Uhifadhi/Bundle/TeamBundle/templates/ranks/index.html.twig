{# TEAM › RANKS — the organization's ranks in seniority order, and who holds
   each. A register, so it wears the People-table idiom: the two-line name
   cell (the order where the avatar sits, the name, the code under it), one
   fact per column, the count line, the export door, the Open row action.

   ONE SCALE SAYS NOTHING ABOUT SCALES: no Scale column, and the scale chip
   offers All alone. Once the organization has several, the chip offers each
   scale and the Scale column names it per row — never a band row: a table
   does not separate its rows into groups.

   | design element                              | type    | source                    | status |
   |---------------------------------------------|---------|---------------------------|--------|
   | crumb uhifadhi / team / ranks                | chrome  | routes                    | done   |
   | h1 Team + one-line subtitle                  | chrome  | copy                      | done   |
   | tab strip, Ranks lit                         | control | TeamSectionTabs           | done   |
   | Configure action                             | control | frame                     | done   |
   | card tab "Ranks · N · …"                     | data    | total, scales             | done   |
   | the house bar (.lfilt): scale chip, export, search | control | ?scale=, ?q=        | done   |
   | sort caret on Rank and Holders               | control | ?sort=, ?dir= (house idiom) | done |
   | scale chip: All + count; one option a scale  | control | ?scale=, scaleCounts      | done   |
   | export door "export N rows · CSV"            | control | ranks.export → ranks.csv  | done   |
   | head Rank · [Scale] · Holders · Since · —    | chrome  | several scales            | done   |
   | rank cell: order, name, the code as .sub     | data    | RankRow                   | done   |
   | scale cell (s2)                              | data    | scale.name                | done   |
   | holders door → People filtered on the rank   | control | /team?rank=uuid           | done   |
   | since                                        | data    | rank.createdAt            | done   |
   | Open → configure, the scale's card           | control | #scale-uuid               | done   |
   | the register foot (@Shell/_foot)             | control | ?page=, ?per= (shell)     | done   |
   | no result row                                | state   | rows empty                | done   |
#}
{% extends '@Shell/page.html.twig' %}
{% import '@Team/team/_bits.html.twig' as bits %}

{% block title %}Team · Ranks{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('@Team/_stylesheets.html.twig') }}
{% endblock %}

{% block shell_breadcrumbs %}<a href="{{ path('team_overview') }}">uhifadhi</a> / <a href="{{ path('team_index') }}">team</a> / ranks{% endblock %}

{% block shell_page_title %}Team{% endblock %}

{% block shell_page_subtitle %}{% if scales|length > 1 %}The organization&rsquo;s scales of ranks, highest first, with who holds each rank.{% else %}The organization&rsquo;s ranks, highest first, with who holds each.{% endif %}{% endblock %}

{% block shell_page %}
{% set several = scales|length > 1 %}
<div class="c" data-tm>
    <span class="tab">Ranks<span class="src">&middot; {{ total }} &middot; {{ several ? (scales|length ~ ' scales, and who holds each rank') : 'one ladder, and who holds each rank' }}</span></span>

    <div class="lfilt">
        {{ include('@Team/_partial/_filter_chip.html.twig', {
            key: 'scale', name: 'scale', all: 'All', total: total, chosen: query.scale,
            options: several ? scales|map(scale => {value: scale.uuidString, label: scale.name, count: scaleCounts[scale.uuidString] ?? 0}) : [],
            query: query,
        }) }}
        {% if door('ranks.export') %}
            <a class="tm-export" href="{{ path('team_ranks_export', query.with('q', query.q)) }}" title="The rows this filter shows, as CSV &middot; ranks.export">{{ ux_icon('shell:download') }}export <b>{{ table.total }}</b> rows &middot; CSV</a>
        {% endif %}
        {# THE SEARCH IS A FORM; the scale and the sort ride with it, as the
           chip and the export keep them. #}
        <form class="lsearch" method="get" action="{{ path('team_ranks') }}">
            {% for field, value in query.with('q', null) %}
                <input type="hidden" name="{{ field }}" value="{{ value }}">
            {% endfor %}
            {{ ux_icon('shell:search', {width: 14, height: 14}) }}
            <input class="fld" type="search" name="q" value="{{ query.q }}" placeholder="Rank name or short code" aria-label="Search the ranks">
        </form>
    </div>

    <div class="tm-scroll">
        <table class="tbl">
            {# THE HOUSE IN-COLUMN SORT CARET, as the Positions register draws
               it: the sorted header alone says so, with the direction as a
               mark, and every sortable header is a link that turns it over. #}
            <thead><tr>
                {% for column, label in {rank: 'Rank', holders: 'Holders'} %}
                    {% set sorted = query.sort == column %}
                    <th{{ sorted ? ' class="sorted"' }} aria-sort="{{ sorted ? (query.direction == 'desc' ? 'descending' : 'ascending') : 'none' }}"><a href="{{ path('team_ranks', query.sortedBy(column)) }}">{{ label }}</a></th>
                    {% if column == 'rank' and several %}<th>Scale</th>{% endif %}
                {% endfor %}
                <th>Since</th><th></th>
            </tr></thead>
            <tbody>
                {% for line in rows %}
                    {% set row = line.row %}
                    <tr>
                        <td><div class="who"><span class="rk-ord">{{ row.order }}</span><b>{{ row.rank.name }}</b></div><span class="sub">{{ row.rank.shortCode }}</span></td>
                        {% if several %}<td><span class="tm-ladder">{{ line.scale.name }}</span></td>{% endif %}
                        <td><a class="tm-holders" href="{{ path('team_index', {rank: row.rank.uuidString}) }}"><b>{{ row.holders }}</b> {{ row.holders == 1 ? 'person' : 'people' }} {{ ux_icon('shell:chevron-right', {width: 12, height: 12}) }}</a></td>
                        <td><span class="tm-code">{% if row.rank.createdAt %}<time datetime="{{ row.rank.createdAt|date('c') }}" data-localtime-format="day">{{ row.rank.createdAt|date('j M Y') }}</time>{% else %}&mdash;{% endif %}</span></td>
                        <td class="door"><a class="open-btn" href="{{ path('team_configure_ranks') }}#scale-{{ line.scale.uuidString }}">Open</a></td>
                    </tr>
                {% else %}
                    <tr><td colspan="{{ several ? 5 : 4 }}">
                        <div class="tm-nores">
                            {{ bits.icon_search() }}
                            {% if total == 0 %}
                                <span>No ranks yet. They are written on <a href="{{ path('team_configure_ranks') }}">Team configure &rsaquo; Ranks</a>.</span>
                            {% else %}
                                <span>No rank matches {% if query.q %}&ldquo;{{ query.q }}&rdquo;{% else %}this filter{% endif %}. <a href="{{ path('team_ranks') }}">Show every rank</a>.</span>
                            {% endif %}
                        </div>
                    </td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {% include '@Shell/_foot.html.twig' with {
        count: table.total, noun: 'ranks', one: 'rank',
        perPage: table.size, page: table.page, pages: table.pages, links: links,
    } only %}
</div>
{% endblock %}
