{# MY CHECK-INS (#19) — the latest claims, newest first: day, status, in and out, hours. #}
<div class="c" data-me="checkins"><span class="tab">My check-ins<span class="src">&middot; the latest {{ claims|length }}</span></span>
    {% for claim in claims %}
        <div class="rln"><span><b><time datetime="{{ claim.occurredAt|date('c') }}" data-localtime-format="day">{{ claim.occurredAt|date('D j') }}</time></b> <span class="mono d">{{ claim.status ? claim.status.label|lower : '' }}</span></span>
        <span class="mono d"><time datetime="{{ claim.occurredAt|date('c') }}" data-localtime-format="clock">{{ claim.occurredAt|date('H:i') }}</time> &ndash; {% if claim.endedAt %}<time datetime="{{ claim.endedAt|date('c') }}" data-localtime-format="clock">{{ claim.endedAt|date('H:i') }}</time> &middot; {{ area_my_span(claim.occurredAt, claim.endedAt) }}{% else %}on watch &middot; {{ area_my_span(claim.occurredAt, now) }} so far{% endif %}</span></div>
    {% else %}
        <div class="rln"><span class="d">No check-ins yet.</span><span class="mono d">check in on Doria</span></div>
    {% endfor %}
    <div class="sxfoot"><span class="sp"></span><a class="tgl" href="{{ door }}">My duty log &rarr;</a></div>
</div>
