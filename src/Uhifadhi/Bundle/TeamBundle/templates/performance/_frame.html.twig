{# WHAT EVERY SCREEN IN THIS SECTION WEARS — the crumb, the head and the
   three controls. Written once, because a reader moving from the Overview to
   a topic is changing screen and never subject, and a header rebuilt per page
   is a header that drifts per page.

   THE STRIP AND THE CONFIGURE ACTION ARE NOT HERE, on purpose: they are the
   FRAME's, drawn from the surface this section's routes declare
   (PerformanceSectionTabs). A section that built its own would be the one
   place in the product where either of them moved — and that is exactly what
   this template did until the section declared itself.

   A page fills `perf_page` and nothing else. #}
{% extends '@Shell/page.html.twig' %}

{% block title %}Performance{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('@Team/performance/_stylesheets.html.twig') }}
{% endblock %}

{% block shell_breadcrumbs %}
    <a href="{{ path('team_index') }}">uhifadhi</a> /
    <a href="{{ path('team_departments') }}">departments</a> /
    {% block perf_crumb %}performance{% endblock %}
{% endblock %}

{% block shell_page_title %}Performance{% endblock %}

{% block shell_page_subtitle %}
    {{ scope.label }} &middot; {{ period.label }}, against {{ previous.label }}.
{% endblock %}

{% block shell_page_actions %}
    {# THE SCOPE IS A PLACE, so every option is a link and the control needs
       no script of ours: the organization's page and one area's page are two
       addresses, and either can be sent to somebody. #}
    <label class="ov-ctl">
        <span class="k">Scope</span>
        <details class="i-dd">
            <summary class="mchip i-ddt">
                <span class="i-ddval">{{ scope.label }}</span>
                <span class="i-ddcaret">&#9662;</span>
            </summary>
            <div class="i-ddmenu">
                <span class="i-ddhead">whose performance</span>
                <a class="i-ddopt{{ scope.isOrganization ? ' on' }}" href="{{ path('team_performance', {period: kind.value}) }}">
                    <span class="i-ddopt-l">{{ organization }}</span>
                </a>
                {% for area in areas %}
                    <a class="i-ddopt{{ scope.areaUuid == area.uuidString ? ' on' }}"
                       href="{{ path('team_performance', {period: kind.value, area: area.uuidString}) }}">
                        <span class="i-ddopt-l">{{ area.name }}</span>
                    </a>
                {% endfor %}
            </div>
        </details>
    </label>

    {{ include('@Shell/_period_group.html.twig', {kinds: kinds, chosen: kind.value, urls: urls}, with_context = false) }}

    {# WHAT THE PERIOD IS READ AGAINST. Two options and not the design's
       three: "the declared target" is not a period — it compares a figure
       with what somebody committed to, which is a goal's business and is
       already answered in the ledger's Pace column. Two kinds of comparison
       behind one control would make "up 3" mean two things on one page. #}
    <label class="ov-ctl sm">
        <span class="k">Compare with</span>
        <details class="i-dd">
            <summary class="mchip i-ddt">
                <span class="i-ddval">{{ compare.label(period) }}</span>
                <span class="i-ddcaret">&#9662;</span>
            </summary>
            <div class="i-ddmenu">
                <span class="i-ddhead">what the movement is measured against</span>
                {% for option in comparisons %}
                    <a class="i-ddopt{{ option.on ? ' on' }}" href="{{ option.url }}">
                        <span class="i-ddopt-l">{{ option.label }}</span>
                    </a>
                {% endfor %}
            </div>
        </details>
    </label>
{% endblock %}

{% block shell_page %}{% block perf_page %}{% endblock %}{% endblock %}
