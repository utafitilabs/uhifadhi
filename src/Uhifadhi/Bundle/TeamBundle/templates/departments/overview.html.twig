{# DEPARTMENTS · OVERVIEW — the section's first tab, AND A WIDGET SURFACE.

   SCOPED, STAFFED AND ATTACHED, read from the organization inwards. Every
   figure here is owned somewhere else — by the register, by Team, by
   Performance — and this page reads them and writes none of them, which is why
   it carries no control at all.

   THE CELLS ARE A COMPOSITION. What a reader comes here for differs by who
   they are, so the surface ships directions and the reader adopts one; the
   band and the doors below are not part of it, because the band is what the
   section IS and the doors are the way out of it, and neither is a reading
   anybody would arrange differently.

   THE HEADER IS THE SECTION'S, NOT THIS TAB'S. The title is "Departments" on
   every tab of the section and the strip says which one you are on; the
   subtitle is this tab's one line. Both sockets belong to the shell's frame,
   and the strip and the Configure action are written by it. #}
{% extends '@Shell/page.html.twig' %}
{% import '@Team/departments/_bits.html.twig' as di %}

{% block title %}Departments{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('@Team/_stylesheets.html.twig') }}
{% endblock %}

{% block shell_breadcrumbs %}
    <a href="{{ path('team_departments_overview') }}">uhifadhi</a> / departments / overview
{% endblock %}

{% block shell_page_title %}Departments{% endblock %}
{% block shell_page_subtitle %}Scoped, staffed and attached.{% endblock %}

{% block shell_page_actions %}
    <a class="cta" href="{{ path('team_departments') }}#add">{{ ux_icon('shell:plus', {width: 15, height: 15}) }} Add a department</a>
    <a class="tgl w-act" href="{{ path('department_widgets') }}">{{ ux_icon('shell:layout-template', {width: 15, height: 15}) }} Widget library</a>
{% endblock %}

{% block shell_page %}
    <div data-dp>
        {# WHAT NEEDS ATTENTION, ONE BANNER ABOVE THE STRIP: the departments
           reading no module, and the positions nobody holds. #}
        {%- set attention = [] -%}
        {%- if unattachedTotal > 0 -%}
            {%- set more = unattachedTotal - unattached|length -%}
            {%- set attention = attention|merge([{
                head: unattachedTotal ~ (unattachedTotal == 1 ? ' department reads' : ' departments read') ~ ' no module',
                cause: unattached|map(line => line.label)|join(', ') ~ (more > 0 ? ' and ' ~ more ~ ' more' : ''),
                door: 'Modules', url: path('team_departments_modules'),
            }]) -%}
        {%- endif -%}
        {%- if vacanciesTotal > 0 -%}
            {%- set attention = attention|merge([{
                head: vacanciesTotal ~ (vacanciesTotal == 1 ? ' position is' : ' positions are') ~ ' held by nobody',
                cause: 'the longest vacant is ' ~ (vacancies|first).label,
                door: door('positions.read') ? 'Positions' : null, url: path('team_positions'),
            }]) -%}
        {%- endif %}
        {{ di.attention('Needs attention', attention) }}

        {# THE IDENTITY BAND — the facts this section is, stated as fragments.
           The same band an area's overview opens with, in the same position. #}
        <div class="factband">
            {% for fact in facts %}
                <span class="f"><span class="k">{{ fact.label }}</span><span class="v">{{ fact.value }}{% if fact.qualifier %}<em>{{ fact.qualifier }}</em>{% endif %}</span></span>
            {% endfor %}
            <span class="sp"></span>
            <a class="more" href="{{ path('team_departments_configure') }}">Departments settings &rarr;</a>
        </div>

        {# THE CELL CLASSES ARE THE SHELL'S: `.w-grid > .w-cell.w-span-N`. #}
        <div class="w-grid">
            {% for widget in widgets %}
                {% if widget.on %}
                    <div data-w="{{ widget.id }}" class="w-cell w-span-{{ widget.cols }}">
                        <div class="w-inner">
                            {{ include('@Team/departments/_w_' ~ widget.id ~ '.html.twig') }}
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>

        <h2 class="zone">Where this goes on</h2>
        <div class="sxdoors">
            <a class="sxdoor" href="{{ path('team_departments') }}"><b>The register<span class="ar">&rarr;</span></b><span>Every department, created and scoped here &mdash; the cards, the add form and the scope change.</span></a>
            <a class="sxdoor" href="{{ path('team_departments_modules') }}"><b>Modules<span class="ar">&rarr;</span></b><span>Which department reads which module &mdash; one row a department, one column a module.</span></a>
            <a class="sxdoor" href="{{ path('team_index') }}"><b>Team<span class="ar">&rarr;</span></b><span>The people, the positions they sit in and where they are stationed.</span></a>
        </div>
    </div>
{% endblock %}
