{
    "name": "uhifadhi/registry-bundle",
    "type": "symfony-bundle",
    "description": "The uhifadhi registry: the module catalogue, the per-area install ledger, the parking gate and the permissions modules declare.",
    "keywords": [
        "catalogue",
        "conservation",
        "module",
        "platform",
        "registry",
        "symfony",
        "uhifadhi"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Ezekiel Mjema",
            "homepage": "https://github.com/eemjema"
        }
    ],
    "require": {
        "php": ">=8.4",
        "composer-runtime-api": "^2.0",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.5",
        "doctrine/persistence": "^3.1 || ^4.0",
        "dragonmantank/cron-expression": "^3.4",
        "psr/clock": "^1.0",
        "psr/container": "^1.1 || ^2.0",
        "symfony/clock": "^7.3 || ^8.0",
        "symfony/config": "^7.3 || ^8.0",
        "symfony/console": "^7.3 || ^8.0",
        "symfony/dependency-injection": "^7.3 || ^8.0",
        "symfony/doctrine-bridge": "^7.3 || ^8.0",
        "symfony/doctrine-messenger": "^7.3 || ^8.0",
        "symfony/event-dispatcher-contracts": "^3.5",
        "symfony/framework-bundle": "^7.3 || ^8.0",
        "symfony/http-foundation": "^7.3 || ^8.0",
        "symfony/http-kernel": "^7.3 || ^8.0",
        "symfony/lock": "^7.3 || ^8.0",
        "symfony/messenger": "^7.3 || ^8.0",
        "symfony/scheduler": "^7.3 || ^8.0",
        "symfony/service-contracts": "^3.5",
        "symfony/uid": "^7.3 || ^8.0",
        "uhifadhi/contracts": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Uhifadhi\\Bundle\\RegistryBundle\\": "",
            "Uhifadhi\\Bundle\\RegistryBundle\\Migrations\\": "migrations/"
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Uhifadhi\\Bundle\\RegistryBundle\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
