{# THE ZONES HUB · OVERVIEW — how an area is divided, stated.

   Design: areas/<area>/zones/index.html.

   The banner names the zones no station stands in and opens them in the
   register; the strip and the four figures belong here and nowhere else in
   the hub; the plate draws every zone and station on the ground; the two
   plots rank the zones by extent and by the share counted as covered. It
   lists nothing: the register is the hub's other page.

   A LENS, NOT A FENCE. Reading the scheme is for anybody who may see the
   area; the writes are the configure section's. #}
{% extends '@Shell/page.html.twig' %}

{% block title %}{{ area.name }} · zones{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('@Area/_stylesheets.html.twig') }}
{% endblock %}

{% block shell_breadcrumbs %}
    <a href="{{ path('area_index') }}">uhifadhi</a> / <a href="{{ path('area_index') }}">areas</a> / <a href="{{ path('area_show', {uuid: area.uuidString}) }}">{{ area.name|lower }}</a> / zones
{% endblock %}

{% block shell_page_title %}Zones{% endblock %}

{% block shell_page_subtitle %}{{ area.name }}&rsquo;s zones: the ground each one covers and what is worked from it.{% endblock %}

{% block shell_page_actions %}
    <a class="tgl w-act" href="{{ path('area_stations', {uuid: area.uuidString}) }}">Stations on the area</a>
{% endblock %}

{% block shell_page_tabs %}{{ include('@Area/zone/_hub_tabs.html.twig') }}{% endblock %}

{% block shell_page %}
{% set o = overview %}
{% set list = path('area_zones_list', {uuid: area.uuidString}) %}

{% if set.isEmpty %}
    <div class="grid">
        <div class="c zempty">
            <b class="zeh">This area has no zones yet</b>
            <p class="zeb">A zone is <b>a lens, not a fence</b>: it gives every module a second way to group
                what it already shows &mdash; its own records, by zone &mdash; and never hides or blocks a record.</p>
            <p class="zeb">Until the first import {{ area.name }} simply has none: no zone column, no zone filter
                and no zone layer anywhere in the product. The stations and the people are still here, unzoned.</p>
            <span class="zea"><a class="btn sm" href="{{ path('area_zones_configure', {uuid: area.uuidString}) }}">Configure zones {{ ux_icon('shell:arrow-right') }}</a></span>
        </div>
    </div>
{% else %}
    {% set n = o.unstationed|length %}
    {{ include('@Shell/_banner.html.twig', {
        title: n > 0 ? n ~ (n == 1 ? ' zone has' : ' zones have') ~ ' no station' : null,
        text: o.unstationed|join(', '),
        actions: {'Zones': list ~ '?stations=none'},
    }, with_context: false) }}

    <div class="factband ov-band">
        <span class="f"><span class="k">Zones</span><span class="v">{{ o.zones }}<em>presence-driven</em></span></span>
        <span class="f"><span class="k">Zoned</span><span class="v">{{ o.zonedKm2|number_format }} km&sup2;<em>of {{ o.areaKm2|number_format }}</em></span></span>
        <span class="f"><span class="k">Unzoned</span><span class="v">{{ o.unzonedKm2|number_format }} km&sup2;<em>in no zone, and legal</em></span></span>
        <span class="f"><span class="k">Stations</span><span class="v">{{ o.stations }}<em>{{ o.stationsUnzoned }} in no zone</em></span></span>
        <span class="f"><span class="k">Imported</span><span class="v">
            {%- if o.importedAt -%}
                <time datetime="{{ o.importedAt|date('c') }}" data-localtime-format="day">{{ o.importedAt|date('j M Y') }}</time><em>one GeoJSON{% if o.importedFeatures %} &middot; {{ o.importedFeatures }} {{ o.importedFeatures == 1 ? 'feature' : 'features' }}{% endif %}</em>
            {%- else -%}
                &mdash;<em>no import recorded</em>
            {%- endif -%}
        </span></span>
        <span class="sp"></span>
    </div>

    {# FOUR FIGURES. One is the area's own and three are what the modules
       publish by zone; a figure no installed module publishes reads a dash
       and the card stays. #}
    <div class="grid kstrip ov-kpis">
        <div class="c kpi">
            <span class="tab">Zones with a station</span>
            <b class="disp">{{ o.zonesWithAStation }}</b>
            <span class="sub">of {{ o.zones }} {{ o.zones == 1 ? 'zone' : 'zones' }}</span>
        </div>
        {% for module in o.modules %}
            <div class="c kpi">
                <span class="tab">{{ module.label }}</span>
                <b class="disp">{{ module.display }}{{ module.unit == '%' ? ' %' : module.unit }}</b>
                <span class="sub">{{ module.caption|lower }} &middot; inside a zone</span>
            </div>
        {% endfor %}
        {% if o.modules|length < moduleCards %}
            {% for _ in 1..(moduleCards - o.modules|length) %}
                <div class="c kpi">
                    <span class="tab">From the modules</span>
                    <b class="disp">&mdash;</b>
                    <span class="sub">no module publishes this</span>
                </div>
            {% endfor %}
        {% endif %}
    </div>

    <div class="grid">
        <div class="c" id="map">
            <span class="tab">All zones on the ground<span class="src">&middot; the whole area &middot; {{ o.zones }} {{ o.zones == 1 ? 'zone' : 'zones' }} &middot; {{ o.stations }} {{ o.stations == 1 ? 'station' : 'stations' }}</span></span>
            {{ render_map(map, {
                'role': 'img',
                'aria-label': area.name ~ ', its zones and its stations',
            }) }}
        </div>
    </div>

    <div class="grid g2 ov-plots">
        <div class="c">
            <span class="tab">Extent by zone<span class="src">&middot; {{ o.areaKm2|number_format }} km&sup2; &middot; {{ o.zones }} {{ o.zones == 1 ? 'zone' : 'zones' }}</span></span>
            {{ atlas_bars(o.byExtent) }}
            <div class="sxmore"><span>{{ o.zones }} {{ o.zones == 1 ? 'zone' : 'zones' }}{{ o.unzonedKm2 > 0 ? ' and no zone' }} &middot; nothing hidden</span><span class="sp"></span><a href="{{ list }}">The zones &rarr;</a></div>
        </div>
        <div class="c">
            <span class="tab">Covered in {{ o.month }}<span class="src">&middot; by zone</span></span>
            {{ atlas_bars(o.byCovered) }}
            <div class="sxmore"><span>{{ o.byCovered.bars|length }} of {{ o.zones }} {{ o.zones == 1 ? 'zone' : 'zones' }} &middot; {{ o.byCovered.bars|length == o.zones ? 'nothing hidden' : 'the rest unpublished' }}</span><span class="sp"></span><a href="{{ list }}?sort=covered">The zones &rarr;</a></div>
        </div>
    </div>
{% endif %}
{% endblock %}
