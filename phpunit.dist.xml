<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true">
    <php>
        <!--
            One process holds every bundle's kernels at once — several compiled
            containers, each with its own cache — and 128M is not enough for
            that; a run that compiles them from a cold cache, as CI always does,
            passes 512M. The limit is raised here rather than on a command line
            so a local run and CI are the same run.
        -->
        <ini name="memory_limit" value="1G"/>
        <!--
            No KERNEL_CLASS. The core is one repository with one phpunit config
            and several bundles, so an env var can only ever name one of their
            kernels; every test base names its own in code instead.
        -->
        <!--
            ONE database for the whole core. The bundles here are tagged and
            released together, so their suites can never be run against two
            different schemas; a single URL is the honest shape. Port 5434 is
            the local PostGIS cluster, 5432 in CI.
        -->
        <env name="UHIFADHI_TEST_DATABASE_URL"
             value="postgresql://app:app@127.0.0.1:5434/uhifadhi_core_test?serverVersion=17&amp;charset=utf8"/>
    </php>
    <testsuites>
        <!--
            The core as one installation: the specifications that are about the
            bundles working together rather than about any one of them.
        -->
        <testsuite name="Core">
            <directory>tests/Core</directory>
        </testsuite>
        <!-- One suite per package: a suite is a package, exactly as after a split. -->
        <testsuite name="Contracts">
            <directory>src/Uhifadhi/Contracts/tests</directory>
        </testsuite>
        <testsuite name="RegistryBundle">
            <directory>src/Uhifadhi/Bundle/RegistryBundle/tests</directory>
        </testsuite>
        <testsuite name="ShellBundle">
            <directory>src/Uhifadhi/Bundle/ShellBundle/tests</directory>
        </testsuite>
        <testsuite name="TeamBundle">
            <directory>src/Uhifadhi/Bundle/TeamBundle/tests</directory>
        </testsuite>
        <testsuite name="AtlasBundle">
            <directory>src/Uhifadhi/Bundle/AtlasBundle/tests</directory>
        </testsuite>
        <testsuite name="AreaBundle">
            <directory>src/Uhifadhi/Bundle/AreaBundle/tests</directory>
        </testsuite>
    </testsuites>
    <source restrictNotices="true" restrictWarnings="true">
        <include>
            <directory>src</directory>
        </include>
        <exclude>
            <directory>src/Uhifadhi/Bundle/*/tests</directory>
        </exclude>
    </source>
</phpunit>
