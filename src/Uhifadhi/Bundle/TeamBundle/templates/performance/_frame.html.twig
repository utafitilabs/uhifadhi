{# WHAT EVERY SCREEN IN THIS SECTION WEARS — the crumb, the head and the
   three controls. Written once, because a reader moving from the Overview to
   a topic is changing screen and never subject, and a header rebuilt per page
   is a header that drifts per page.

   THE STRIP AND THE CONFIGURE ACTION ARE NOT HERE, on purpose: they are the
   FRAME's, drawn from the surface this section's routes declare
   (PerformanceSectionTabs). A section that built its own would be the one
   place in the product where either of them moved — and that is exactly what
   this template did until the section declared itself.

   A page fills `perf_page` and nothing else. #}
{% extends '@Shell/page.html.twig' %}

{% block title %}Performance{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('@Team/performance/_stylesheets.html.twig') }}
{% endblock %}

{% block shell_breadcrumbs %}
    <a href="{{ path('team_index') }}">uhifadhi</a> /
    <a href="{{ path('team_departments') }}">departments</a> /
    {% block perf_crumb %}performance{% endblock %}
{% endblock %}

{% block shell_page_title %}Performance{% endblock %}

{% block shell_page_subtitle %}
    {{ scope.label }} &middot; {{ period.label }}, against {{ previous.label }}.
{% endblock %}

{% block shell_page_actions %}
    {# THE THREE CONTROLS ARE THE HOUSE DROPDOWN, and every option is an
       address: the organization's page and one area's page, this month and
       this quarter, are pages that can be sent to somebody.

       WHAT THE PERIOD IS READ AGAINST offers two comparisons and not three:
       "the declared target" is not a period — it compares a figure with what
       somebody committed to, which is a goal's business and already answered
       in the ledger's Pace column. #}
    {%- set scopeUrls = {'': path('team_performance', {period: kind.value})} -%}
    {%- set scopeAreas = [] -%}
    {%- for area in areas -%}
        {%- set scopeUrls = scopeUrls|merge({(area.uuidString): path('team_performance', {period: kind.value, area: area.uuidString})}) -%}
        {%- set scopeAreas = scopeAreas|merge([{value: area.uuidString, label: area.name}]) -%}
    {%- endfor -%}
    {{ include('@Team/_partial/_link_dropdown.html.twig', {
        sm: true,
        name: 'scope', label: 'Scope', icon: 'shell:map', end: true, default: '',
        value: scope.isOrganization ? '' : scope.areaUuid,
        groups: [
            {label: 'scope', options: [{value: '', label: organization}]},
            {label: 'Areas', options: scopeAreas},
        ],
        urls: scopeUrls,
    }, with_context = false) }}

    {{ include('@Team/_partial/_link_dropdown.html.twig', {
        sm: true,
        name: 'period', label: 'Period', end: true, default: (periods|first).value,
        value: kind.value,
        groups: [
            {label: 'period', options: periods|slice(0, 1)},
            {label: 'Spans', options: periods|slice(1)},
        ],
        urls: urls,
    }, with_context = false) }}

    {%- set compareUrls = {} -%}
    {%- for option in comparisons -%}
        {%- set compareUrls = compareUrls|merge({(option.value): option.url}) -%}
    {%- endfor -%}
    {{ include('@Team/_partial/_link_dropdown.html.twig', {
        sm: true,
        name: 'compare', label: 'Compare with', icon: 'shell:arrow-right-left', end: true, default: (comparisons|first).value,
        value: (comparisons|filter(option => option.on)|first).value,
        groups: [{label: 'compare with', options: comparisons|map(option => {value: option.value, label: option.label})}],
        urls: compareUrls,
    }, with_context = false) }}
{% endblock %}

{% block shell_page %}{% block perf_page %}{% endblock %}{% endblock %}
