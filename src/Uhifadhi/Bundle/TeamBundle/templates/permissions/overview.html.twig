{# TEAM › PERMISSIONS — THE HUB, OVERVIEW.

   What the worker's latest run found, read from the readers and never asked
   of a voter: the drift banner, the band, the four figures, the four plots in
   the Team overview's own cards, the lists for review and the permission
   history. #}
{% extends '@Team/permissions/_frame.html.twig' %}
{% import '@Team/permissions/_bits.html.twig' as pp %}

{% block title %}Permissions{% endblock %}

{% block shell_breadcrumbs %}
    <a href="{{ path('team_index') }}">uhifadhi</a> / team / permissions
{% endblock %}

{% block shell_page_title %}Permissions{% endblock %}

{% block permissions_run %}{{ pp.recompute(freshness, token, 'team_permissions_overview') }}{% endblock %}

{% block shell_page %}
    {% set k = kpis %}

    {# THE DRIFT BANNER — answers that changed since the run before with no
       history line touching them. Absent while there is none. #}
    {{ pp.drift(drift.lines, drift.unreviewed, token, 'team_permissions_overview', tools.analysis ? tools.analysis ~ '#drift' : null) }}

    {# THE BAND — the run's own figures. #}
    <div class="factband pp-band">
        <span class="f"><span class="k">As of</span><span class="v">{% if freshness.asOf %}{{ pp.stamp(freshness.asOf) }}<em>next run {{ pp.stamp(freshness.nextRun) }}</em>{% else %}{{ shell_as_of(null) }}{% endif %}</span></span>
        <span class="f"><span class="k">Positions</span><span class="v">{{ k.positions }}</span></span>
        <span class="f"><span class="k">People</span><span class="v">{{ k.people }}</span></span>
        <span class="f"><span class="k">Questions</span><span class="v">{{ k.questionsFiled }}<em>filed</em></span></span>
        <span class="sp"></span>
        {% if tools.analysis %}<a class="more" href="{{ tools.analysis }}">Analysis &rarr;</a>{% endif %}
    </div>

    {# FOUR FIGURES, the Team overview's row. #}
    <div class="grid kstrip pp-kpis">
        <div class="c kpi"><span class="tab">Positions</span><b class="disp">{{ k.positions }}</b><span class="sub">{{ k.vacant }} vacant &middot; {{ k.locked }} locked</span></div>
        <div class="c kpi"><span class="tab">People</span><b class="disp">{{ k.people }}</b><span class="sub">{{ k.staff }} staff &middot; {{ k.above }} above the matrix</span></div>
        <div class="c kpi"><span class="tab">Exceptions</span><b class="disp">{{ k.exceptionsInForce }}</b><span class="sub">in force &middot; {{ k.notInForce }} held, not in force</span></div>
        <div class="c kpi"><span class="tab">Needs attention</span><b class="disp">{{ k.needsAttention }}</b><span class="sub">{{ k.reachNothing }} reach nothing &middot; {{ k.notHonoured }} {{ k.notHonoured == 1 ? 'permission' : 'permissions' }} not honoured</span></div>
    </div>

    {# FOUR PLOTS, the Team overview's cards. #}
    <div class="grid g2 pp-ov">
        <div class="c">
            <span class="tab">Resources by positions holding them<span class="src">&middot; {{ concernsByPositions|length }}</span></span>
            {{ atlas_bars(concerns) }}
            <div class="sxmore"><span>{{ shownConcerns }} of {{ concernsByPositions|length }} resources &middot; {{ concernsByPositions|length - shownConcerns }} more in Positions</span><span class="sp"></span>{% if tools.positions %}<a href="{{ tools.positions }}">Positions &rarr;</a>{% endif %}</div>
        </div>
        <div class="c">
            <span class="tab">Positions by permissions held<span class="src">&middot; {{ k.positions }}</span></span>
            {{ atlas_bars(pairs) }}
            <div class="sxmore"><span>{{ shownPositions }} of {{ k.positions }}</span><span class="sp"></span>{% if tools.positions %}<a href="{{ tools.positions }}">The positions &rarr;</a>{% endif %}</div>
        </div>
    </div>
    <div class="grid g2 pp-ov">
        <div class="c">
            <span class="tab">Who can act, by place<span class="src">&middot; {{ whoCanActByPlace|length }} places</span></span>
            {{ atlas_chart(places, '', '', {'--chart-height': '114px', 'role': 'img', 'aria-label': whoCanActByPlace|map(p => p.name ~ ' ' ~ p.people)|join(', ')}) }}
            <div class="sxmore"><span>a person counts in every place their placement covers</span><span class="sp"></span>{% if tools.analysis %}<a href="{{ tools.analysis }}">Analysis &rarr;</a>{% endif %}</div>
        </div>
        <div class="c">
            <span class="tab">Permission changes by month<span class="src">&middot; last 6 months</span></span>
            {{ atlas_chart(months, '', '', {'--chart-height': '114px', 'role': 'img', 'aria-label': changesByMonth|map(m => m.month ~ ' ' ~ m.changes)|join(', ')}) }}
            <div class="sxmore"><span>{{ changesByMonth|reduce((n, m) => n + m.changes, 0) }} changes &middot; {{ (changesByMonth|first).month }}&ndash;{{ (changesByMonth|last).month }}</span><span class="sp"></span><a href="#history">The history &rarr;</a></div>
        </div>
    </div>

    {# THE LISTS FOR REVIEW, filed in the same run; each opens on Analysis. #}
    <div class="c">
        <span class="tab">For review<span class="src">&middot; {{ review|length }} lists &middot; {% if freshness.asOf %}as of {{ pp.stamp(freshness.asOf) }}{% else %}not computed yet{% endif %}</span></span>
        <table class="tbl pp-stt">
            <thead><tr><th scope="col" class="num">Count</th><th scope="col">List</th><th scope="col" aria-label="Open"></th></tr></thead>
            <tbody>
                {% for list in review %}
                    <tr>
                        <td class="num{{ list.alarm and list.count > 0 ? ' pp-bad' }}">{{ list.count }}</td>
                        <td>{{ list.label }}<span class="pp-sub" title="{{ list.summary }}">{{ list.summary }}</span></td>
                        <td class="pp-door">{% if tools.analysis %}<a class="more" href="{{ tools.analysis }}#{{ list.id }}">Analysis &rarr;</a>{% endif %}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    {# THE PERMISSION HISTORY — every change, newest first, paged by the house
       register (the analysis page's controller): the change with who and when
       under it, then before → after. #}
    {% import '@Team/permissions/_analysis_bits.html.twig' as an %}
    {% set rctl = 'uhifadhi--team-bundle--permission-analysis' %}
    {% set reg = {noun: 'changes', one: 'change', count: history|length, pages: max(1, (history|length / 20)|round(0, 'ceil'))} %}
    <div class="c" id="history" data-controller="{{ rctl }}" data-action="click->{{ rctl }}#click click@document->{{ rctl }}#outside keydown@document->{{ rctl }}#escape">
        <span class="tab">Permission history<span class="src">&middot; newest first</span></span>
        {% if history is not empty %}
        <div data-pa-reg="history">
            <table class="tbl pp-hist">
                <thead><tr><th scope="col">Change</th><th scope="col">Before &rarr; after</th></tr></thead>
                <tbody>
                    {%- for line in history %}
                    <tr data-pa-r{% if loop.index > 20 %} hidden{% endif %}>
                        <td class="pp-hd">{{ line.lead }} {{ line.on }}{% if line.tail %} {{ line.tail }}{% endif %}<span class="pp-sub">{{ line.by }} &middot; {{ pp.stamp(line.when) }}</span></td>
                        <td><span class="ph-diff">
                            {%- for part in line.diff -%}
                                {%- if part[0] == 'was' -%}<s>{{ part[1] }}</s>{% if not loop.last %} &rarr; {% endif %}
                                {%- elseif part[0] == 'now' -%}<i>{{ part[1] }}</i>
                                {%- elseif part[0] == 'added' -%}<i>+ {{ part[1] }}</i>
                                {%- else -%}<s>&minus; {{ part[1] }}</s>
                                {%- endif -%}
                            {%- endfor -%}
                        </span></td>
                    </tr>
                    {%- endfor %}
                </tbody>
            </table>
            {{ an.foot(reg) }}
        </div>
        {% else %}
        <p class="au-why pa-none">No permission change is recorded yet.</p>
        {% endif %}
    </div>
{% endblock %}
