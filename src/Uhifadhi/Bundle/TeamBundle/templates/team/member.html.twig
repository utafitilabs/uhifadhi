{# ONE PERSON'S RECORD, READ.

   RULED 21 SEP: the record wears the station record's skeleton — crumb, the
   head with the mark and a subline of facts, the fact band, one .recgrid of
   cards — and carries NO CONTROL. Changes happen on the configure page; the
   head's Configure is the one door to it. The Position card is one column;
   the ledger is a card of its own; where they are stationed is a fact, twice;
   the side column holds Stationed at, then History. A person with no
   position reads the empty state: the Position card body says so, the ledger
   card is absent.

   | design element                            | type    | source                          | status |
   |-------------------------------------------|---------|---------------------------------|--------|
   | crumb uhifadhi / team / name              | chrome  | routes                          | done   |
   | .dpthead mark + h1 + facts subline        | data    | member, card, placement, posting| done   |
   | pgact: Back to the team · Configure       | control | routes, door                    | done   |
   | .factband Rank (while ranks are used)      | data    | rankNow                         | done   |
   | .factband Reads/Records/Manages/Exports   | data    | figures()                       | done   |
   | band door: What <position> grants →       | control | position record                 | done   |
   | Position card: seat, where, departments   | data    | card, placement                 | done   |
   | Position card: rank line + rank history    | data    | rankNow, ranks                  | done   |
   | Position card foot: reach · departments   | data    | reach, placement                | done   |
   | empty state (.pmx-zero) + Give a position | state   | card is null                    | done   |
   | ledger card: folds, verbs, where, through | data    | card.groups, placement          | done   |
   | module cards after the ledger (seam)      | data    | recordCells (team.record.cells) | done   |
   | Stationed at: plate, station, code, since | data    | stationedAt                     | done   |
   | History: latest 8 of N + View all         | data    | history                         | done   |
#}
{% extends '@Shell/page.html.twig' %}
{% import '@Team/team/_bits.html.twig' as bits %}

{% block title %}{{ member.fullName }} · team{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('@Team/_stylesheets.html.twig') }}
{% endblock %}

{% block shell_page_tabs %}{% endblock %}

{% block shell_breadcrumbs %}
    <a href="{{ path('team_index') }}">uhifadhi</a> / <a href="{{ path('team_index') }}">team</a> / {{ member.fullName|lower }}
{% endblock %}

{% set ground = placement ? placement.groundLabel : null %}
{% set departmentsLabel = placement ? placement.departmentsLabel : null %}

{% block shell_page_head %}
    <div class="dpthead">
        <span class="mark">{{ bits.initials(member) }}</span>
        <div>
            <h1 class="pg">{{ member.fullName }}</h1>
            <p class="pgsub">
                <span>{{ card ? card.name : 'Holds no position' }}</span>
                {%- if stationedAt %} &middot; <span>stationed at {{ stationedAt.stationName }}</span>{% endif -%}
                {%- if card and departmentsLabel %} &middot; <span>{{ departmentsLabel }}</span>{% endif -%}
                {%- if member.positionSince %} &middot; <span>since <time datetime="{{ member.positionSince|date('c') }}" data-localtime-format="day">{{ member.positionSince|date('j M Y') }}</time></span>
                {%- elseif stationedAt %} &middot; <span>since <time datetime="{{ stationedAt.since|date('c') }}" data-localtime-format="day">{{ stationedAt.since|date('j M Y') }}</time></span>{% endif -%}
            </p>
        </div>
    </div>
    <div class="pgact w-pgact">
        <a class="tgl w-act" href="{{ path('team_index') }}">{{ ux_icon('shell:chevron-left', {width: 15, height: 15}) }} Back to the team</a>
        {% if door('directory.manage') %}<a class="tgl w-act" href="{{ path('team_member_configure', {uuid: member.uuidString}) }}">{{ ux_icon('shell:settings', {width: 15, height: 15}) }} Configure</a>{% endif %}
    </div>
{% endblock %}

{% block shell_page %}
{{ include('@Team/team/_scope_banner.html.twig') }}

{# THE BAND: what the position lets this person do, by verb. Read is granted,
   never assumed — a person with no position reads a dash on every figure. #}
<div class="factband">
    {% if usesRanks %}
        <span class="f"><span class="k">Rank</span><span class="v">
            {%- if rankNow %}{{ rankNow.rank.shortCode }}<em>{{ rankNow.rank.name }} &middot; since <time datetime="{{ rankNow.since|date('Y-m-d') }}" data-localtime-format="day">{{ rankNow.since|date('j M Y') }}</time></em>
            {%- else %}&mdash;<em>no rank</em>{% endif -%}
        </span></span>
    {% endif %}
    {% for verb, figure in figures %}
        <span class="f"><span class="k">{{ {read: 'Reads', record: 'Records', manage: 'Manages', export: 'Exports'}[verb] }}</span><span class="v">
            {%- if byTier %}{{ figure.n }}<em>by tier</em>
            {%- elseif card %}{{ figure.n }}{% if figure.note %}<em>{{ figure.note }}</em>{% endif %}
            {%- else %}&mdash;{% if loop.first %}<em>read is granted, never assumed</em>{% endif %}{% endif -%}
        </span></span>
    {% endfor %}
    <span class="sp"></span>
    {% if card %}
        <a class="more" href="{{ path('team_position_show', {uuid: card.uuid}) }}">What {{ card.name }} grants &rarr;</a>
    {% else %}
        <a class="more" href="{{ path('team_positions') }}">The positions register &rarr;</a>
    {% endif %}
</div>

<div class="recgrid">
    <div class="col">
        {# THE POSITION CARD — one column, one line per thing. #}
        <div class="c" id="position">
            <span class="tab">Position{% if usesRanks %} and rank{% endif %}<span class="src">&middot; where it applies</span></span>
            {% if card %}
                <div class="pcard">
                    <span class="pcol-k">Assigned position</span>
                    <div class="psid-f"><span class="v"><b>{{ card.name }}</b><span class="zfrag">
                        {%- if card.seats is null %}{{ card.seatsFilled }} held &middot; unlimited seats
                        {%- else %}{{ card.seatsFilled }} of {{ card.seats }} seats &middot; {{ card.seatsFree }} free{% endif -%}
                    </span></span></div>
                    {% if usesRanks %}{{ _self.rank_line(rankNow) }}{% endif %}
                    <span class="pcol-k">Where</span>
                    <div class="pmx-sc">
                        {%- if placement is null %}<span class="pmx-sk none">&mdash;</span><span class="zfrag">placed nowhere yet</span>
                        {%- elseif placement.wholeOrganization %}<span class="pmx-sk on">The whole organization</span><span class="zfrag">every area at once</span>
                        {%- else %}{% for area in placement.areas %}<span class="pmx-sk on">{{ area.name }}</span>{% endfor %}<span class="zfrag">not the whole organization</span>{% endif -%}
                    </div>
                    <span class="pcol-k">Departments</span>
                    <div class="pmx-sc">
                        {%- if placement is null %}<span class="pmx-sk none">&mdash;</span>
                        {%- elseif placement.allDepartments %}<span class="pmx-sk on">All departments</span><span class="zfrag">{{ departmentsTotal }} of {{ departmentsTotal }}</span>
                        {%- else %}{% for department in placement.departments %}<span class="pmx-sk on">{{ department.name }}</span>{% endfor %}<span class="zfrag">{{ placement.departments|length }} of {{ departmentsTotal }}</span>{% endif -%}
                    </div>
                </div>
                {% if usesRanks and ranks is not empty %}{{ _self.rank_history(ranks) }}{% endif %}
                <div class="pcard-foot">reaches <b>{{ reach }}</b> {{ reach == 1 ? 'person' : 'people' }}<span>&middot;</span><b>{{ placement and not placement.allDepartments ? placement.departments|length : departmentsTotal }}</b> of {{ departmentsTotal }} departments<span class="sp"></span>{% if door('directory.manage') %}<a class="ov-open" href="{{ path('team_member_configure', {uuid: member.uuidString}) }}">Change the position{% if usesRanks %} or rank{% endif %} {{ ux_icon('shell:chevron-right') }}</a>{% endif %}</div>
            {% else %}
                <div class="pcard"><div class="pmx-zero"><span><b>Holds no position.</b> Sign-in only &middot; nothing granted, read included</span></div>{% if usesRanks %}{{ _self.rank_line(rankNow) }}{% endif %}</div>
                {% if usesRanks and ranks is not empty %}{{ _self.rank_history(ranks) }}{% endif %}
                <div class="pcard-foot">no seat, no area, no department<span class="sp"></span>{% if door('directory.manage') %}<a class="ov-open" href="{{ path('team_member_configure', {uuid: member.uuidString}) }}">Give a position{% if usesRanks %} or rank{% endif %} {{ ux_icon('shell:chevron-right') }}</a>{% endif %}</div>
            {% endif %}
        </div>

        {# THE LEDGER — what that actually grants, right now: concern · verbs ·
           where · through which position. Only the groups the position holds
           something in; a card of its own, absent for a person who holds nothing. #}
        {% if byTier %}
            <div class="c">
                <span class="tab">What that actually grants, right now<span class="src">&middot; every concern</span></span>
                <div class="pmx-zero"><span><b>Above the matrix.</b> {{ member.teamRole.label }} grants every permission, by tier &middot; the position changes nothing they may do</span></div>
            </div>
        {% elseif card %}
            {% set granted = card.grantedGroups %}
            <div class="c" data-controller="uhifadhi--team-bundle--folds">
                <span class="tab">What that actually grants, right now<span class="src">&middot; {{ card.concernsGranted }} concern{{ card.concernsGranted == 1 ? '' : 's' }}</span></span>
                <p class="use">Concern &middot; verbs &middot; where &middot; through which position</p>
                {% for group in granted %}
                    <details class="pmf pmfg"{{ loop.first ? ' open' : '' }} data-uhifadhi--team-bundle--folds-target="fold">
                        <summary><b>{{ group.declarer }}</b><span class="pmx-n">{{ group.granted }} of {{ group.granted }}</span></summary>
                        <div class="pmf-b">
                            {% for row in group.grantedRows %}
                                <div class="pmk-row thru">
                                    <span class="pmx-cn"><b>{{ row.label }}</b>{% if row.sensitive %}<span class="pmx-sens"> sensitive</span>{% endif %}</span>
                                    <span class="pmk-chips">{% for verb in row.heldVerbs %}<span class="pmc on">{{ verb.value }}</span>{% endfor %}</span>
                                    <span class="pmx-sc">
                                        {%- if placement is null %}<span class="pmx-sk none">&mdash;</span>
                                        {%- elseif placement.wholeOrganization %}<span class="pmx-sk on">the organization</span>
                                        {%- else %}{% for area in placement.areas %}<span class="pmx-sk on">{{ area.name }}</span>{% endfor %}{% endif -%}
                                    </span>
                                    <span class="pml-thru one"><em>through</em> <b>{{ card.name }}</b></span>
                                </div>
                            {% endfor %}
                        </div>
                    </details>
                {% else %}
                    <div class="pmx-zero"><span><b>{{ card.name }} grants nothing yet.</b> Somebody holding it can sign in and reach no page behind it</span></div>
                {% endfor %}
                <div class="pcard-foot"><span>{{ card.concernsGranted }} concern{{ card.concernsGranted == 1 ? '' : 's' }} &middot; {{ granted|length }} group{{ granted|length == 1 ? '' : 's' }}</span><span class="sp"></span><a class="ov-open" href="{{ path('team_position_show', {uuid: card.uuid}) }}">See it on the position {{ ux_icon('shell:chevron-right') }}</a></div>
            </div>
        {% endif %}

        {# A MODULE'S CARDS, LAST — whatever a module knows about this person,
           drawn whole through the record-cell seam; a provider with nothing
           to say answered null and is simply not here. #}
        {% for cell in recordCells %}{{ cell|raw }}{% endfor %}
    </div>

    <div class="col">
        {{ include('@Team/team/_stationed_at.html.twig', {stationedAt: stationedAt, postingDoor: postingDoor, stationPlate: stationPlate}) }}

        <div class="c">
            <span class="tab">History<span class="src">&middot; latest {{ history|length }} of {{ historyTotal }}</span></span>
            <a class="more" href="#">View all &rarr;</a>
            <div class="hlist">
                {% for event in history %}
                    <div class="hrow"><span class="w"><time datetime="{{ event.when|date('c') }}" data-localtime-format="daystamp">{{ event.when|date('j M Y · H:i') }}</time></span><span class="t">{{ event.title }}</span><span class="by">{{ event.note ?: '&mdash;'|raw }}</span></div>
                {% else %}
                    <div class="hrow"><span class="w">&mdash;</span><span class="t">Nothing dated yet</span><span class="by">&mdash;</span></div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{# THE RANK LINE — under the assigned position, the code over its name and
   the day it was given. A person holding no rank reads a dash. #}
{% macro rank_line(rankNow) %}
    <span class="pcol-k">Rank</span>
    <div class="psid-f"><span class="v">
        {%- if rankNow %}<b>{{ rankNow.rank.shortCode }}</b><span class="zfrag">{{ rankNow.rank.name }} &middot; since <time datetime="{{ rankNow.since|date('Y-m-d') }}" data-localtime-format="day">{{ rankNow.since|date('j M Y') }}</time></span>
        {%- else %}<b>&mdash;</b><span class="zfrag">no rank</span>{% endif -%}
    </span></div>
{% endmacro %}

{# THE RANK HISTORY — from · to · rank · by, inside the Position card, the
   rank held now first and lit. A promotion is a dated fact. #}
{% macro rank_history(ranks) %}
    <span class="pcol-k" style="margin-top:16px">Rank history</span>
    <div class="rkh">
        <div class="rkh-hd"><span>from</span><span>to</span><span>rank</span><span>by</span></div>
        {% for holding in ranks %}
            {% set by = holding.recordedBy %}
            <div class="rkh-row{{ holding.until is null ? ' now' }}">
                <span class="w"><time datetime="{{ holding.since|date('Y-m-d') }}" data-localtime-format="day">{{ holding.since|date('j M Y') }}</time></span>
                <span class="w to">{% if holding.until is null %}now{% else %}<time datetime="{{ holding.until|date('Y-m-d') }}" data-localtime-format="day">{{ holding.until|date('j M Y') }}</time>{% endif %}</span>
                <span class="r"><b>{{ holding.rank.shortCode }}</b><em>{{ holding.rank.name }}</em></span>
                <span class="by">{{ by ? (by.firstName|slice(0, 1) ~ '. ' ~ by.lastName) : '—' }}</span>
            </div>
        {% endfor %}
    </div>
{% endmacro %}
