{# PREVIEW: THE REGISTER — the working table, its columns operational
   rather than scientific and its search / filter / sort muscle kept. The columns are
   the area page's "modules live" and the modules' own now-tiles — the SAME figures the
   wall's cards show, in a denser frame — so the area page names none of them: the stat
   headers are whatever labels the now-tile contribution handed back. #}
{# THE PAGE HEAD IS THE PREVIEW'S. On the landing the page frame has already
   drawn it — with this layout's own subtitle, from the same partial — so the
   layout would be stating the title twice. #}
{% if not landing|default(false) %}
    <div class="pghead">
        <div>
            <h1 class="pg">Areas</h1>
            <p class="pgsub">{{ include('@Area/area/widgets/_subtitle.html.twig', {view: 'register'}) }}</p>
        </div>
        {% if door('areas.configure', whole_organization()) %}
            <div class="pgact"><a class="cta" href="{{ path('area_new') }}">{{ ux_icon('shell:plus') }} New area</a></div>
        {% endif %}
    </div>
{% endif %}

{% if rows is empty %}
    <div class="c"><p class="zeb">No areas yet &mdash; the register fills as areas are added.</p></div>
{% else %}
    <div data-controller="uhifadhi--area-bundle--area-register">
        <div class="reg-bar">
            <input class="fld" data-uhifadhi--area-bundle--area-register-target="search"
                   placeholder="Search areas&hellip;" aria-label="Search areas">
            <span class="subnav">
                <a class="on" href="#" data-action="uhifadhi--area-bundle--area-register#filter" data-filter="all">All &middot; <span data-uhifadhi--area-bundle--area-register-target="count">{{ counts.all }}</span></a>
                <a href="#" data-action="uhifadhi--area-bundle--area-register#filter" data-filter="live">Live &middot; {{ counts.live }}</a>
                <a href="#" data-action="uhifadhi--area-bundle--area-register#filter" data-filter="alerts">With alerts &middot; {{ counts.alerts }}</a>
                <a href="#" data-action="uhifadhi--area-bundle--area-register#filter" data-filter="setup">Awaiting setup &middot; {{ counts.setup }}</a>
            </span>
            <span class="reg-sort mono"><span class="chip acc" data-uhifadhi--area-bundle--area-register-target="sortlabel">sort: last activity &darr;</span></span>
        </div>

        <div class="c">
            <span class="tab">All areas<span class="src">&middot; register &mdash; operational columns</span></span>
            <table class="tbl ax-reg" data-uhifadhi--area-bundle--area-register-target="list">
                <tr>
                    <th class="sortable" data-action="uhifadhi--area-bundle--area-register#sort" data-sortcol="name" data-label="protected area">Protected area<span class="mono sarrow">&darr;</span></th>
                    <th class="sortable" data-action="uhifadhi--area-bundle--area-register#sort" data-sortcol="modules" data-label="modules" style="text-align:right">modules<span class="mono sarrow">&darr;</span></th>
                    {% for label in statColumns %}
                        <th class="sortable" data-action="uhifadhi--area-bundle--area-register#sort" data-sortcol="s{{ loop.index0 }}" data-label="{{ label }}" style="text-align:right">{{ label }}<span class="mono sarrow">&darr;</span></th>
                    {% endfor %}
                    <th class="sortable sorted" data-action="uhifadhi--area-bundle--area-register#sort" data-sortcol="activity" data-label="last activity">last activity<span class="mono sarrow">&darr;</span></th>
                    <th>alerts</th>
                    <th></th>
                </tr>
                {% for row in rows %}
                    {# ONE COLUMN, ONE LABEL. The headings come from the first
                       live area, and an area running fewer modules contributes
                       fewer figures — so a row fills the columns it can answer
                       for and says nothing in the rest. Read positionally, the
                       same row printed its numbers under somebody else's
                       heading, and under strict variables took the page down
                       asking for an index it does not have. #}
                    {% set figures = row.statsByLabel %}
                    <tr data-row data-href="{{ path('area_show', {uuid: row.area.uuidString}) }}"
                        data-name="{{ row.area.name|lower }}"
                        data-live="{{ row.isLive ? '1' : '0' }}"
                        data-alerts="{{ row.hasAlerts ? '1' : '0' }}"
                        data-modules="{{ row.liveModules }}"
                        data-activity="{{ row.activityRank }}"
                        {% for label in statColumns %}data-s{{ loop.index0 }}="{{ figures[label]|default('') }}" {% endfor %}>
                        <td>
                            <div class="reg-id">
                                <div class="thumb{{ row.thumbnail.hasBoundary ? '' : ' none' }}"{% if row.thumbnail.hasBoundary %} style="background-image:url('{{ row.thumbnail.imageUrl }}')"{% endif %}></div>
                                <div>
                                    <div class="reg-name"><a href="{{ path('area_show', {uuid: row.area.uuidString}) }}">{{ row.area.name }}</a></div>
                                    <div class="mono reg-meta">
                                        {%- if row.area.iucnCategory %}IUCN {{ row.area.iucnCategory }} &middot; {% endif -%}
                                        {%- if row.area.establishedYear %}est. {{ row.area.establishedYear }} &middot; {% endif -%}
                                        {{ row.areaKm2|number_format }} km&sup2;
                                    </div>
                                </div>
                            </div>
                        </td>
                        {% if row.isLive %}
                            <td class="num">{{ row.liveModules }}</td>
                            {% for label in statColumns %}
                                <td class="num">{% if figures[label] is defined %}{{ figures[label] }}{% else %}&mdash;{% endif %}</td>
                            {% endfor %}
                            {# "6 min ago" is a duration, not a wall-clock: it reads the same in every
                               zone, so it is NOT a `<time>` the frame would rewrite into an absolute
                               stamp — the exact instant rides in the title instead. An area nothing has
                               reported from yet has no instant at all and draws the dash. #}
                            <td class="mono ax-time">{% if row.lastActivity %}<span title="{{ row.lastActivity|date('c') }}">{{ row.lastActivityLabel }}</span>{% else %}&mdash;{% endif %}</td>
                            <td>{% if row.hasAlerts %}<span class="chip warn">{{ row.alertCount }} open</span>{% else %}<span class="chip ok">steady</span>{% endif %}</td>
                        {% else %}
                            <td class="num d">0</td>
                            {% for label in statColumns %}
                                <td class="num"><span class="mono ax-none">not active yet</span></td>
                            {% endfor %}
                            <td class="mono ax-time d">&mdash;</td>
                            <td><span class="chip idle">awaiting setup</span></td>
                        {% endif %}
                        <td class="reg-open"><a class="open-btn" href="{{ path('area_show', {uuid: row.area.uuidString}) }}">Open &rarr;</a></td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    </div>
{% endif %}
