{# PERFORMANCE · BRIEFING — what needs a decision, the goals, and what changed.

   PORTED from departments/performance/briefing.html: what needs a decision
   as the banner above the page, then the index and its two cards at full
   width, one column — the goals and what changed. No strip: strips and
   figures belong to the Overview (ruled 7 Nov).

   IT ADDS UP NOTHING OF ITS OWN. The decisions and the movements are each
   topic's own sentences, and the goals are the Goals topic's matrix in the
   one grammar every matrix is drawn in. A briefing that computed any of it
   would be a second answer to a question already answered on the page
   before it. #}
{% extends '@Team/performance/_frame.html.twig' %}
{% import '@Team/departments/_bits.html.twig' as di %}

{% block title %}Briefing · Performance{% endblock %}

{% block perf_crumb %}<a href="{{ path('team_performance') }}">performance</a> / briefing{% endblock %}

{% block perf_page %}
    {# WHAT NEEDS A DECISION — what is wrong and what is being asked, both in
       the topic's own words, against the department it belongs to. #}
    {{ di.attention('Needs a decision', decisions|map(row => {
        head: row.decision.what,
        cause: (row.decision.departmentName ? row.decision.departmentName ~ ' · ' : '') ~ row.decision.ask,
        door: 'Open',
        url: row.decision.url ?? row.url,
    })) }}

    {% embed '@Shell/_onpage.html.twig' with {rows: [
        {id: 'tp-ledger', label: 'Goals', count: ledger ? ledger.rows|length : null},
        {id: 'changed', label: 'What changed', count: moved|length},
    ]} %}
        {% block shell_onpage_main %}
            {% if ledger %}
                {{ render_matrix(ledger, {
                    title: 'Goals',
                    caption: 'grouped by scope; a department that declared nothing is a row that says so',
                    publisher: 'Built in',
                    openLabel: 'Open',
                    id: 'tp-ledger',
                }) }}
            {% else %}
                <section class="pfc" id="tp-ledger">
                    <div class="pfc-hd"><span class="t">Goals</span></div>
                    <div class="pfc-bd"><p class="perf-empty">This installation publishes no goals topic, so there are no goals to draw.</p></div>
                </section>
            {% endif %}

            <section class="pfc" id="changed">
                <div class="pfc-hd">
                    <span class="t">What changed</span>
                    <span class="s">&middot; {{ period.label }} against {{ previous.label }}</span>
                    <span class="sp"></span>
                    <span class="n">{{ moved|length }} {{ moved|length == 1 ? 'movement' : 'movements' }}</span>
                </div>
                <div class="pfc-bd">
                    {% if moved %}
                        <div class="mvlist">
                            {% for row in moved %}
                                {# THE SENTENCE IS THE TOPIC'S AND THE TONE IS THE
                                   PLATFORM'S — the same bargain a calendar pill and a
                                   state chip strike. #}
                                <a class="mvrow" href="{{ row.url }}">
                                    <span class="i {{ row.movement.tone.value }}"></span>
                                    <span class="l"><b>{{ row.topic }}</b>{{ row.movement.sentence }}</span>
                                    <span class="ov-open">Open {{ ux_icon('shell:chevron-right') }}</span>
                                </a>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="perf-empty">No topic has anything to report for this period, which is not the same as a period in which nothing happened.</p>
                    {% endif %}
                </div>
            </section>
        {% endblock %}
    {% endembed %}
{% endblock %}
