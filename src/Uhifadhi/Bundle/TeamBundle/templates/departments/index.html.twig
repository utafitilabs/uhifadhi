{# DEPARTMENTS — the register.

   PORTED from the canonical design DesignsProjects/uhifadhi-web/departments/
   index.html: the scope in the head, then ONE TABLE on the People-table idiom
   — four house dropdowns, a search, sortable headers, a two-line name cell
   and one fact per column. No strip: strips and figures belong to the
   section's Overview. A row carries one door, Open; a department is changed
   on its own configure page (rename, scope, deactivate — never delete), the
   shape a person and a position already have.

   WHAT THE DESIGN DRAWS THAT IS NOT HERE: the Widgets button in the header
   (the department's widget board), and the Period dropdown — with the strip
   gone nothing on this page reads a period. #}
{% extends '@Shell/page.html.twig' %}
{% import '@Team/positions/_bits.html.twig' as pm %}
{% import '@Team/departments/_bits.html.twig' as di %}

{% block title %}Departments{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('@Team/_stylesheets.html.twig') }}
{% endblock %}

{% block shell_breadcrumbs %}
    <a href="{{ path('team_index') }}">uhifadhi</a> / departments
{% endblock %}

{% block shell_page_title %}Departments{% endblock %}

{% block shell_page_subtitle %}Every department, created and scoped here.{% endblock %}

{% block shell_page_actions %}
    {# THE SCOPE, ON THE HOUSE DROPDOWN: the placement filter seen from the
       head, so the two cannot disagree — they are one parameter, and every
       option is an address. #}
    {%- set placementKey = constant('Uhifadhi\\Bundle\\TeamBundle\\Model\\DepartmentQuery::PLACEMENT') -%}
    {%- set scopeUrls = {'': path('team_departments', query.with(placementKey, null))} -%}
    {%- set scopeAreas = [] -%}
    {%- for area in areas -%}
        {%- set scopeUrls = scopeUrls|merge({(area.uuidString): path('team_departments', query.with(placementKey, area.uuidString))}) -%}
        {%- set scopeAreas = scopeAreas|merge([{value: area.uuidString, label: area.name}]) -%}
    {%- endfor -%}
    {{ include('@Team/_partial/_link_dropdown.html.twig', {
        sm: true,
        name: 'scope', label: 'Scope', icon: 'shell:map', end: true, default: '',
        value: (areas|filter(area => area.uuidString == query.placement)|length > 0) ? query.placement : '',
        groups: [
            {label: 'scope', options: [{value: '', label: 'Organization — all areas'}]},
            {label: 'Areas', options: scopeAreas},
        ],
        urls: scopeUrls,
    }, with_context = false) }}
{% endblock %}

{% block shell_page %}
    {{ include('@Team/team/_scope_banner.html.twig') }}
    <div data-dp>
        {# CREATING A DEPARTMENT LIVES ON THE SECTION'S CONFIGURE PAGE (owner
           2026-09-22: add is configuration, a register is presentation). #}
        {% set anyDepartments = departments|length > 0 %}

        {% if anyDepartments %}
            {# THE REGISTER IS ONE TABLE (ruled 2026-09-22, design departments/
               index.html): the People table's idiom — four grouped dropdowns,
               a search, what is shown — with a TWO-LINE NAME CELL (the
               department over its placement and kind) and ONE FACT PER
               COLUMN, so every header sorts exactly one thing. Every option
               and every header is a link: the address is the state. #}
            <div class="c">
            <span class="tab">Departments<span class="src">&middot; {{ total }} &middot; where people are placed, and what each reads</span></span>
            <div class="lfilt">
                {{ include('@Team/_partial/_filter_chip.html.twig', {
                    key: constant('Uhifadhi\\Bundle\\TeamBundle\\Model\\DepartmentQuery::PLACEMENT'),
                    name: 'placement', all: 'All placements', total: total,
                    chosen: query.placement, options: placementOptions, query: query,
                }) }}
                {{ include('@Team/_partial/_filter_chip.html.twig', {
                    key: constant('Uhifadhi\\Bundle\\TeamBundle\\Model\\DepartmentQuery::MODULE'),
                    name: 'module', all: 'Any module', total: total,
                    chosen: query.module, options: moduleOptions, query: query,
                }) }}
                {{ include('@Team/_partial/_filter_chip.html.twig', {
                    key: constant('Uhifadhi\\Bundle\\TeamBundle\\Model\\DepartmentQuery::GOALS'),
                    name: 'goals', all: 'Any goals', total: total,
                    chosen: query.goals, options: goalsOptions, query: query,
                }) }}
                {{ include('@Team/_partial/_filter_chip.html.twig', {
                    key: constant('Uhifadhi\\Bundle\\TeamBundle\\Model\\DepartmentQuery::SEATS'),
                    name: 'seats', all: 'Any seats', total: total,
                    chosen: query.seats, options: seatsOptions, query: query,
                }) }}
                <form class="lsearch" method="get" action="{{ path('team_departments') }}">
                    {% for field, value in query.with(constant('Uhifadhi\\Bundle\\TeamBundle\\Model\\DepartmentQuery::SEARCH'), null) %}
                        <input type="hidden" name="{{ field }}" value="{{ value }}">
                    {% endfor %}
                    {{ ux_icon('shell:search', {width: 14, height: 14}) }}
                    <input class="fld" type="search" name="{{ constant('Uhifadhi\\Bundle\\TeamBundle\\Model\\DepartmentQuery::SEARCH') }}"
                           value="{{ query.search }}" placeholder="Find a department&hellip;" aria-label="Find a department">
                </form>
            </div>

            {# THE FOLD (ruled 2026-09-22, option G): a chevron folds a row open
               to the positions its members hold, as cards, with the add tile;
               the open set rides in the address (`open=a,b`). The shell's
               `register-fold` controller owns the click, the shell sheet the
               motion — this template only draws the rows and the fold rows. #}
            <table class="tbl dreg" data-controller="uhifadhi--shell-bundle--register-fold">
                <thead><tr>
                    <th class="fchev-h"></th>
                    {% for column, label in columns %}
                        {% set sorted = query.sort == column %}
                        <th{{ sorted ? ' class="sorted"' }} aria-sort="{{ sorted ? (query.direction == 'desc' ? 'descending' : 'ascending') : 'none' }}">
                            <a href="{{ path('team_departments', query.sortedBy(column)) }}">{{ label }}</a>
                        </th>
                    {% endfor %}
                    <th></th>
                </tr></thead>
                <tbody>
                {% for row in rows %}
                    {% set show = path('team_department_show', {uuid: row.uuid}) %}
                    {% set open = query.isOpen(row.uuid) %}
                    <tr id="d-{{ row.uuid }}" class="drow{{ open ? ' open' : '' }}{{ row.active ? '' : ' dcinactive' }}{{ query.focus == row.uuid ? ' dcfocus' : '' }}"
                        data-department="{{ row.uuid }}" data-fold-id="{{ row.uuid }}" data-fold-name="{{ row.name }}"{% if row.category %} data-cat="{{ row.category }}"{% endif %}>
                        <td class="fchev-c"><a class="fchev" href="{{ path('team_departments', query.with('open', open ? null : row.uuid)) }}"
                               data-action="uhifadhi--shell-bundle--register-fold#toggle" aria-expanded="{{ open ? 'true' : 'false' }}"
                               aria-label="{{ open ? 'Collapse' : 'Expand' }} {{ row.name }}">&#9656;</a></td>
                        <td>
                            <div class="who">
                                <span class="dmark" aria-hidden="true"></span>
                                <div>
                                    <a class="ov-nm" href="{{ show }}">{{ row.name }}</a>
                                    {% if not row.active %}<span class="chip stoff">inactive</span>{% endif %}
                                    <div class="sub">{{ row.area ? row.area.name : 'org-wide' }}{% if row.kind %} &middot; {{ row.kind }}{% endif %}</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            {% for name in row.modules %}<span class="chip">{{ name }}</span>{% else %}<span class="mono d">none</span>{% endfor %}
                        </td>
                        <td class="num">{{ row.positions }}</td>
                        <td>
                            {% if row.seats is null %}
                                <span class="mono">{{ row.filled }}</span><span class="mono d"> / unlimited</span>
                            {% else %}
                                <span class="mono">{{ row.filled }}</span><span class="mono d"> / {{ row.seats }}</span>
                                {% if row.vacant %} <span class="chip warn">{{ row.vacant }} vacant</span>{% endif %}
                            {% endif %}
                        </td>
                        <td><span class="mono d">{{ row.goals ? row.goals ~ (row.goals == 1 ? ' goal' : ' goals') : 'no goal set' }}</span></td>
                        <td class="act"><a class="open-btn" href="{{ show }}">Open</a></td>
                    </tr>
                    <tr class="foldrow{{ open ? ' open' : '' }}"><td colspan="7"><div class="foldbox"><div class="fold-in">
                        <div class="poscards">
                            {% for position in row.positionRows %}
                                <a class="poscard" href="{{ path('team_position_show', {uuid: position.uuid}) }}">
                                    <b>{{ position.name }}</b>
                                    <div class="poscardfoot"><span class="k">
                                        {%- if position.seats is null %}{{ position.filled }} holding &middot; unlimited seats
                                        {%- else %}{{ position.filled }} of {{ position.seats }} seat{{ position.seats == 1 ? '' : 's' }}{% endif -%}
                                    </span></div>
                                </a>
                            {% else %}
                                <div class="zdnone"><b>No position filed under {{ row.name }}</b><span>a department holds nobody directly &mdash; it holds the positions people fill</span></div>
                            {% endfor %}
                            <a class="poscard add" href="{{ path('team_positions') }}#add"><span class="t">{{ ux_icon('shell:plus') }} Add a position</span></a>
                        </div>
                    </div></div></td></tr>
                {% else %}
                    <tr class="dempty"><td colspan="7">
                        <b>No department matches</b>
                        <span>{{ query.isFiltered ? 'clear the search, or widen a filter' : 'file one with the form above' }}</span>
                    </td></tr>
                {% endfor %}
                {# LISTED, NOT YOURS (#74): a department that lets everybody know it
                   exists, and its people, figures and records are its own. #}
                {% for department in outside %}
                    <tr class="drow dcoutside" data-outside="{{ department.uuidString }}">
                        <td class="fchev-c"></td>
                        <td><div class="who"><span class="dmark" aria-hidden="true"></span><div>
                            <b>{{ department.name }}</b>
                            <div class="sub">{{ department.area ? department.area.name : 'org-wide' }}</div>
                        </div></div></td>
                        <td colspan="4"><span class="mono d">listed &middot; its people and figures are its own</span></td>
                        <td class="act"><span class="mono d">not yours to open</span></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            {% include '@Shell/_foot.html.twig' with {
                count: table.total, noun: 'departments', one: 'department',
                perPage: table.size, page: table.page, pages: table.pages, links: links,
            } only %}
            </div>
        {% else %}
            <div class="pm-first">
                {{ pm.icon_plus() }}
                <div class="ft">
                    <h3>There are no departments yet, and the field above is what makes the first one.</h3>
                    <p>Until one exists, every position on this installation belongs to nobody in particular: the
                    roster&rsquo;s org chart bands them all as <b>Unassigned</b>. A department is an organizational
                    fact, so an installation that has not decided on one yet is simply an installation that has not
                    decided. Three or four is usually the whole list.</p>
                </div>
            </div>
        {% endif %}

    </div>
{% endblock %}
