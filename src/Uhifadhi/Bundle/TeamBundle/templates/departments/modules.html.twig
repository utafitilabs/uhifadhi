{# DEPARTMENTS · MODULES — one row a department, one column a module.

   THE MATRIX READS, IT DOES NOT WRITE. Attaching a module is done on the
   department's own card in the register; a grid of checkboxes would be a
   second write path for one fact, and the two would disagree the first time
   one of them was changed without the other.

   ABSENCE IS DRAWN. A cell a reader cannot tell apart from a rendering failure
   is not an answer, so a department that does not read a module gets a dashed
   ring and a title that says so in words. #}
{% extends '@Shell/page.html.twig' %}
{% import '@Team/departments/_bits.html.twig' as di %}
{% import '@Team/_partial/_table.html.twig' as tb %}

{% block title %}Departments{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('@Team/_stylesheets.html.twig') }}
{% endblock %}

{% block shell_breadcrumbs %}
    <a href="{{ path('team_departments_overview') }}">uhifadhi</a> / departments / modules
{% endblock %}

{% block shell_page_title %}Departments{% endblock %}
{% block shell_page_subtitle %}Which department reads which module.{% endblock %}

{% block shell_page %}
    <div data-dp>
        {# WHAT NEEDS ATTENTION, IN THE BANNER ABOVE THE MATRIX: the installed
           modules no department attaches, and the departments attaching none. #}
        {%- set attention = [] -%}
        {%- for module in unread -%}
            {%- set attention = attention|merge([{head: (module.name ?? module.slug) ~ ' is attached by no department', cause: 'installed, and nothing it holds counts in a department’s figures'}]) -%}
        {%- endfor -%}
        {%- if readsNothing is not empty -%}
            {%- set attention = attention|merge([{
                head: readsNothing|length ~ (readsNothing|length == 1 ? ' department reads' : ' departments read') ~ ' no module',
                cause: readsNothing|map(d => d.name)|join(', ') ~ ' — ' ~ (readsNothing|length == 1 ? 'it does not appear' : 'none of them appears') ~ ' on Performance',
                door: 'The register', url: path('team_departments'),
            }]) -%}
        {%- endif %}
        {{ di.attention('Needs attention', attention) }}

        {% set scopes = rows|reduce((carry, row) => carry|merge({(row.scope): (carry[row.scope] ?? 0) + 1}), {}) %}
        {% set scopeOptions = [{value: '', label: 'All', count: rows|length}] %}
        {% for scope, count in scopes %}{% set scopeOptions = scopeOptions|merge([{value: scope|lower|replace({' ': '-'}), label: scope, count: count}]) %}{% endfor %}
        <div class="c" {{ tb.wrap('departments', 'department') }}>
            <span class="tab">Which department reads which module<span class="src">&middot; {{ rows|length }} &times; {{ modules|length }}</span></span>
            {{ atlas_key(key) }}
            <div class="lfilt">{{ tb.chip('scope', scopeOptions) }}{{ tb.search('Find a department') }}</div>
            <table class="tbl sxmx">
                <thead>
                <tr>
                    <th>Department</th>
                    <th>Scope</th>
                    {% for module in modules %}<th>{{ module.name ?? module.slug }}</th>{% endfor %}
                    <th class="num">Attached</th>
                </tr>
                </thead>
                <tbody>
                {% for row in rows %}
                    <tr {{ tb.row({scope: row.scope|lower|replace({' ': '-'})}, row.department.name) }}>
                        <td><b><a href="{{ path('team_department_show', {uuid: row.department.uuidString}) }}">{{ row.department.name }}</a></b></td>
                        <td><span class="mono d">{{ row.scope }}</span></td>
                        {% for cell in row.cells %}
                            <td><span class="sxdot{{ cell.reads ? '' : ' no' }}" title="{{ row.department.name }} {{ cell.reads ? 'reads' : 'does not read' }} {{ cell.module.name ?? cell.module.slug }}"></span></td>
                        {% endfor %}
                        <td class="num">{% if row.attached > 0 %}<b>{{ row.attached }}</b>{% else %}<span class="d">0</span>{% endif %}</td>
                    </tr>
                {% else %}
                    <tr><td colspan="{{ 3 + modules|length }}"><span class="d">No department yet.</span></td></tr>
                {% endfor %}
                {% if rows|length > 0 %}
                    <tr class="sxgrp">
                        <td colspan="2"><span class="mono d">Departments reading it</span></td>
                        {% for module in modules %}<td class="num"><b>{{ perModule[module.slug] }}</b></td>{% endfor %}
                        <td class="num"><b>{{ attachments }}</b></td>
                    </tr>
                {% endif %}
                </tbody>
            </table>
            {{ tb.none('No department matches these filters.') }}
            {{ tb.foot(rows|length, 'departments', 'department') }}
            <div class="sxfoot"><span>Attaching a module is done on the department&rsquo;s own card in the register &mdash; this matrix reads, it does not write.</span><span class="sp"></span><a class="tgl" href="{{ path('team_departments') }}">The register</a></div>
        </div>

    </div>
{% endblock %}
