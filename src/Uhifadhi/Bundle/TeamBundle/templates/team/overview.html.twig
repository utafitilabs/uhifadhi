{# TEAM · OVERVIEW — the section's first tab.

   WHO IS ON THIS INSTALLATION, WHAT EACH OF THEM MAY DO, AND WHERE THEY ARE
   STATIONED. Every figure here is owned somewhere else — by the register, by
   Positions, by the station in the area — and this page reads them and writes
   none of them, which is why it carries no control that changes anybody.

   THE HEADER IS THE SECTION'S, NOT THIS TAB'S. The title is "Team" on every
   tab and the strip says which one you are on; the subtitle is this tab's one
   line. Both sockets belong to the shell's frame, and the strip and the
   Configure action are written by it. #}
{% extends '@Shell/page.html.twig' %}
{% import '@Team/departments/_bits.html.twig' as di %}

{% block title %}Team · Overview{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('@Team/_stylesheets.html.twig') }}
{% endblock %}

{% block shell_breadcrumbs %}
    <a href="{{ path('team_index') }}">uhifadhi</a> / team / overview
{% endblock %}

{% block shell_page_title %}Team{% endblock %}
{% block shell_page_subtitle %}Who is on this installation, what each of them may do, and where they are stationed.{% endblock %}

{% block shell_page_actions %}
    <a class="cta" href="{{ path('team_invite') }}">{{ ux_icon('shell:plus', {width: 15, height: 15}) }} Add somebody</a>
{% endblock %}

{% block shell_page %}
    {# THE IDENTITY BAND — the facts this section is, stated as fragments. #}
    <div class="factband">
        {% for fact in facts %}
            <span class="f"><span class="k">{{ fact.label }}</span><span class="v">{{ fact.value }}{% if fact.qualifier %}<em>{{ fact.qualifier }}</em>{% endif %}</span></span>
        {% endfor %}
        <span class="sp"></span>
        <a class="more" href="{{ path('team_configure_people') }}">Team settings &rarr;</a>
    </div>

    {# FOUR KPI CARDS, FOUR OR NONE — a strip is four to a row (ruled), and a
       fifth wrapped an orphan onto a second line on a small laptop. A card's
       movement is read from the period history — the figure written down while
       the last closed period was still true — and a period nobody wrote gets no
       pill at all.

       THE FIGURE ROW: `grid dp-kstrip` in team/overview.html, whose
       `.dp-kstrip` is the shell's `.kstrip`, keeping the rhythm every other
       row on the page keeps (a flush row that touched the cards below it was
       a slip of the design, corrected 2026-09-25); team.css reads the
       qualifier as a sentence. #}
    <div class="grid kstrip" data-kpi>
        {% for kpi in kpis %}
            <div class="c kpi{{ kpi.hot ? ' hot' }}">
                <span class="tab">{{ kpi.label }}</span>
                <b class="disp">{{ kpi.value }}{% if kpi.of %}<em>{{ kpi.of }}</em>{% endif %}</b>
                <span class="sub">{{ kpi.qualifier }}{% if kpi.delta is not null %} {{ di.delta(kpi.delta, kpi.tone()) }}{% endif %}</span>
            </div>
        {% endfor %}
    </div>

    <div class="grid g2">
        <div class="c">
            <span class="tab">People by department<span class="src">&middot; {{ people }} &middot; one position each</span></span>
            {{ atlas_bars(byDepartment) }}
            <div class="sxmore"><span>{{ byDepartment.bars|length }} of {{ byDepartment.bars|length }} groups &middot; nothing hidden</span><span class="sp"></span><a href="{{ path('team_index') }}">The people &rarr;</a></div>
        </div>

        <div class="c">
            <span class="tab">Positions held and unheld<span class="src">&middot; {{ positions }} &middot; by department</span></span>
            {{ atlas_bars(seats) }}
            {# A POSITION WITH NO HOLDER IS A PERMISSION SET SITTING READY, not
               an error. #}
            <div class="sxmore"><span>{{ seats.bars|length }} of {{ seats.bars|length }} departments</span><span class="sp"></span><a href="{{ path('team_positions') }}">Positions &amp; permissions &rarr;</a></div>
        </div>
    </div>

    <div class="grid g2">
        <div class="c">
            <span class="tab">Assignments by area<span class="src">&middot; {{ postings }} &middot; made in the area, read here</span></span>
            {# A POSTING IS THE AREA'S, NOT TEAM'S: made on a station, read here
               across every area at once. An area whose stations nobody is
               stationed at keeps its column — the nought is the reading. #}
            {% if postingsChart %}
                {{ atlas_chart(postingsChart, '', '', {'--chart-height': '114px', 'role': 'img', 'aria-label': 'Assignments by area'}) }}
            {% else %}
                <p class="use">No area has a station yet.</p>
            {% endif %}
        </div>

        <div class="c">
            <span class="tab">Stations with nobody stationed<span class="src">&middot; {{ emptyStationsTotal }} of {{ stations }} &middot; needs attention</span></span>
            {# A STATION WITH NOBODY STATIONED IS A NORMAL STATE, not an error: it
               is drawn so the figure above can be read without opening the
               area. #}
            {% for line in emptyStations %}
                <div class="rln"><span>{{ line.label }}</span><span class="mono d">{{ line.note }}</span></div>
            {% else %}
                <div class="rln"><span class="d">Somebody is stationed at every station.</span></div>
            {% endfor %}
            <div class="sxmore"><span>{{ emptyStations|length }} of {{ emptyStationsTotal }} shown</span><span class="sp"></span><a href="{{ path('team_assignments') }}?posted=no">Postings &rarr;</a></div>
        </div>
    </div>

    <div class="grid g2">
        <div class="c">
            <span class="tab">Holds nothing<span class="src">&middot; {{ holdsNothingTotal }} &middot; needs attention</span></span>
            {# STAFF HOLD EXACTLY WHAT THEIR POSITION GRANTS, so no position
               denies every capability: they reach the sign-in screen and no
               page behind it. #}
            {% for line in holdsNothing %}
                <div class="rln"><span><a href="{{ path('team_member', {uuid: line.uuid}) }}">{{ line.label }}</a></span><span class="mono d">{{ line.note }}</span></div>
            {% else %}
                <div class="rln"><span class="d">Everybody holds a position.</span></div>
            {% endfor %}
            <div class="sxfoot">
                <span>{{ holdsNothing|length }} of {{ people }} people</span>
                <span class="sp"></span>
                <a class="tgl" href="{{ path('team_positions') }}">Give them a position</a>
            </div>
        </div>

        <div class="c">
            <span class="tab">Never signed in<span class="src">&middot; {{ neverSignedInTotal }} &middot; needs attention</span></span>
            {# TWO KINDS OF NEVER-SIGNED-IN ACCOUNT wanting two different things
               done: an invitation to chase, and a deactivated account with
               nothing outstanding. Each row states which. #}
            {% for line in neverSignedIn %}
                <div class="rln"><span><a href="{{ path('team_member', {uuid: line.uuid}) }}">{{ line.label }}</a></span><span class="mono {{ line.tone }}">{{ line.note }}</span></div>
            {% else %}
                <div class="rln"><span class="d">Everybody has signed in at least once.</span></div>
            {% endfor %}
            <div class="sxmore"><span>{{ neverSignedIn|length }} of {{ neverSignedInTotal }}</span><span class="sp"></span><a href="{{ path('team_index') }}">The people &rarr;</a></div>
        </div>
    </div>

    <h2 class="zone">Where this goes on</h2>
    <div class="sxdoors">
        <a class="sxdoor" href="{{ path('team_index') }}"><b>People<span class="ar">&rarr;</span></b><span>The {{ people }} accounts, their tier, their position and the state of each account.</span></a>
        <a class="sxdoor" href="{{ path('team_positions') }}"><b>Positions &amp; permissions<span class="ar">&rarr;</span></b><span>The positions and the matrix that decides what each of them may do.</span></a>
        <a class="sxdoor" href="{{ path('team_assignments') }}"><b>Assignments<span class="ar">&rarr;</span></b><span>Who is stationed where, across every area &mdash; read-only, made in the area.</span></a>
        <a class="sxdoor" href="{{ path('team_departments') }}"><b>Departments<span class="ar">&rarr;</span></b><span>The {{ departments }} departments a position belongs to, and what each of them reads.</span></a>
    </div>
{% endblock %}
