{# THE STATIONS HUB · OVERVIEW — the set of an area's stations, stated.

   Design: areas/<area>/stations/index.html.

   The banner names the stations nobody is posted to and opens them in the
   register; the strip and the four figures belong here and nowhere else in
   the hub; the plate draws every station on the ground; the two plots rank
   the stations by people posted and the zones by stations. It lists nothing:
   the register and the postings are the hub's other two pages. #}
{% extends '@Shell/page.html.twig' %}

{% block title %}{{ area.name }} · stations{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('@Area/_stylesheets.html.twig') }}
{% endblock %}

{% block shell_breadcrumbs %}
    <a href="{{ path('area_index') }}">uhifadhi</a> / <a href="{{ path('area_index') }}">areas</a> / <a href="{{ path('area_show', {uuid: area.uuidString}) }}">{{ area.name|lower }}</a> / stations
{% endblock %}

{% block shell_page_title %}Stations{% endblock %}

{% block shell_page_subtitle %}Every station in {{ area.name }}, where it stands and who is posted to it.{% endblock %}

{% block shell_page_tabs %}{{ include('@Area/station/_hub_tabs.html.twig') }}{% endblock %}

{% block shell_page %}
{% set o = overview %}
{% set list = path('area_stations_list', {uuid: area.uuidString}) %}

{% if o.stations == 0 %}
    <div class="grid">
        <div class="c zempty">
            <b class="zeh">No station in this area yet</b>
            <p class="zeb">A station is a named point &mdash; a gate, a post, a camp. The first one is added in Configure; its zone is read from wherever it is put.</p>
            <span class="zea"><a class="btn sm" href="{{ path('area_stations_configure', {uuid: area.uuidString}) }}">Configure stations {{ ux_icon('shell:arrow-right') }}</a></span>
        </div>
    </div>
{% else %}
    {% set n = o.unposted|length %}
    {{ include('@Shell/_banner.html.twig', {
        title: n > 0 ? n ~ (n == 1 ? ' station has' : ' stations have') ~ ' nobody posted' : null,
        text: o.unposted|join(', '),
        actions: {'Stations': list ~ '?posted=no'},
    }, with_context: false) }}

    <div class="factband ov-band">
        <span class="f"><span class="k">Stations</span><span class="v">{{ o.stations }}<em>{{ o.staffed }} posted</em></span></span>
        <span class="f"><span class="k">Zones</span><span class="v">
            {%- if o.zones > 0 -%}{{ o.zonesWithAStation }}<em>of {{ o.zones }} {{ o.zonesWithAStation == 1 ? 'has' : 'have' }} a station</em>{%- else -%}&mdash;<em>none yet</em>{%- endif -%}
        </span></span>
        <span class="f"><span class="k">Unzoned</span><span class="v">{{ o.unzoned }}<em>{{ o.unzoned == 1 ? 'station' : 'stations' }} in no zone</em></span></span>
        <span class="f"><span class="k">Departments</span><span class="v">
            {%- if o.departments is not empty -%}{{ o.departments|length }}<em>{{ o.departments|length <= 2 ? o.departments|join(' · ') : o.departments|slice(0, 2)|join(' · ') ~ ' and ' ~ (o.departments|length - 2) ~ ' more' }}</em>{%- else -%}&mdash;<em>nobody posted</em>{%- endif -%}
        </span></span>
        <span class="f"><span class="k">Period</span><span class="v">{{ o.month }}<em>{{ o.year }}</em></span></span>
        <span class="sp"></span>
    </div>

    {# FOUR FIGURES. Two are the area's own and two are what the modules
       publish by station; a figure no installed module publishes reads a
       dash and the card stays. #}
    <div class="grid kstrip ov-kpis">
        <div class="c kpi">
            <span class="tab">People posted</span>
            <b class="disp">{{ o.people }}</b>
            <span class="sub">{{ o.departments|length == 1 ? o.departments|first|lower : 'across ' ~ o.staffed ~ (o.staffed == 1 ? ' station' : ' stations') }}</span>
        </div>
        <div class="c kpi">
            <span class="tab">Leaders appointed</span>
            <b class="disp">{{ o.leaders }}</b>
            <span class="sub">one per staffed station</span>
        </div>
        {% for module in o.modules %}
            <div class="c kpi">
                <span class="tab">{{ module.label }}</span>
                <b class="disp">{{ module.value|number_format }}</b>
                <span class="sub">from {{ o.stations }} {{ o.stations == 1 ? 'station' : 'stations' }} &middot; {{ module.caption|lower }}</span>
            </div>
        {% endfor %}
        {% if o.modules|length < moduleCards %}
            {% for _ in 1..(moduleCards - o.modules|length) %}
                <div class="c kpi">
                    <span class="tab">From the modules</span>
                    <b class="disp">&mdash;</b>
                    <span class="sub">no module publishes figures for these stations</span>
                </div>
            {% endfor %}
        {% endif %}
    </div>

    <div class="grid">
        <div class="c" id="ground">
            <span class="tab">All stations on the ground<span class="src">&middot; the whole area &middot; {{ o.stations }} {{ o.stations == 1 ? 'station' : 'stations' }} &middot; {{ o.zones }} {{ o.zones == 1 ? 'zone' : 'zones' }}</span></span>
            {{ render_map(map, {
                'role': 'img',
                'aria-label': 'Every station of ' ~ area.name ~ ', hued by the zone it stands in',
            }) }}
        </div>
    </div>

    <div class="grid g2 ov-plots">
        <div class="c">
            <span class="tab">Stationed by station<span class="src">&middot; {{ o.people }} &middot; {{ o.stations }} {{ o.stations == 1 ? 'station' : 'stations' }}</span></span>
            {{ atlas_bars(o.byStation) }}
            <div class="sxmore"><span>{{ o.stationsShown }} of {{ o.stations }} stations &middot; {{ o.stationsShown == o.stations ? 'nothing hidden' : (o.stations - o.stationsShown) ~ ' more in the register' }}</span><span class="sp"></span><a href="{{ list }}">The stations &rarr;</a></div>
        </div>
        <div class="c">
            <span class="tab">Stations by zone<span class="src">&middot; {{ o.stations }} &middot; {{ o.zones }} {{ o.zones == 1 ? 'zone' : 'zones' }}</span></span>
            {{ atlas_bars(o.byZone) }}
            <div class="sxmore"><span>{{ o.zones }} {{ o.zones == 1 ? 'zone' : 'zones' }}{{ o.unzoned > 0 ? ' and no zone' }} &middot; nothing hidden</span><span class="sp"></span><a href="{{ path('area_zones', {uuid: area.uuidString}) }}">The zones &rarr;</a></div>
        </div>
    </div>
{% endif %}
{% endblock %}
