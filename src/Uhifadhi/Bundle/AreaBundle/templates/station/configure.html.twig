{# THE STATIONS SECTION OF AN AREA'S CONFIGURE PAGE — a station is added, moved,
   renamed and staffed here, and nowhere else.

   Design: areas/<area>/configure-stations.html.

   IT ONLY CONFIGURES. Reading a station is the station page's job and reading
   the ground is the Zones tab's; nothing here draws duty, patrols, incidents
   or any figure a module publishes, and there is no KPI row — a configuration
   section has none worth carrying, and the headings state the counts.

   ONE CARD, ONE FLAT LIST, AND THE ZONE IS A FILTER. Grouping by zone would
   make the zone the only way in; a name or a code is how an operator arrives.

   NO PAGE-LEVEL SAVE. A name, a point, the description, the activity and each
   assignment commit from their own control, so nothing is saved that nobody
   touched and a refusal is about one thing. #}
{% extends '@Shell/page.html.twig' %}

{% block title %}{{ area.name }} · configure · stations{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('@Area/_stylesheets.html.twig') }}
{% endblock %}

{% block shell_breadcrumbs %}
    <a href="{{ path('area_index') }}">uhifadhi</a> / <a href="{{ path('area_show', {uuid: area.uuidString}) }}">{{ area.name }}</a> / configure / stations
{% endblock %}

{% block shell_page_title %}{{ area.name }} &middot; configure{% endblock %}

{% block shell_page_subtitle %}A station is added, moved, renamed and staffed here &mdash; its own page is where it is read.{% endblock %}

{% block shell_page_actions %}
    <a class="cta" href="{{ path('area_stations', {uuid: area.uuidString}) }}">Open the stations tab {{ ux_icon('shell:arrow-right') }}</a>
{% endblock %}

{% block shell_page %}
{% set section = path('area_stations_configure', {uuid: area.uuidString}) %}
{% set openUuid = open ? open.uuidString : null %}

<div class="recgrid">
    <div class="col">
        {# WHAT THE LAST WRITE LEFT TO READ — one sentence, and it does not
           survive a second request. #}
        {% if refusal %}
            <div class="c stnotice bad">
                <span class="tab">Not written<span class="src">&middot; {{ refusal.subject }}</span></span>
                <p class="zeb">{{ refusal.why }}</p>
            </div>
        {% elseif outcome %}
            <div class="c stnotice">
                <span class="tab">Written<span class="src">&middot; just now</span></span>
                <p class="zeb">{{ outcome }}</p>
            </div>
        {% endif %}

        {# THE PLATE IS NOT A READING MAP. Nothing on it is hued by a figure,
           sized by a count or ringed: it draws the boundary, the zones as
           context and every station as a plain mark, so that a new point can be
           put somewhere on purpose and not on top of a station that exists.

           PICKING ON THE PLATE IS THE ATLAS'S. The plate service states
           that a click writes into the add form (AreaPlateService::picker());
           the plate draws the pin, the caption under the legend in its three
           states and the pin's key row, and each control below that wears
           `data-atlas-pick` arms it for its own form. The typed pair in each
           form is still what submits. #}
        <div class="c">
            <span class="tab">The point picker<span class="src">&middot; click the ground to place a point</span></span>
            {{ render_map(map, {
                '--map-plate-height': '420px',
                'aria-label': 'The area, its zones and its stations',
            }) }}
        </div>

        <div class="c">
            <span class="tab">The stations<span class="src">&middot;
                {%- if register.total == register.scope %} {{ register.scope }} {{ register.scope == 1 ? 'station' : 'stations' }}
                {%- else %} {{ register.total }} of {{ register.scope }} {{ register.scope == 1 ? 'station' : 'stations' }}{% endif -%}
                {%- if query.active != constant('Uhifadhi\\Bundle\\AreaBundle\\Model\\StationQuery::YES') and register.inactive %} &middot; {{ register.inactive }} inactive{% endif -%}
            </span></span>

            {# THE HOUSE GROUPED-DROPDOWN ROW, every option a link: the address
               is the state, so a filtered register can be sent to somebody. #}
            <div class="lfilt stfilt">
                {{ include('@Area/_partial/_filter.html.twig', {
                    label: 'zone', all: 'zone', key: constant('Uhifadhi\\Bundle\\AreaBundle\\Model\\StationQuery::ZONE'),
                    chosen: query.zone, chosenLabel: register.zoneLabel(query.zone), options: register.zones, query: query,
                }) }}
                {# "ALL" IS A STATE THE CHIP HAS TO BE ABLE TO SAY. A link naming
                   a closed station widens the resting filter (see
                   StationConfigureController), and a chip that still read
                   "active" over a register holding a closed row would be a page
                   disagreeing with its own controls. #}
                {{ include('@Area/_partial/_filter.html.twig', {
                    label: 'active', all: 'active', key: constant('Uhifadhi\\Bundle\\AreaBundle\\Model\\StationQuery::ACTIVE'),
                    chosen: query.active,
                    chosenLabel: query.active is null ? 'all' : (query.active == 'yes' ? 'active' : 'inactive'),
                    options: register.activity, query: query,
                }) }}
                {{ include('@Area/_partial/_filter.html.twig', {
                    label: 'posted', all: 'posted', key: constant('Uhifadhi\\Bundle\\AreaBundle\\Model\\StationQuery::POSTED'),
                    chosen: query.posted, chosenLabel: query.posted == 'yes' ? 'somebody posted' : (query.posted == 'no' ? 'nobody posted' : null), options: register.posted, query: query,
                }) }}
                {{ include('@Area/_partial/_filter.html.twig', {
                    label: 'order', all: 'order', key: constant('Uhifadhi\\Bundle\\AreaBundle\\Model\\StationQuery::SORT'),
                    chosen: query.sort == 'name' ? null : query.sort,
                    options: [
                        {value: 'posted', label: 'most stationed', count: 0, cat: null},
                        {value: 'zone', label: 'by zone', count: 0, cat: null},
                    ],
                    query: query,
                }) }}

                <form class="lsearch" method="get" action="{{ section }}">
                    {{ ux_icon('shell:search') }}
                    <input class="fld" type="search" name="q" value="{{ query.search }}" placeholder="Name or code&hellip;"
                           aria-label="Search the stations by name or code">
                    {% for k, v in query.with('q', null) %}<input type="hidden" name="{{ k }}" value="{{ v }}">{% endfor %}
                </form>
            </div>

            {% if register.isEmpty %}
                <div class="zempty">
                    <b class="zeh">{{ query.isFiltered ? 'No station matches' : 'No station in this area yet' }}</b>
                    <p class="zeb">{% if query.isFiltered %}Nothing in this area answers these filters. Clear one, or search another name or code.{% else %}A station is a named point &mdash; a gate, a station, a camp. Add the first one beside this list; its zone is read from wherever you put it.{% endif %}</p>
                    <span class="zea"><a class="btn sm" href="{{ query.isFiltered ? section : section ~ '#add' }}">{{ query.isFiltered ? 'Clear the filters' : 'Add the first station' }}</a></span>
                </div>
            {% else %}
                <div class="zcstack">
                    {% for row in register.rows %}
                        {% set isOpen = openUuid == row.uuid %}
                        {# A NATIVE DISCLOSURE, so opening a card costs nothing.
                           The card used to open by NAVIGATING — `?open=<uuid>`,
                           a round trip and a repaint to reveal markup the page
                           could have carried — and the reload is what the owner
                           noticed. `<details>` opens it in the browser, with no
                           script to ship and keyboard and screen-reader support
                           already right.

                           THE SERVER STILL DECIDES WHAT ARRIVES OPEN. `?open=`
                           renders the `open` attribute on the card it names, so
                           every deep link into a station — the record's "Edit
                           the station", the empty state's "Station somebody", a
                           redirect after a form stations — still lands with the
                           card already showing. The query is now a starting
                           state rather than the only way to change one.

                           THE CARET IS INERT MARKUP NOW. The summary is the
                           control, so the chevron is drawn and not clicked;
                           `.zcard[open]` turns it, where `[aria-expanded]` used
                           to. #}
                        <details class="zcard{{ isOpen ? ' on focusline' : '' }}{{ row.active ? '' : ' stinactive' }}"{{ isOpen ? ' open' : '' }}>
                            <summary class="zc-hd">
                                <span class="ovx" aria-hidden="true">{{ ux_icon('shell:chevron-right') }}</span>
                                <div class="zc-bd">
                                    <span class="nmrow">
                                        <a class="zc-nm" href="{{ path('area_station_show', {uuid: area.uuidString, station: row.uuid}) }}">{{ row.name }}</a>
                                        {% if row.code %}<span class="stcode">{{ row.code }}</span>{% endif %}
                                        {% if not row.active %}<span class="chip stoff">closed</span>{% endif %}
                                    </span>
                                </div>
                                {# COLLAPSED: the name, the code, the derived zone and a plain
                                   count. No avatars and no "who leads" — those are the station
                                   page's, and a row that carried them would be a second, worse
                                   version of a page that already exists. #}
                                <span class="zcrun">
                                    <span class="stzone{{ row.zoneName ? '' : ' none' }}">
                                        <i class="zsw"{% if row.zoneCat %} data-cat="{{ row.zoneCat }}"{% endif %}></i>{{ row.zoneName ?? 'unzoned' }}
                                    </span>
                                    {# THE CLOSED SUMMARY SAYS WHAT IS INSIDE, and everything
                                       that changes a station — its name, its zone, and assignment
                                       somebody at it — is inside. A row whose only marking was
                                       a chevron read as decoration: the owner looked for where
                                       a assignment is made and did not find it. The whole summary
                                       is the door, so the fragment is a label on it rather than
                                       a second control beside one. #}
                                    <span class="stcount">{{ row.posted }} stationed{% if not isOpen %} &middot; station somebody inside{% endif %}</span>
                                </span>
                            </summary>

                            <hr class="zc-rule">

                                <form class="zfrow" method="post" action="{{ path('area_station_rename', {uuid: area.uuidString, station: row.uuid}) }}">
                                    <input type="hidden" name="_token" value="{{ editToken }}">
                                    <label class="fldlab" for="nm-{{ row.uuid }}">Name</label>
                                    <input class="fld" id="nm-{{ row.uuid }}" name="name" value="{{ row.name }}" maxlength="128">
                                    <button type="submit" class="btn sm">{{ ux_icon('shell:square-pen') }} Save the name</button>
                                </form>

                                <div class="zfrow">
                                    <span class="fldlab">Code</span>
                                    <span class="stcode">{{ row.code ?? '&mdash;'|raw }}</span>
                                    <span class="zfnote">issued once, never changes</span>
                                </div>

                                <form class="zfrow" id="move-{{ row.uuid }}" method="post" action="{{ path('area_station_move', {uuid: area.uuidString, station: row.uuid}) }}">
                                    <input type="hidden" name="_token" value="{{ editToken }}">
                                    <label class="fldlab" for="lat-{{ row.uuid }}">Point</label>
                                    <span class="stpt">
                                        <input class="fld" id="lat-{{ row.uuid }}" name="lat" value="{{ row.point ? row.point.latitude : '' }}" aria-label="Latitude" inputmode="decimal">
                                        <span class="sep">,</span>
                                        <input class="fld" name="lon" value="{{ row.point ? row.point.longitude : '' }}" aria-label="Longitude" inputmode="decimal">
                                    </span>
                                    {# THE PLATE, ARMED FOR THIS STATION. The typed pair is still the
                                       one that submits; this only says where to put the pin. #}
                                    <button type="button" class="btn sm"
                                            data-atlas-pick="move-{{ row.uuid }}"
                                            data-atlas-pick-mode="move"
                                            data-atlas-pick-name="{{ row.name }}">{{ ux_icon('shell:map-pin') }} Move on the map</button>
                                    <button type="submit" class="btn sm">{{ ux_icon('shell:map-pin') }} Move the point</button>
                                </form>

                                <div class="zfrow">
                                    <span class="fldlab">Zone</span>
                                    <span><b>{{ row.zoneName ?? 'unzoned' }}</b><span class="stflagx">derived</span></span>
                                    <span class="zfnote">read from the point, never chosen</span>
                                </div>

                                <form class="zfrow" method="post" action="{{ path('area_station_describe', {uuid: area.uuidString, station: row.uuid}) }}">
                                    <input type="hidden" name="_token" value="{{ editToken }}">
                                    <label class="fldlab" for="el-{{ row.uuid }}">Elevation</label>
                                    <input class="fld zfld-sm" id="el-{{ row.uuid }}" name="elevation" value="{{ row.elevationM }}" inputmode="numeric" aria-label="Elevation in metres">
                                    <label class="fldlab" for="lo-{{ row.uuid }}">Locality</label>
                                    <input class="fld" id="lo-{{ row.uuid }}" name="locality" value="{{ row.locality }}" maxlength="120">
                                    <button type="submit" class="btn sm">{{ ux_icon('shell:square-pen') }} Save</button>
                                    <span class="zfnote">what a radio call would say</span>
                                </form>

                                {# WHAT "INSIDE THIS STATION" MEANS. Its own form beside the
                                   description, because it is its own question: the row above
                                   says what a radio call would say, this one decides whether
                                   somebody standing there counts as being at their station. #}
                                <form class="zfrow" method="post" action="{{ path('area_station_catchment', {uuid: area.uuidString, station: row.uuid}) }}">
                                    <input type="hidden" name="_token" value="{{ editToken }}">
                                    <label class="fldlab" for="ca-{{ row.uuid }}">Catchment</label>
                                    <input class="fld zfld-sm" id="ca-{{ row.uuid }}" name="catchment" value="{{ row.catchmentM }}"
                                           inputmode="numeric" aria-label="Catchment radius in metres">
                                    <button type="submit" class="btn sm">{{ ux_icon('shell:square-pen') }} Save</button>
                                    <span class="zfnote">a check-in claiming this station is <b>verified</b> inside it
                                        &middot; default {{ defaultCatchmentM|number_format }} m &middot; empty is no ring at all</span>
                                </form>

                                {% if row.openedAt %}
                                    <div class="zfrow">
                                        <span class="fldlab">Opened</span>
                                        <time class="mono" datetime="{{ row.openedAt|date('c') }}" data-localtime-format="day">{{ row.openedAt|date('j M Y') }}</time>
                                    </div>
                                {% endif %}

                                <div class="stbhd">Stationed here<span>{{ row.posted }}</span></div>
                                {% if board is empty %}
                                    <div class="stnorow">Nobody is stationed here &mdash; a station with nobody at it is a normal state, not an error.</div>
                                {% else %}
                                    <div class="stboard">
                                        {% for person in board %}
                                            <div class="strow">
                                                <b>{{ person.name }}</b>
                                                <em>{{ person.role ?? '' }}</em>
                                                <time class="stwhen" datetime="{{ person.since|date('c') }}" data-localtime-format="day">since {{ person.since|date('j M Y') }}</time>
                                                <span class="stacts">
                                                    {% if person.leader %}
                                                        <span class="chip acc stlead">Leads</span>
                                                    {% else %}
                                                        {# ONE LEADER PER STATION: appointing one steps the current
                                                           one down in the same write. #}
                                                        <form method="post" action="{{ path('area_posting_lead', {uuid: area.uuidString, posting: person.postingUuid}) }}">
                                                            <input type="hidden" name="_token" value="{{ postingToken }}">
                                                            <button type="submit" class="btn sm"
                                                                    title="Appoint {{ person.name }} &mdash; one leader per station; the current one steps down in the same write">{{ ux_icon('shell:square-pen') }} Appoint leader</button>
                                                        </form>
                                                    {% endif %}
                                                    <form method="post" action="{{ path('area_posting_end', {uuid: area.uuidString, posting: person.postingUuid}) }}">
                                                        <input type="hidden" name="_token" value="{{ postingToken }}">
                                                        <button type="submit" class="btn sm">End assignment</button>
                                                    </form>
                                                </span>
                                            </div>
                                        {% endfor %}
                                    </div>
                                {% endif %}

                                {# STATION SOMEBODY: a chooser of whoever owns people, through the
                                   directory seam. An installation that publishes none says so
                                   rather than drawing an empty control. #}
                                <form class="staddrow" method="post" action="{{ path('area_station_post', {uuid: area.uuidString, station: row.uuid}) }}">
                                    <input type="hidden" name="_token" value="{{ postingToken }}">
                                    <label class="fldlab" for="pp-{{ row.uuid }}">Station someone</label>
                                    {% if people is empty %}
                                        <span class="zfnote">nobody is published to station &mdash; this installation carries no people directory</span>
                                    {% else %}
                                        <select class="fld" id="pp-{{ row.uuid }}" name="person">
                                            <option value="">Pick a person&hellip;</option>
                                            {% for person in people %}
                                                <option value="{{ person.userUuid }}">{{ person.label }}</option>
                                            {% endfor %}
                                        </select>
                                        <button type="submit" class="btn sm">Station somebody here</button>
                                        <span class="zfrag">standing, not a shift</span>
                                    {% endif %}
                                </form>

                                {# WHAT THE MODULES ASK ABOUT THIS STATION. The watch a
                                   station is expected to keep is the roster's, not the
                                   area's, so those rows are CONTRIBUTED into the card
                                   after the assignments board. A parked module adds
                                   nothing and the card simply ends sooner. #}
                                {% for block in blocks[row.uuid]|default([]) %}
                                    {{ include('@Area/_partial/_station_block.html.twig', {band: block}, with_context = false) }}
                                {% endfor %}

                                <div class="zcmore">
                                    <span class="sp"></span>
                                    {% if row.active %}
                                        {# DESTRUCTIVE ENOUGH TO ASK — through the installation's
                                           shared confirm modal, never the browser's own dialog. #}
                                        <form method="post" action="{{ path('area_station_activity', {uuid: area.uuidString, station: row.uuid}) }}">
                                            <input type="hidden" name="_token" value="{{ editToken }}">
                                            <input type="hidden" name="active" value="0">
                                            <button type="submit" class="btn sm dg"
                                                    {{ stimulus_controller('confirm-modal') }}
                                                    data-action="click->confirm-modal#ask"
                                                    data-confirm-modal-title-value="Close “{{ row.name }}”?"
                                                    data-confirm-modal-message-value="It keeps its point and its code and stays here behind the Active filter, so it can be reopened. The {{ row.posted }} posting{{ row.posted == 1 ? '' : 's' }} standing at it end today, and every record already made against it still points at it."
                                                    data-confirm-modal-confirm-label-value="Close the station"
                                                    data-confirm-modal-danger-value="true">{{ ux_icon('shell:power') }} Deactivate&hellip;</button>
                                        </form>
                                    {% else %}
                                        <form method="post" action="{{ path('area_station_activity', {uuid: area.uuidString, station: row.uuid}) }}">
                                            <input type="hidden" name="_token" value="{{ editToken }}">
                                            <input type="hidden" name="active" value="1">
                                            <button type="submit" class="btn sm">{{ ux_icon('shell:power') }} Reactivate</button>
                                        </form>
                                    {% endif %}
                                </div>
                        </details>
                    {% endfor %}
                </div>

                {# BOUNDED BY A PAGE, NOT BY A SCROLLBAR: the count on the left,
                   the pages on the right, eight rows between them. #}
                {{ include('@Area/_partial/_pager.html.twig', {
                    query: query, page: register.page, pages: register.pages,
                    from: register.from, to: register.to, total: register.total, scope: register.scope, noun: 'stations',
                }) }}
            {% endif %}
        </div>
    </div>

    <div class="col">
        <div class="c" id="add">
            <span class="tab">Add a station<span class="src">&middot; a name and a point</span></span>
            <form id="station-add" method="post" action="{{ path('area_station_add', {uuid: area.uuidString}) }}">
                <input type="hidden" name="_token" value="{{ addToken }}">
                {% if register.isEmpty and not query.isFiltered %}
                    <div class="zlead">
                        {{ ux_icon('shell:info') }}
                        <span>A station is a point in the <b>area</b>, not in a zone &mdash; the zone is read from where you put it.</span>
                    </div>
                {% endif %}
                <div class="zfrow">
                    <label class="fldlab" for="add-name">Name</label>
                    <input class="fld" id="add-name" name="name" maxlength="128" placeholder="Eastgate Station" required>
                </div>
                <div class="zfrow">
                    <span class="fldlab">Code</span>
                    <span class="stcode">{{ nextCode }}</span>
                    <span class="zfnote">issued on save</span>
                </div>
                <div class="zfrow">
                    <label class="fldlab" for="add-lat">Point</label>
                    <span class="stpt">
                        <input class="fld" id="add-lat" name="lat" placeholder="&minus;3.19684" aria-label="Latitude" inputmode="decimal" required>
                        <span class="sep">,</span>
                        <input class="fld" name="lon" placeholder="-29.47122" aria-label="Longitude" inputmode="decimal" required>
                    </span>
                </div>
                <div class="zfrow">
                    <label class="fldlab" for="add-elevation">Elevation</label>
                    <input class="fld zfld-sm" id="add-elevation" name="elevation" inputmode="numeric"
                           placeholder="2,286" aria-label="Elevation in metres">
                    <span class="zfnote">metres, if it is known</span>
                </div>
                <div class="zfrow">
                    <label class="fldlab" for="add-locality">Locality</label>
                    <input class="fld" id="add-locality" name="locality" maxlength="120" placeholder="crater rim road">
                    <span class="zfnote">what a radio call would say</span>
                </div>
                <div class="zfrow">
                    <label class="fldlab" for="add-opened">Opened</label>
                    <input class="fld zfld-sm" id="add-opened" name="opened" type="date" aria-label="The day it opened">
                    <span class="zfnote">the day it started taking patrols</span>
                </div>
                {# THE ZONE IS READ, NEVER CHOSEN — the field is here so the
                   form states every fact the record will hold, and it states
                   this one as the derivation it is. #}
                <div class="zfrow">
                    <span class="fldlab">Zone</span>
                    <span class="mono d">&mdash;</span>
                    <span class="zfnote">derived once there is a point</span>
                </div>
                <div class="zcmore">
                    <button type="button" class="btn sm"
                            data-atlas-pick="station-add"
                            data-atlas-pick-mode="add"
                            data-atlas-pick-name="the new station">{{ ux_icon('shell:map-pin') }} Pick on the map</button>
                    <span class="sp"></span>
                    <button type="submit" class="cta">Add the station</button>
                </div>
                {# WHAT THE FIELD HOLDS, in one line: the plate says what it is
                   armed for, and this says what came of it. #}
                <div class="stpick">
                    {{ ux_icon('shell:map-pin') }}
                    <span>The point is <b data-atlas-pick-note>typed, or picked on the plate</b></span>
                    <span class="sp"></span>
                    <span class="zfrag">latitude, then longitude</span>
                </div>
            </form>
        </div>

        <div class="c">
            <span class="tab">History<span class="src">&middot; newest first</span></span>
            {% if events is empty %}
                <div class="use">Nothing has happened to this area&rsquo;s stations yet. Every point, assignment and closure writes one line here.</div>
            {% else %}
                <div class="zhist">
                    {% for event in events %}
                        <div class="zhrow">
                            <span class="zhdot{{ event.kind.isClosure ? ' bad' : (loop.first ? ' on' : '') }}"></span>
                            <div><b>{{ event.headline }}{% if event.detail %} <span>&middot; {{ event.detail }}</span>{% endif %}</b></div>
                            <time class="zhwhen" datetime="{{ event.occurredAt|date('c') }}" data-localtime-format="day">{{ event.occurredAt|date('j M') }}</time>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
