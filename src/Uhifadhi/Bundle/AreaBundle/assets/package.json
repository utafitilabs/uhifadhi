{
    "name": "@uhifadhi/area-bundle",
    "description": "Front-end behaviour of the area screens \u2014 the register's search, filter and sort, the boundary drop zone and the per-area module shop's drag ordering, mapped into hosts via AssetMapper.",
    "license": "AGPL-3.0-or-later",
    "symfony": {
        "controllers": {
            "area-register": {
                "main": "controllers/area_register_controller.js",
                "fetch": "eager",
                "enabled": true
            },
            "area-upload": {
                "main": "controllers/area_upload_controller.js",
                "fetch": "eager",
                "enabled": true
            },
            "area-presets": {
                "main": "controllers/area_presets_controller.js",
                "fetch": "eager",
                "enabled": true
            },
            "module-order": {
                "main": "controllers/module_order_controller.js",
                "fetch": "eager",
                "enabled": true
            },
            "module-register": {
                "main": "controllers/module_register_controller.js",
                "fetch": "eager",
                "enabled": true
            },
            "station-point": {
                "main": "controllers/station_point_controller.js",
                "fetch": "eager",
                "enabled": true
            }
        }
    }
}
