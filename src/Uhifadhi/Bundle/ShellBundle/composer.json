{
    "name": "uhifadhi/shell-bundle",
    "type": "symfony-bundle",
    "description": "The uhifadhi shell: the document, the page frame, navigation, the theme and the widget surfaces every dashboard is arranged through.",
    "keywords": [
        "conservation",
        "design-system",
        "layout",
        "navigation",
        "shell",
        "symfony",
        "symfony-ux",
        "theme",
        "uhifadhi",
        "widgets"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Ezekiel Mjema",
            "homepage": "https://github.com/eemjema"
        }
    ],
    "require": {
        "php": ">=8.4",
        "composer-runtime-api": "^2.0",
        "doctrine/dbal": "^4.0",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.5",
        "doctrine/persistence": "^3.1 || ^4.0",
        "ext-mbstring": "*",
        "psr/clock": "^1.0",
        "psr/container": "^1.1 || ^2.0",
        "symfony/asset": "^7.3 || ^8.0",
        "symfony/asset-mapper": "^7.3 || ^8.0",
        "symfony/clock": "^7.3 || ^8.0",
        "symfony/config": "^7.3 || ^8.0",
        "symfony/dependency-injection": "^7.3 || ^8.0",
        "symfony/framework-bundle": "^7.3 || ^8.0",
        "symfony/http-foundation": "^7.3 || ^8.0",
        "symfony/http-kernel": "^7.3 || ^8.0",
        "symfony/routing": "^7.3 || ^8.0",
        "symfony/security-core": "^7.3 || ^8.0",
        "symfony/security-csrf": "^7.3 || ^8.0",
        "symfony/stimulus-bundle": "^2.20 || ^3.0",
        "symfony/twig-bundle": "^7.3 || ^8.0",
        "symfony/uid": "^7.3 || ^8.0",
        "symfony/ux-icons": "^2.20 || ^3.0",
        "twig/twig": "^3.14",
        "uhifadhi/contracts": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Uhifadhi\\Bundle\\ShellBundle\\": "",
            "Uhifadhi\\Bundle\\ShellBundle\\Migrations\\": "migrations/"
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Uhifadhi\\Bundle\\ShellBundle\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
