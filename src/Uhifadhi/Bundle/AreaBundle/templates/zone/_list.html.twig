{# THE ZONES OF AN AREA, ON THE HOUSE TABLE.

   Design: areas/<area>/zones/zones.html.

   A FIGURE IS PUBLISHED OR IT IS ABSENT. The extent, the stations and the
   people posted are the area's own facts and are always numbers; Covered and
   every module column come through the zone-figure seam, and where no
   installed module answered the cell is a dash rather than a nought. #}
{%- macro figure(figure) -%}
    {%- if figure and figure.isKnown -%}
        {{ figure.display }}{{ figure.unit == '%' ? ' %' : figure.unit }}
    {%- else -%}
        <span class="mono d" title="no module publishes it">&mdash;</span>
    {%- endif -%}
{%- endmacro -%}
<table class="tbl" data-zones>
    <thead><tr><th>Zone</th><th class="num">km&sup2;</th><th class="num">Covered</th><th class="num">Stations</th><th class="num">Posted</th>{% for slug, heading in columns %}<th class="num">{{ heading }}</th>{% endfor %}<th></th></tr></thead>
    <tbody>
    {% for row in rows %}
        <tr data-zone><td><b>{{ row.name }}</b></td><td class="num">{{ row.km2|number_format }}</td><td class="num">{{ _self.figure(row.covered) }}</td><td class="num">{{ row.stations }}</td><td class="num">{{ row.people }}</td>
            {%- for slug, heading in columns %}<td class="num">{{ _self.figure(row.figures[slug]|default(null)) }}</td>{% endfor -%}
            <td class="door"><a class="open-btn" href="{{ path('area_zone_show', {uuid: area.uuidString, zone: row.uuid}) }}">Open</a></td></tr>
    {% endfor %}
    </tbody>
</table>
