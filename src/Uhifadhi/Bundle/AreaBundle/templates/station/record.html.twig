{# ONE STATION, READ.

   Design: areas/<area>/stations/detail.html.

   ITS FACTS STRIP IS ITS OVERVIEW; the index lists the cards, one row a
   card (a module's contributed band included); the cards stand in one
   column; the people and the log are house tables under their bar and over
   their foot. The station's code stays, as data.

   A RECORD PAGE, NOT AN AREA TAB: the crumb and the header, no tab strip —
   the shape the incident detail page wears, because a station is a thing
   inside the area rather than one of the ways of looking at it.

   IT ONLY READS. Every control that would change something points at the
   area's configure page, where the Stations section edits the record.

   THE PLATE IS THE ATLAS'S, and it is the same plate the zones pages draw:
   same hues, same key, same contract, with the stations and the rings added.
   The same ground rendered two ways on two pages is the defect one plate
   service avoids. #}
{% extends '@Shell/page.html.twig' %}

{% block title %}{{ station.name }} · {{ area.name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('@Area/_stylesheets.html.twig') }}
{% endblock %}

{% block shell_breadcrumbs %}
    <a href="{{ path('area_index') }}">uhifadhi</a> /
    <a href="{{ path('area_show', {uuid: area.uuidString}) }}">{{ area.name }}</a> /
    {# THE STATIONS STEP IS THE AREA'S STATIONS TAB, the list this record
       belongs to. #}
    <a href="{{ path('area_stations', {uuid: area.uuidString}) }}">stations</a> /
    {{ station.name|lower }}
{% endblock %}

{% block shell_page_title %}{{ station.name }}{% endblock %}

{% block shell_page_subtitle %}
    Station in {{ zone ? zone.name : 'no zone' }} &middot; {{ posted }} posted
    {%- if not station.active %} &middot; closed{% endif -%}
{% endblock %}

{% block shell_page_actions %}
    {# THE RECORD IS EDITED ON THE AREA'S CONFIGURE PAGE, in the Stations
       section beside Zones. This page only reads, so the controls are links
       out and not forms. #}
    <a class="tgl w-act" href="{{ path('area_stations_configure', {uuid: area.uuidString}) }}?open={{ station.uuidString }}">{{ ux_icon('shell:square-pen') }} Edit the station</a>
    {% if door('assignments.manage') %}
        <a class="cta" href="{{ path('area_stations_configure', {uuid: area.uuidString}) }}?open={{ station.uuidString }}">Post someone</a>
    {% endif %}
{% endblock %}

{% block shell_page %}
{% set here = path('area_station_show', {uuid: area.uuidString, station: station.uuidString}) %}
{% set ctl = 'uhifadhi--area-bundle--area-query' %}
{% set q = 'Uhifadhi\\Bundle\\AreaBundle\\Model\\PostingQuery' %}

{# THE FACTS STRIP. ON DUTY IS THE ROSTER'S and no module publishes it yet,
   so Posted states the number it knows and says nothing it does not. #}
<div class="factband ov-band">
    <span class="f"><span class="k">Zone</span><span class="v">{{ zone ? zone.name : '&mdash;'|raw }}<em>{{ zone ? 'derived' : 'unzoned' }}</em></span></span>
    {% if station.code %}<span class="f"><span class="k">Code</span><span class="v">{{ station.code }}<em>the call sign</em></span></span>{% endif %}
    <span class="f"><span class="k">Posted</span><span class="v">{{ posted }}</span></span>
    <span class="f"><span class="k">Lead</span><span class="v">{{ leader ? leader.name : '&mdash;'|raw }}</span></span>
    {% if station.elevationM %}
        <span class="f"><span class="k">Elevation</span><span class="v">{{ station.elevationM|number_format }} m{% if station.locality %}<em>{{ station.locality }}</em>{% endif %}</span></span>
    {% endif %}
    {# OPEN OR CLOSED IS ALWAYS A FACT, whether or not anybody wrote down the
       day it started. #}
    <span class="f"><span class="k">Opened</span><span class="v">
        {%- if station.openedAt -%}
            <time datetime="{{ station.openedAt|date('c') }}" data-localtime-format="day">{{ station.openedAt|date('j M Y') }}</time>
        {%- else -%}
            &mdash;
        {%- endif -%}
        <em>{{ station.active ? 'active' : 'closed' }}</em>
    </span></span>
    <span class="sp"></span>
    {% if zone %}<a class="more" href="{{ path('area_stations_list', {uuid: area.uuidString, zone: zone.uuidString}) }}">Stations in {{ zone.name }} &rarr;</a>{% endif %}
</div>

{% set rows_ = [{id: 'ground', label: 'The ground'}, {id: 'posted', label: 'Who is posted here', count: posted}] %}
{% for band in bands %}{% set rows_ = rows_|merge([{id: band.section.id, label: band.section.label}]) %}{% endfor %}
{% set rows_ = rows_|merge([{id: 'point', label: 'The point'}, {id: 'log', label: 'What happened here', count: logTable.total}]) %}

{% set people = rows %}
{% embed '@Shell/_onpage.html.twig' with {rows: rows_} %}
    {% block shell_onpage_main %}
        <div class="c" id="ground">
            <span class="tab">The ground around the station<span class="src">
                {%- if coordinates %}&middot; {{ coordinates }} {% endif -%}
                {%- if station.elevationM %}&middot; {{ station.elevationM|number_format }} m{% endif -%}
            </span></span>
            {{ render_map(map, {
                'role': 'img',
                'aria-label': station.name ~ ' and the ground around it',
                '--map-plate-height': 'min(58vh, 560px)',
            }) }}
        </div>

        <div class="c stpostings" id="posted">
            <span class="tab">Who is posted here<span class="src">&middot; {{ posted }} {{ posted == 1 ? 'person' : 'people' }}
                {%- if leader %} &middot; led by {{ leader.name }}{% endif -%}
            </span></span>
            {# DUTY IS NOT HERE. Who is on duty today is the roster's, and no
               module publishes it yet. #}
            <div class="lfilt" data-controller="{{ ctl }}" data-action="uhifadhi--shell-bundle--dropdown:choose->{{ ctl }}#chosen">
                {% if facets.knowsRoles %}
                    {{ include('@Shell/_dropdown.html.twig', {
                        name: constant(q ~ '::ROLE'), label: 'Any position', icon: 'shell:user', default: '', value: query.role ?? '',
                        groups: [
                            {label: null, options: [{value: '', label: 'Any position', count: posted}]},
                            {label: 'Positions', options: facets.roleOptions|map(o => {value: o.value, label: o.label, count: o.count})},
                        ],
                    }, with_context: false) }}
                    {{ include('@Shell/_dropdown.html.twig', {
                        name: constant(q ~ '::DEPARTMENT'), label: 'All departments', icon: 'shell:users', default: '', value: query.department ?? '',
                        groups: [
                            {label: null, options: [{value: '', label: 'All departments', count: posted}]},
                            {label: 'Departments', options: facets.departmentOptions|map(o => {value: o.value, label: o.label, count: o.count})},
                        ],
                    }, with_context: false) }}
                {% endif %}
                {{ include('@Shell/_dropdown.html.twig', {
                    name: constant(q ~ '::SOURCE'), label: 'Recorded anywhere', icon: 'shell:square-pen', default: '', value: query.source ?? '',
                    groups: [
                        {label: null, options: [{value: '', label: 'Recorded anywhere', count: posted}]},
                        {label: 'Recorded', options: facets.sourceOptions|map(o => {value: o.value, label: o.value == 'here' ? 'Written here' : 'From their page', count: o.count})},
                    ],
                }, with_context: false) }}
                {{ include('@Shell/_dropdown.html.twig', {
                    name: constant(q ~ '::SORT'), label: 'Name A–Z', icon: 'shell:arrow-up-down', default: 'az', value: query.sort,
                    groups: [
                        {label: 'Order', options: [
                            {value: 'az', label: 'Name A–Z', count: null},
                            {value: 'newest', label: 'Newest posting', count: null},
                            {value: 'since', label: 'Oldest posting', count: null},
                            {value: 'role', label: 'By position', count: null},
                        ]},
                    ],
                }, with_context: false) }}
                <form class="lsearch" method="get" action="{{ here }}">
                    {{ ux_icon('shell:search') }}
                    <input class="fld" type="search" name="q" value="{{ query.search }}" placeholder="Find a person&hellip;" aria-label="Find a person posted here">
                    {% for k, v in query.with('q', null) %}<input type="hidden" name="{{ k }}" value="{{ v }}">{% endfor %}
                </form>
            </div>

            {% if people is empty %}
                {# AN EMPTY STATE THAT NAMES A PAGE OWES A DOOR TO IT, gated on
                   what the door is for: posting somebody is `assignments.manage`. #}
                <div class="zempty stpplnone">
                    <b class="zeh">{{ query.isFiltered ? 'Nobody matches' : 'Nobody is posted here' }}</b>
                    <p class="zeb">{% if query.isFiltered %}No posting here answers these filters. Clear one, or search another name.{% else %}A station with nobody at it is a normal state, not an error.{% endif %}</p>
                    {% if query.isFiltered %}
                        <span class="zea"><a class="btn sm" href="{{ here }}">Clear the filters</a></span>
                    {% elseif door('assignments.manage') %}
                        <span class="zea"><a class="btn sm" href="{{ path('area_stations_configure', {uuid: area.uuidString}) }}?open={{ station.uuidString }}">Post someone &rarr;</a></span>
                    {% endif %}
                </div>
            {% else %}
                <table class="tbl">
                    <thead><tr><th>Person</th><th>Position</th><th>Recorded</th><th>Since</th><th></th></tr></thead>
                    <tbody>
                    {% for row in people %}
                        <tr><td><b>{{ row.name }}</b>{% if row.leader %} <span class="chip ok">leads</span>{% endif %}</td><td><span class="mono d">{{ row.role ?? '—' }}</span>{% if row.department %}<span class="sub">{{ row.department }}</span>{% endif %}</td><td><span class="mono d">{{ row.source.value == 'here' ? 'written here' : 'from their page' }}</span></td><td><span class="mono d"><time datetime="{{ row.since|date('c') }}" data-localtime-format="day">{{ row.since|date('j M Y') }}</time></span></td><td class="door">{% if door('assignments.manage') %}<a class="btn sm" href="{{ path('area_stations_configure', {uuid: area.uuidString}) }}?open={{ station.uuidString }}">End posting</a>{% endif %}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
                {{ include('@Shell/_foot.html.twig', {
                    count: peopleTable.total, noun: 'people', one: 'person',
                    perPage: peopleTable.size, page: peopleTable.page, pages: peopleTable.pages, links: peopleLinks,
                }, with_context: false) }}
            {% endif %}
        </div>

        {# WHAT THE MODULES PUT ON THIS STATION, after the area's own cards;
           with no such module installed there is no card and no index row. #}
        {% for band in bands %}
            {{ include('@Area/_partial/_station_band.html.twig', {band: band}, with_context = false) }}
        {% endfor %}

        <div class="c" id="point">
            <span class="tab">The point</span>
            <div class="rln"><span class="fog">Coordinates</span><span class="mono">{{ coordinates ?? '&mdash;'|raw }}</span></div>
            {% if station.locality %}<div class="rln"><span class="fog">Where</span><span class="mono">{{ station.locality }}</span></div>{% endif %}
            {# WHAT "INSIDE THIS STATION" MEANS: the line between a day claimed
               here that is verified and one that is not. #}
            <div class="rln"><span class="fog">Catchment</span><span class="mono">
                {%- if station.catchmentM -%}
                    {{ station.catchmentM >= 1000 ? (station.catchmentM / 1000)|round(2) ~ ' km' : station.catchmentM ~ ' m' }}
                    of the station point &mdash; a check-in claiming this station is verified inside it
                {%- else -%}
                    no ring &mdash; a check-in claiming this station cannot be verified against it
                {%- endif -%}
            </span></div>
            {# WHAT THE MODULES PUBLISH — one row per module, through the
               station seam. #}
            <div class="stsep">What the modules publish<span>{{ dockPeriod.label }}</span></div>
            {% if dock is empty %}
                <div class="use">No module publishes figures for this station yet.</div>
            {% else %}
                <div class="stdock">
                    {% for figure in dock %}
                        <div class="stdockrow">
                            <i></i>
                            <span class="stdn">{{ figure.label }}</span>
                            <span class="stdf">{{ figure.value is null ? '&mdash;'|raw : figure.display }}</span>
                            <span class="stdw">{{ figure.caption }}</span>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="c stlogcard" id="log">
            <span class="tab">What happened here<span class="src">&middot; {{ logTable.total }} {{ logTable.total == 1 ? 'line' : 'lines' }}</span></span>
            {% if events is empty %}
                <div class="use">Nothing has happened at this station yet. Every move, posting and closure writes one line here.</div>
            {% else %}
                <table class="tbl">
                    <thead><tr><th>What happened</th><th>When</th></tr></thead>
                    <tbody>
                    {% for event in events %}
                        <tr><td><b>{{ event.headline }}</b>{% if event.detail %}<span class="sub">{{ event.detail }}</span>{% endif %}</td><td><span class="mono d"><time datetime="{{ event.occurredAt|date('c') }}" data-localtime-format="day">{{ event.occurredAt|date('j M Y') }}</time></span><time class="sub" datetime="{{ event.occurredAt|date('c') }}" data-localtime-format="clock">{{ event.occurredAt|date('H:i') }}</time></td></tr>
                    {% endfor %}
                    </tbody>
                </table>
                {{ include('@Shell/_foot.html.twig', {
                    count: logTable.total, noun: 'lines', one: 'line',
                    perPage: logTable.size, page: logTable.page, pages: logTable.pages, links: logLinks,
                }, with_context: false) }}
            {% endif %}
        </div>
    {% endblock %}
{% endembed %}
{% endblock %}
