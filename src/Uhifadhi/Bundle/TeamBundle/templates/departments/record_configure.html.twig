{# A DEPARTMENT'S CONFIGURE PAGE — where it is changed.

   Design: departments/configure-department.html. The same shape a person and
   a position have: the record's head, a "The record" door back, and one card
   per operation: RENAME; SCOPE — confine an
   org-wide department to one area, or promote an area's department to
   org-wide, a reason required because authority moves with it; and DEACTIVATE,
   never delete — a department is an organizational fact that is wound down,
   not erased; the MODULES it runs; its GOALS. #}
{% extends '@Shell/page.html.twig' %}
{% import '@Team/departments/_bits.html.twig' as di %}
{% import '@Team/_partial/_table.html.twig' as tb %}

{% set area = department.area %}
{% set uuid = department.uuidString %}
{% set filled = headcount %}

{% block title %}{{ department.name }} · configure{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('@Team/_stylesheets.html.twig') }}
{% endblock %}

{% block shell_page_tabs %}{% endblock %}

{% block shell_breadcrumbs %}
    <a href="{{ path('team_index') }}">uhifadhi</a> /
    <a href="{{ path('team_departments') }}">departments</a> /
    <a href="{{ path('team_department_show', {uuid: uuid}) }}">{{ department.name|lower }}</a> / configure
{% endblock %}

{% block shell_page_head %}
    <div class="dpthead">
        <span class="mark">{{ mark }}</span>
        <div>
            <h1 class="pg">{{ department.name }}</h1>
            <p class="pgsub"><span>Configure</span> &middot; <span>name</span> &middot; <span>scope</span> &middot; <span>active</span></p>
        </div>
    </div>
    <div class="pgact w-pgact">
        <a class="tgl w-act" href="{{ path('team_department_show', {uuid: uuid}) }}">{{ ux_icon('shell:chevron-left', {width: 15, height: 15}) }} The record</a>
    </div>
{% endblock %}

{% block shell_page %}
{{ include('@Team/team/_scope_banner.html.twig') }}
<div class="recgrid" data-dp-configure>
    <div class="col">
        {# NAME #}
        <div class="c">
            <span class="tab">Name<span class="src">&middot; what the register calls it</span></span>
            <form method="post" action="{{ path('team_department_rename', {uuid: uuid}) }}">
                <input type="hidden" name="_token" value="{{ csrfToken }}">
                <input type="hidden" name="_return" value="{{ returnTo }}">
                <div class="crgrid">
                    <div class="crfield grow"><span class="crlab">Name</span>
                        <input class="fld" type="text" name="name" value="{{ department.name }}" maxlength="120" aria-label="Rename {{ department.name }}" required>
                        <span class="zfrag">Required &middot; 120 &middot; unique among org-wide departments</span></div>
                </div>
                <div class="staddrow">
                    <span class="sp"></span>
                    <button type="reset" class="btn">Discard</button>
                    <button type="submit" class="cta">Rename</button>
                </div>
            </form>
        </div>

        {# SCOPE AND VISIBILITY (#74, design B) — where it works and who outside
           it sees it decide who reads it, so they are one form under one reason,
           and each change is a line in the permission history. #}
        <div class="c">
            <span class="tab">Scope and visibility<span class="src">&middot; where {{ department.name }} works, and who outside it sees it</span></span>
            <form method="post" action="{{ path('team_department_scope', {uuid: uuid}) }}">
                <input type="hidden" name="_token" value="{{ csrfToken }}">
                <input type="hidden" name="_return" value="{{ returnTo }}">
                <div class="crgrid">
                    <div class="crfield"><span class="crlab">Works in</span>
                        <select class="fld" name="area" aria-label="Where {{ department.name }} works">
                            <option value=""{{ area ? '' : ' selected' }}>the whole organization</option>
                            {% for option in areas %}<option value="{{ option.uuidString }}"{{ area and area.uuidString == option.uuidString ? ' selected' }}>{{ option.name }}</option>{% endfor %}
                        </select></div>
                    <div class="crfield"><span class="crlab">Seen by</span>
                        <select class="fld" name="visibility" aria-label="Who outside {{ department.name }} sees it">
                            {% for level in visibilities %}<option value="{{ level.value }}"{{ level == department.visibility ? ' selected' }}>{{ level.choice() }}</option>{% endfor %}
                        </select></div>
                </div>
                <div class="crgrid">
                    <div class="crfield grow"><span class="crlab">Reason &middot; required</span>
                        <input class="fld" type="text" name="reason" placeholder="Why does {{ department.name }} change?" aria-label="Reason for the change to {{ department.name }}"></div>
                </div>
                <p class="sbn">{% if area %}Working across the organization widens its {{ positions|length }} position{{ positions|length == 1 ? '' : 's' }} and the {{ filled }} {{ filled == 1 ? 'person' : 'people' }} in them to <b>every area</b>.{% else %}Confining it narrows its {{ positions|length }} position{{ positions|length == 1 ? '' : 's' }}, the {{ filled }} {{ filled == 1 ? 'person' : 'people' }} in them and its figures to that area.{% endif %}
                    Listed puts its name and area in everybody&rsquo;s register; Open lets everybody who reads departments read it. Both changes ask for a reason and leave a line in the permission history.</p>
                <div class="staddrow">
                    <span class="sp"></span>
                    <button type="submit" class="cta">Save scope and visibility</button>
                </div>
            </form>
        </div>

        {# ACTIVE — deactivate, never delete. #}
        <div class="c">
            <span class="tab">Active<span class="src">&middot; {{ department.active ? 'in the pickers and the register' : 'deactivated — hidden from the pickers, greyed in the register' }}</span></span>
            {% if department.active %}
                <p class="sbn">{% if positions|length %}{{ positions|length }} position{{ positions|length == 1 ? '' : 's' }} ({{ filled }} {{ filled == 1 ? 'person' : 'people' }}) are held here and keep what they grant.{% else %}Nobody is placed here &mdash; an empty footprint.{% endif %} Nothing is deleted, and it is one click from coming back.</p>
                <form method="post" action="{{ path('team_department_deactivate', {uuid: uuid}) }}" data-deactivate>
                    <input type="hidden" name="_token" value="{{ csrfToken }}">
                    <input type="hidden" name="_return" value="{{ returnTo }}">
                    <div class="staddrow">
                        <span class="sp"></span>
                        <button class="softbtn danger" type="submit"
                                {{ stimulus_controller('confirm-modal') }}
                                data-action="click->confirm-modal#ask"
                                data-confirm-modal-title-value="Deactivate “{{ department.name }}”?"
                                data-confirm-modal-message-value="{% if positions|length %}{{ positions|length }} position{{ positions|length == 1 ? '' : 's' }} ({{ filled }} {{ filled == 1 ? 'person' : 'people' }}) are held here and keep what they grant.{% else %}Nobody is placed here — an empty footprint.{% endif %} It is hidden from the pickers and greyed in the register; nothing is deleted, and it is one click from coming back."
                                data-confirm-modal-confirm-label-value="Deactivate anyway"
                                data-confirm-modal-danger-value="true">Deactivate anyway</button>
                    </div>
                </form>
            {% else %}
                <form method="post" action="{{ path('team_department_reactivate', {uuid: uuid}) }}">
                    <input type="hidden" name="_token" value="{{ csrfToken }}">
                    <input type="hidden" name="_return" value="{{ returnTo }}">
                    <div class="staddrow">
                        <span class="sp"></span>
                        <button class="cta" type="submit">Reactivate</button>
                    </div>
                </form>
            {% endif %}
        </div>
        {# MODULES — what it runs; switching one grants nothing and hides nothing. #}
        <div class="c" {{ tb.wrap('modules', 'module') }}>
            <span class="tab">Modules<span class="src">&middot; what {{ department.name }} runs</span></span>
            {% set on = modules|filter(m => m.on)|length %}
            <div class="lfilt">
                {{ tb.chip('state', [
                    {value: '', label: 'All', count: modules|length},
                    {value: 'on', label: 'On', count: on},
                    {value: 'off', label: 'Off', count: modules|length - on},
                ]) }}
                {{ tb.search('Find a module') }}
            </div>
            <table class="tbl" data-dept-modules-control>
                <thead><tr><th>Module</th><th>Department</th><th class="door"></th></tr></thead>
                <tbody>
                {% for module in modules %}
                    <tr {{ tb.row({state: module.on ? 'on' : 'off'}, module.name) }}{% if module.on %} data-dept-attached{% else %} data-dept-attach{% endif %}>
                        <td><b>{{ module.name }}</b>{% if module.description %}<span class="sub">{{ module.description }}</span>{% endif %}</td>
                        <td><span class="chip{{ module.on ? ' ok' }}">{{ module.on ? 'on' : 'off' }}</span></td>
                        <td class="door">
                            <form method="post" action="{{ path('team_department_module_toggle', {uuid: uuid, slug: module.slug}) }}">
                                <input type="hidden" name="_token" value="{{ csrfToken }}">
                                <button class="softbtn{{ module.on ? ' danger' }}" type="submit">{{ module.on ? 'Switch off' : 'Switch on' }}</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            {{ tb.none(modules is empty ? 'No module is installed.' : 'No module matches these filters.') }}
            {{ tb.foot(modules|length, 'modules', 'module') }}
            <p class="sbn">Switching a module on makes it <b>lead</b> for this department&rsquo;s people &mdash; it grants nothing and hides nothing. A module two departments run is one module, listed first for both.</p>
        </div>

        {# GOALS — what it says it will do, judged by whatever the modules publish. #}
        <div class="c" {{ tb.wrap('goals', 'goal') }}>
            <span class="tab">Goals<span class="src">&middot; {{ goals|length }} declared</span></span>
            <div class="lfilt">{{ tb.search('Find a goal') }}</div>
            <table class="tbl">
                <thead><tr><th>Goal</th><th>Target</th><th>Answers for it</th><th>Closes</th><th>State</th><th class="door"></th></tr></thead>
                <tbody>
                {% for goal in goals %}
                    <tr {{ tb.row({}, goal.statement) }}>
                        <td><b>{{ goal.statement }}</b>{% if goal.kpiRef %}<span class="sub">{{ goal.kpiRef }}</span>{% endif %}</td>
                        <td class="mono">{{ goal.direction.label }} {{ goal.target }}{{ goal.unit ? ' ' ~ goal.unit : '' }}</td>
                        <td>{% if goal.owner %}{{ goal.owner.name }}{% else %}<em class="pnone">nobody yet</em>{% endif %}</td>
                        <td><time datetime="{{ goal.closesAt|date('c') }}" data-localtime-format="day">{{ goal.closesAt|date('j M Y') }}</time></td>
                        <td><span class="gdots"><i class="{{ goalStates[goal.uuidString].mark }}"></i></span>{{ goalStates[goal.uuidString].label }}</td>
                        <td class="door">
                            <form method="post" action="{{ path('team_department_goal_withdraw', {uuid: uuid, goal: goal.uuidString}) }}">
                                <input type="hidden" name="_token" value="{{ csrfToken }}">
                                <button class="softbtn danger" type="submit"
                                        {{ stimulus_controller('confirm-modal') }}
                                        data-action="click->confirm-modal#ask"
                                        data-confirm-modal-title-value="Withdraw “{{ goal.statement }}”?"
                                        data-confirm-modal-message-value="The commitment is taken away entirely. Nothing else changes."
                                        data-confirm-modal-confirm-label-value="Withdraw it"
                                        data-confirm-modal-danger-value="true">Withdraw</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            {{ tb.none(goals is empty ? 'No goal declared — which is not a miss.' : 'No goal matches this search.') }}
            {{ tb.foot(goals|length, 'goals', 'goal') }}

            <form class="crcard" method="post" action="{{ path('team_department_goal_declare', {uuid: uuid}) }}">
                <input type="hidden" name="_token" value="{{ csrfToken }}">
                <div class="crgrid">
                    <div class="crfield grow"><span class="crlab">The goal</span>
                        <input class="fld" type="text" name="statement" maxlength="200" required placeholder="Cover 60 % of the ground every month" aria-label="What the goal says"></div>
                    <div class="crfield"><span class="crlab">Direction</span>
                        <span class="fsel"><select class="fld" name="direction" aria-label="Which way the goal is met"><option value="at_least">at least</option><option value="at_most">at most</option></select></span></div>
                    <div class="crfield"><span class="crlab">Target</span>
                        <input class="fld zfld-sm" type="text" name="target" inputmode="decimal" required placeholder="60" aria-label="The target"></div>
                    <div class="crfield"><span class="crlab">Unit</span>
                        <input class="fld zfld-sm" type="text" name="unit" maxlength="16" placeholder="%" aria-label="The target’s unit"></div>
                </div>
                <div class="crgrid">
                    <div class="crfield"><span class="crlab">Answers for it</span>
                        <span class="fsel"><select class="fld" name="owner" aria-label="The position that answers for it"><option value="">nobody yet</option>{% for position in positions %}<option value="{{ position.uuidString }}">{{ position.name }}</option>{% endfor %}</select></span></div>
                    <div class="crfield"><span class="crlab">Opens</span>
                        <input class="fld zfld-sm" type="date" name="opensAt" value="{{ goalWindow.opens }}" aria-label="The day the window opens"></div>
                    <div class="crfield"><span class="crlab">Closes</span>
                        <input class="fld zfld-sm" type="date" name="closesAt" value="{{ goalWindow.closes }}" aria-label="The day the window closes"></div>
                    <div class="crfield grow"><span class="crlab">Judged by</span>
                        <input class="fld" type="text" name="kpiRef" maxlength="80" placeholder="patrols.covered" aria-label="The published figure that answers it"></div>
                    <button class="cta" type="submit">{{ ux_icon('shell:plus', {width: 14, height: 14}) }} Declare it</button>
                </div>
            </form>
        </div>
        {% if may_delete() %}
            {# A SUPER ADMIN DELETES (ruled 28 Sep, #48): its own page, counted and typed. #}
            <div class="c">
                <span class="tab">Delete<span class="src">&middot; Super Admin only</span></span>
                <p class="sbn">Its goals, the modules it runs and its stored figures go; the people placed in it stay. For a department that is only closing, Deactivate above keeps everything.</p>
                <div class="staddrow"><span class="sp"></span><a class="softbtn danger" href="{{ path('team_department_delete', {uuid: uuid}) }}">Delete the department&hellip;</a></div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
