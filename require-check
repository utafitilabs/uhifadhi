/*
 * EVERY PACKAGE'S composer.json IS ITS BOUNDARY, CHECKED.
 *
 * `composer-require-checker` fails on any symbol a package uses without
 * declaring the dependency that provides it — which is what makes the
 * per-package manifests real rather than decorative, and what makes the future
 * split a no-op.
 *
 * Two things have to be arranged before it can run against a monorepo, and both
 * follow from how it locates a dependency's sources: it reads
 * `<package>/<config.vendor-dir>/composer/installed.json` for the autoload of
 * every package in `require`, then reads that package's files from
 * `<package>/<config.vendor-dir>/<name>`.
 * @see vendor/maglnet/composer-require-checker/src/ComposerRequireChecker/FileLocator/LocateComposerPackageDirectDependenciesSourceFiles.php
 *
 *   1. A bundle here has no vendor directory of its own: it shares the root's.
 *   2. The packages it depends on that live in THIS repository — the contracts,
 *      and one bundle on another — are not in vendor/ at all, because Composer
 *      resolves them through the root `replace` block.
 *
 * So an overlay vendor directory is built once: every real vendor entry
 * symlinked into it, plus a symlink per in-repository package, and an
 * installed.json that describes them all. Each manifest is then copied beside
 * itself with `config.vendor-dir` pointing at the overlay. The published
 * composer.json stays free of a path that only makes sense before the split.
 *
 * The whitelist in composer-require-checker.dist.json exists for two reasons.
 * A PHP service file declares the configurator's own namespace, so `service()`,
 * `param()` and `tagged_iterator()` are written unqualified and no scan can
 * attribute them to the package that defines them. And a bundle that ships a
 * test base for its CONSUMERS to extend names PHPUnit's TestCase from src/,
 * without requiring PHPUnit: the base is inert for anybody who is not running
 * tests, and a package that put a test framework in its `require` would put it
 * in every installation.
 * @see vendor/symfony/framework-bundle/Test/KernelTestCase.php, shipped in src/
 *      the same way, with no phpunit requirement in that package's manifest.
 *
 * And a third: an OPTIONAL dependency. The area bundle suggests symfony/mercure
 * and symfony/mercure-bundle and names three of their symbols — `HubInterface`,
 * `Update` and `Authorization` — in services that take the hub as a nullable
 * argument and do nothing without it. The checker's documented answer for a
 * symbol a package uses without requiring its provider is the `symbol-whitelist`
 * of its config file, so exactly those three are listed there, and nothing else
 * from either package may be named from src/.
 * @see vendor/maglnet/composer-require-checker/README.md — "Configuration"
 */

$root = __DIR__;
$overlay = $root.'/var/require-check/vendor';
$checker = $root.'/vendor/bin/composer-require-checker';

$manifests = [
    ...glob($root.'/src/Uhifadhi/Contracts/composer.json') ?: [],
    ...glob($root.'/src/Uhifadhi/Bundle/*/composer.json') ?: [],
];

/** @var array<string, array{name: string, dir: string, autoload: array<string, mixed>}> $local */
$local = [];
foreach ($manifests as $manifest) {
    $json = json_decode((string) file_get_contents($manifest), true, 512, \JSON_THROW_ON_ERROR);
    \assert(\is_array($json) && \is_string($json['name']));
    $local[$json['name']] = [
        'name' => $json['name'],
        'dir' => \dirname($manifest),
        'autoload' => \is_array($json['autoload'] ?? null) ? $json['autoload'] : [],
    ];
}

// The overlay, rebuilt from scratch so a removed dependency cannot linger.
exec('rm -rf '.escapeshellarg(\dirname($overlay)));
mkdir($overlay.'/composer', 0o777, true);

foreach (glob($root.'/vendor/*/*', \GLOB_ONLYDIR) ?: [] as $package) {
    $link = $overlay.'/'.basename(\dirname($package)).'/'.basename($package);
    if (!is_dir(\dirname($link))) {
        mkdir(\dirname($link), 0o777, true);
    }
    symlink($package, $link);
}

$installed = json_decode((string) file_get_contents($root.'/vendor/composer/installed.json'), true, 512, \JSON_THROW_ON_ERROR);
\assert(\is_array($installed));

foreach ($local as $package) {
    $link = $overlay.'/'.$package['name'];
    if (!is_dir(\dirname($link))) {
        mkdir(\dirname($link), 0o777, true);
    }
    if (!file_exists($link)) {
        symlink($package['dir'], $link);
    }
    $installed['packages'][] = ['name' => $package['name'], 'version' => 'dev-main', 'autoload' => $package['autoload']];
}

file_put_contents($overlay.'/composer/installed.json', json_encode($installed, \JSON_UNESCAPED_SLASHES | \JSON_THROW_ON_ERROR));

$status = 0;

foreach ($manifests as $manifest) {
    $dir = \dirname($manifest);
    $json = json_decode((string) file_get_contents($manifest), true, 512, \JSON_THROW_ON_ERROR);
    \assert(\is_array($json));

    $depth = substr_count(substr($dir, \strlen($root) + 1), '/') + 1;
    $json['config']['vendor-dir'] = str_repeat('../', $depth).'var/require-check/vendor';

    $copy = $dir.'/.composer-require-checker.json';
    file_put_contents($copy, json_encode($json, \JSON_PRETTY_PRINT | \JSON_UNESCAPED_SLASHES | \JSON_THROW_ON_ERROR));

    echo \PHP_EOL, '== ', basename($dir), \PHP_EOL;
    passthru(
        escapeshellarg($checker)
        .' check --config-file='.escapeshellarg($root.'/composer-require-checker.dist.json')
        .' '.escapeshellarg($copy),
        $exit,
    );
    unlink($copy);

    if (0 !== $exit) {
        $status = 1;
    }
}

exit($status);
